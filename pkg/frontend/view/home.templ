package view

import (
	"strconv"

	"github.com/sj14/darts-o-mat/pkg/domain/account"
	"github.com/sj14/darts-o-mat/pkg/domain/game"
	"github.com/sj14/darts-o-mat/pkg/domain/player"
	"github.com/sj14/darts-o-mat/pkg/domain/tournament"
	"github.com/sj14/darts-o-mat/pkg/service"
)

type HomeModel struct {
	Account     account.Account
	Players     []player.Player // the account's own player followed by its guests
	Boards      []service.BoardView
	Games       []service.GameView
	Invitations []service.GameView
	Friends     service.FriendList

	Tournaments           []service.TournamentView
	TournamentInvitations []service.TournamentView
	Mode        game.Mode // selected mode of the new game, empty until the user picked one
	Error       string
}

templ Home(m HomeModel) {
	@layout("Start", m.Account.Username) {
		@errorAlert(m.Error)
		if len(m.Friends.Incoming) > 0 {
			<div class="mb-4 flex flex-wrap items-center justify-between gap-3 rounded-2xl border border-sky-400/40 bg-sky-400/10 px-4 py-3">
				<span>
					if len(m.Friends.Incoming) == 1 {
						Du hast eine neue Freundschaftsanfrage.
					} else {
						Du hast { strconv.Itoa(len(m.Friends.Incoming)) } neue Freundschaftsanfragen.
					}
				</span>
				<a href="/friends" class={ btnSecondary, btnSmall }>Ansehen</a>
			</div>
		}
		if len(m.Invitations) > 0 {
			@invitations(m.Invitations)
		}
		if len(m.TournamentInvitations) > 0 {
			@tournamentInvitations(m.TournamentInvitations)
		}
		<div class="grid items-start gap-6 lg:grid-cols-[minmax(0,2fr)_minmax(0,1fr)]">
			@newGame(m)
			<div class="flex flex-col gap-6">
				if len(m.Tournaments) > 0 {
					@panel("") {
						@sectionTitle("Turniere")
						@tournamentList(m.Tournaments)
					}
				}
				if len(m.Games) > 0 {
					@recentGames(m.Games)
				}
				@guests(m.Players)
			</div>
		</div>
	}
}

templ invitations(views []service.GameView) {
	@panel("mb-6 border-amber-400/50 [--glow-color:var(--color-amber-400)] animate-glow") {
		@sectionTitle("Einladungen")
		<ul class="divide-y divide-white/10">
			for _, v := range views {
				<li class="flex flex-wrap items-center justify-between gap-3 py-3">
					<div>
						<a href={ templ.URL(gameURL(v.Game.ID, "")) } class="font-display text-2xl font-semibold uppercase hover:text-amber-300">{ modeLabel(v.Game) }</a>
						<div class="text-sm text-white/50">mit { playerNames(v, v.Game.PlayerIDs) }</div>
					</div>
					@answerInvitation(v.Game.ID)
				</li>
			}
		</ul>
	}
}

templ tournamentInvitations(views []service.TournamentView) {
	@panel("mb-6 border-amber-400/50 [--glow-color:var(--color-amber-400)] animate-glow") {
		@sectionTitle("Turnier-Einladungen")
		<ul class="divide-y divide-white/10">
			for _, v := range views {
				<li class="flex flex-wrap items-center justify-between gap-3 py-3">
					<div>
						<a href={ templ.URL(tournamentURL(v.Tournament.ID, "")) } class="font-display text-2xl font-semibold uppercase hover:text-amber-300">🏆 { formatName(v.Tournament.Format) }</a>
						<div class="text-sm text-white/50">{ modeLabel(v.Tournament.Settings) } · { strconv.Itoa(len(v.Players)) } Spieler</div>
					</div>
					@answerTournament(v.Tournament.ID)
				</li>
			}
		</ul>
	}
}

templ answerInvitation(gameID int64) {
	<div class="flex gap-2">
		<form method="post" action={ templ.URL(gameURL(gameID, "/accept")) }>
			<button type="submit" class={ btnPrimary }>Zusagen</button>
		</form>
		<form method="post" action={ templ.URL(gameURL(gameID, "/decline")) }>
			<button type="submit" class={ btnDanger }>Absagen</button>
		</form>
	</div>
}

templ guests(players []player.Player) {
	@panel("") {
		@sectionTitle("Gastspieler")
		<p class="mb-3 text-sm text-white/50">Für Mitspieler ohne eigenen Account. Nur du siehst sie.</p>
		if len(players) > 1 {
			<ul class="mb-4 flex flex-wrap gap-2">
				for _, p := range players[1:] {
					<li class="rounded-full bg-white/10 px-3 py-1 font-semibold">{ p.Name }</li>
				}
			</ul>
		}
		<form method="post" action="/guests" class="flex gap-2">
			<input type="text" name="name" class={ inputClass } placeholder="Name" required aria-label="Name des Gastspielers"/>
			<button type="submit" class={ btnSecondary }>Anlegen</button>
		</form>
	}
}

templ recentGames(views []service.GameView) {
	@panel("") {
		@sectionTitle("Letzte Spiele")
		<ul class="-mx-2 flex flex-col gap-1">
			for _, v := range views {
				<li>
					<a href={ templ.URL(gameURL(v.Game.ID, "")) } class="block rounded-2xl px-3 py-2.5 transition hover:bg-white/5">
						<div class="flex items-center justify-between gap-2">
							<span class="font-display text-xl font-semibold uppercase">{ modeLabel(v.Game) }</span>
							switch  {
								case v.Game.Aborted():
									@statusBadge("abgebrochen", "bg-white/10 text-white/50")
								case !v.Ready:
									@statusBadge("wartet", "bg-amber-400/20 text-amber-300")
								case progressOf(v).GameOver:
									@statusBadge("beendet", "bg-board-cream/15 text-board-cream")
								default:
									@statusBadge("läuft", "bg-board-green/25 text-emerald-300")
							}
						</div>
						<div class="text-sm text-white/50">{ playerNames(v, v.Game.PlayerIDs) }</div>
					</a>
				</li>
			}
		</ul>
	}
}

// fieldset is a labeled group of form fields.
templ fieldset(label string) {
	<fieldset>
		<legend class={ labelClass }>{ label }</legend>
		{ children... }
	</fieldset>
}

// formatChoice picks a single game or a tournament of games with these settings.
templ formatChoice() {
	@fieldset("Spielform") {
		<div class="flex flex-wrap gap-2">
			@choice("format", "", "Einzelspiel", true)
			@choice("format", "knockout", "🏆 K.-o.-Turnier", false)
			@choice("format", "round_robin", "🏆 Jeder gegen jeden", false)
		</div>
		<p class={ hintClass }>Ein Turnier braucht { strconv.Itoa(tournament.MinPlayers) } bis { strconv.Itoa(tournament.MaxPlayers) } Spieler; die Reihenfolge wird ausgelost, jedes Spiel hat die Einstellungen hier.</p>
	}
}

// legsChoice picks how many legs win the game, and optionally how many sets.
templ legsChoice() {
	@fieldset("Legs") {
		<div class="flex flex-wrap gap-2">
			@choice("legs", "1", "1 Leg", true)
			for _, n := range []int{2, 3, 4, 5} {
				@choice("legs", strconv.Itoa(n), "First to "+strconv.Itoa(n), false)
			}
		</div>
		<p class={ hintClass }>Wer auscheckt, gewinnt das Leg sofort; jedes Leg beginnt der Nächste. Mit Sets gilt das pro Set.</p>
	}
	@fieldset("Sets") {
		<div class="flex flex-wrap gap-2">
			@choice("sets", "1", "Ohne Sets", true)
			for _, n := range []int{2, 3, 4, 5} {
				@choice("sets", strconv.Itoa(n), "First to "+strconv.Itoa(n), false)
			}
		</div>
		<p class={ hintClass }>Wer die Legs eines Sets zuerst gewinnt, gewinnt das Set; jedes Set beginnt der Nächste.</p>
	}
	@fieldset("Wer beginnt") {
		@checkbox("bull-off", "bull_off", "on", false) {
			Ausbullen <span class="text-white/40">– wer am nächsten am Bull ist; mit Kamera auf den Millimeter</span>
		}
	}
}

// participants lets the user pick who plays and on which board.
// The players throw in the listed order, invited accounts last.
templ participants(m HomeModel) {
	@fieldset("Mitspieler") {
		<div class="flex flex-col gap-1">
			for i, p := range m.Players {
				@checkbox("player-"+strconv.FormatInt(p.ID, 10), "player_ids", strconv.FormatInt(p.ID, 10), i == 0) {
					if i == 0 {
						Ich ({ p.Name })
					} else {
						{ p.Name } <span class="text-white/40">(Gast)</span>
					}
				}
			}
		</div>
	}
	@fieldset("Freunde einladen") {
		if len(m.Friends.Friends) == 0 {
			<p class="text-white/50">Füge unter <a href="/friends" class={ linkClass }>Freunde</a> andere Accounts hinzu, um sie einzuladen.</p>
		}
		<div class="flex flex-col gap-1">
			for _, f := range m.Friends.Friends {
				@checkbox("invite-"+f.Username, "invite", f.Username, false) {
					{ f.Name }
				}
			}
		</div>
		if len(m.Friends.Friends) > 0 {
			<p class={ hintClass }>Das Spiel beginnt, sobald alle Eingeladenen zugesagt haben.</p>
		}
	}
	if len(m.Boards) > 0 {
		@fieldset("Board") {
			{{ last := lastUsedBoard(m.Boards) }}
			<div class="flex flex-wrap gap-2">
				@choice("board_id", "", "ohne", last == 0)
				for _, b := range m.Boards {
					@choice("board_id", strconv.FormatInt(b.ID, 10), "📷 "+b.Name, b.ID == last)
				}
			</div>
		}
	}
}

// newGame first lets the user pick a mode and then shows the options of that mode.
// Picking a mode reloads only this section via htmx; without JavaScript the links still work.
templ newGame(m HomeModel) {
	<div id="new-game">
		@panel("flex flex-col gap-5") {
			<h2 class="font-display text-4xl font-extrabold uppercase tracking-wide text-board-cream">Neues Spiel</h2>
			<div class="grid gap-3 sm:grid-cols-2">
				@modeTile(game.ModeX01, m.Mode, "X01", "Von 301, 501 oder 701 auf genau 0 runterspielen.", "501")
				@modeTile(game.ModeAroundTheClock, m.Mode, "Around the Clock", "Die Zahlen 1 bis 20 der Reihe nach treffen.", "1→20")
			</div>
			switch m.Mode {
				case game.ModeX01:
					<form method="post" action="/games" class="flex flex-col gap-5">
						<input type="hidden" name="mode" value="x01"/>
						@fieldset("Startpunkte") {
							<div class="flex flex-wrap gap-2">
								for _, score := range []int{301, 501, 701} {
									@choice("start_score", strconv.Itoa(score), strconv.Itoa(score), score == 501)
								}
							</div>
						}
						@fieldset("Auschecken mit") {
							<div class="flex flex-wrap gap-2">
								@choice("out_mode", "single", "beliebigem Dart", false)
								@choice("out_mode", "double", "Doppel", true)
								@choice("out_mode", "master", "Doppel oder Triple", false)
							</div>
						}
						@formatChoice()
						@legsChoice()
						@participants(m)
						<div>
							<button type="submit" class={ btnPrimary, "px-6 py-3 font-display text-2xl uppercase" }>X01 starten</button>
						</div>
					</form>
				case game.ModeAroundTheClock:
					<form method="post" action="/games" class="flex flex-col gap-5">
						<input type="hidden" name="mode" value="around_the_clock"/>
						@fieldset("Regeln") {
							<div class="flex flex-col gap-1">
								@checkbox("atc-bull", "bull", "on", true) {
									Zum Schluss das Bull treffen
								}
								@checkbox("atc-skips", "multiplier_skips", "on", false) {
									Doppel springt 2 Felder, Triple 3 Felder weiter
								}
							</div>
						}
						@formatChoice()
						@legsChoice()
						@participants(m)
						<div>
							<button type="submit" class={ btnPrimary, "px-6 py-3 font-display text-2xl uppercase" }>Around the Clock starten</button>
						</div>
					</form>
				default:
					<p class="text-white/50">Wähle zuerst einen Spielmodus.</p>
			}
		}
	</div>
}

templ modeTile(mode, selected game.Mode, title, description, symbol string) {
	<a
		href={ templ.URL("/?mode=" + string(mode)) }
		hx-get={ "/?mode=" + string(mode) }
		hx-target="#new-game"
		hx-select="#new-game"
		hx-swap="outerHTML"
		hx-push-url="true"
		class={ "group relative block rounded-2xl border p-4 transition-colors",
			templ.KV("border-board-green bg-board-green/15 [--glow-color:var(--color-board-green)] animate-glow", mode == selected),
			templ.KV("border-white/10 bg-pub-800 hover:border-white/30", mode != selected) }
		if mode == selected {
			aria-current="true"
		}
	>
		<div class="pointer-events-none absolute right-3 bottom-1 font-display text-6xl leading-none font-extrabold text-white/5 transition-colors group-hover:text-white/10">{ symbol }</div>
		<div class="font-display text-3xl font-extrabold uppercase">{ title }</div>
		<div class="mt-1 text-sm text-white/60">{ description }</div>
	</a>
}

// NewBoardToken is shown once, right after it was created.
type NewBoardToken struct {
	BoardName string
	Token     string
	Server    string // URL of this server, as the camera has to reach it
}

templ Boards(user string, boards []service.BoardView, errMsg string, newToken *NewBoardToken) {
	@layout("Boards", user) {
		<div class="mx-auto max-w-3xl">
			@pageTitle("Boards", "Deine Dartboards, z. B. eins im Keller und eins im Vereinsheim. Beim Spielstart wählst du, auf welchem Board gespielt wird; dessen Kameras tragen die Würfe dann automatisch ein.")
			@errorAlert(errMsg)
			if newToken != nil {
				<div class="mb-6 rounded-3xl border border-board-green/50 bg-board-green/10 p-5" role="status">
					<div class="font-display text-2xl font-extrabold uppercase text-emerald-300">Kamera-Token für „{ newToken.BoardName }“</div>
					<p class="mt-2">Er wird nur jetzt angezeigt. Trage beides in darts-o-cam am Rechner mit den Kameras unter „Einstellungen“ ein:</p>
					<dl class="mt-3 grid gap-2 rounded-xl bg-pub-950 p-3 text-sm sm:grid-cols-[auto_1fr]">
						<dt class="text-white/60">Server</dt>
						<dd class="break-all font-mono text-emerald-200">{ newToken.Server }</dd>
						<dt class="text-white/60">Kamera-Token</dt>
						<dd class="break-all font-mono text-emerald-200">{ newToken.Token }</dd>
					</dl>
					<p class="mt-3 text-sm text-white/60">Die Kalibrierung liegt auf dem Rechner mit den Kameras, nicht auf diesem Server. Noch keine? Starte dort <code>go run ./cmd/darts-o-cam</code>; die Oberfläche öffnet sich im Browser (<code>http://localhost:8090</code>).</p>
				</div>
			}
			@panel("") {
				if len(boards) > 0 {
					<ul class="mb-4 divide-y divide-white/10">
						for _, b := range boards {
							<li class="flex flex-wrap items-center justify-between gap-3 py-3">
								<span class="flex items-center gap-3">
									<span class="font-display text-2xl font-semibold uppercase">📷 { b.Name }</span>
									if b.HasToken {
										@statusBadge("Kamera-Token aktiv", "bg-board-green/25 text-emerald-300")
									}
								</span>
								<span class="flex gap-2">
									<form method="post" action={ templ.URL("/boards/" + strconv.FormatInt(b.ID, 10) + "/token") }>
										<button type="submit" class={ btnSecondary, btnSmall }>
											if b.HasToken {
												Neuen Kamera-Token erzeugen
											} else {
												Kamera-Token erzeugen
											}
										</button>
									</form>
									<form method="post" action={ templ.URL("/boards/" + strconv.FormatInt(b.ID, 10) + "/delete") }>
										<button type="submit" class={ btnDanger, btnSmall }>Löschen</button>
									</form>
								</span>
							</li>
						}
					</ul>
				}
				<form method="post" action="/boards" class="flex gap-2">
					<input type="text" name="name" class={ inputClass } placeholder="Name, z. B. Keller" required aria-label="Name des Boards"/>
					<button type="submit" class={ btnPrimary }>Anlegen</button>
				</form>
			}
		</div>
	}
}
