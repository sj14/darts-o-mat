package view

import (
	"strconv"

	"github.com/sj14/darts-o-mat/pkg/domain/account"
	"github.com/sj14/darts-o-mat/pkg/domain/game"
	"github.com/sj14/darts-o-mat/pkg/domain/player"
	"github.com/sj14/darts-o-mat/pkg/service"
)

type HomeModel struct {
	Account     account.Account
	Players     []player.Player // the account's own player followed by its guests
	Boards      []service.BoardView
	Games       []service.GameView
	Invitations []service.GameView
	Friends     service.FriendList
	Mode        game.Mode // selected mode of the new game, empty until the user picked one
	Error       string
}

templ Home(m HomeModel) {
	@layout("Start", m.Account.Username) {
		@errorAlert(m.Error)
		if len(m.Friends.Incoming) > 0 {
			<div class="alert theme-primary mb-4 d-flex justify-content-between align-items-center flex-wrap gap-2">
				<span>
					if len(m.Friends.Incoming) == 1 {
						Du hast eine neue Freundschaftsanfrage.
					} else {
						Du hast { strconv.Itoa(len(m.Friends.Incoming)) } neue Freundschaftsanfragen.
					}
				</span>
				<a href="/friends" class="btn-solid theme-primary btn-sm">Ansehen</a>
			</div>
		}
		if len(m.Invitations) > 0 {
			@invitations(m.Invitations)
		}
		<div class="row g-4">
			<div class="md:col-8">
				@newGame(m)
			</div>
			<div class="md:col-4 d-grid gap-4 align-content-start">
				@guests(m.Players)
				if len(m.Games) > 0 {
					@recentGames(m.Games)
				}
			</div>
		</div>
	}
}

templ invitations(views []service.GameView) {
	<div class="card mb-4 border-primary border-2">
		<div class="card-body">
			<h2 class="fs-xl mb-3">Einladungen</h2>
			<div class="list-group">
				for _, v := range views {
					<div class="list-group-item d-flex justify-content-between align-items-center flex-wrap gap-2">
						<div>
							<a href={ templ.URL(gameURL(v.Game.ID, "")) } class="fw-semibold">{ modeLabel(v.Game) }</a>
							<div class="fs-sm fg-3">mit { playerNames(v, v.Game.PlayerIDs) }</div>
						</div>
						@answerInvitation(v.Game.ID)
					</div>
				}
			</div>
		</div>
	</div>
}

templ answerInvitation(gameID int64) {
	<div class="d-flex gap-2">
		<form method="post" action={ templ.URL(gameURL(gameID, "/accept")) } class="mb-0">
			<button type="submit" class="btn-solid theme-success">Zusagen</button>
		</form>
		<form method="post" action={ templ.URL(gameURL(gameID, "/decline")) } class="mb-0">
			<button type="submit" class="btn-outline theme-danger">Absagen</button>
		</form>
	</div>
}

templ guests(players []player.Player) {
	<div class="card">
		<div class="card-body">
			<h2 class="fs-xl mb-1">Gastspieler</h2>
			<p class="fs-sm fg-3">Für Mitspieler ohne eigenen Account. Nur du siehst sie.</p>
			if len(players) > 1 {
				<ul class="list-group mb-3">
					for _, p := range players[1:] {
						<li class="list-group-item">{ p.Name }</li>
					}
				</ul>
			}
			<form method="post" action="/guests" class="d-flex gap-2">
				<input type="text" name="name" class="form-control" placeholder="Name" required aria-label="Name des Gastspielers"/>
				<button type="submit" class="btn-solid theme-secondary">Anlegen</button>
			</form>
		</div>
	</div>
}

templ recentGames(views []service.GameView) {
	<div class="card">
		<div class="card-body">
			<h2 class="fs-xl mb-3">Letzte Spiele</h2>
			<div class="list-group">
				for _, v := range views {
					<a href={ templ.URL(gameURL(v.Game.ID, "")) } class="list-group-item list-group-item-action">
						<div class="d-flex justify-content-between gap-2">
							<span class="fw-semibold">{ modeLabel(v.Game) }</span>
							switch  {
								case v.Game.Aborted():
									<span class="badge theme-secondary">abgebrochen</span>
								case !v.Ready:
									<span class="badge theme-warning">wartet</span>
								case progressOf(v).GameOver:
									<span class="badge theme-success">beendet</span>
								default:
									<span class="badge theme-primary">läuft</span>
							}
						</div>
						<div class="fs-sm fg-3">{ playerNames(v, v.Game.PlayerIDs) }</div>
					</a>
				}
			</div>
		</div>
	</div>
}

templ radioButton(name, value, label string, checked bool) {
	<label class="btn-check btn-outline theme-primary">
		<input type="radio" name={ name } value={ value } checked?={ checked }/>
		{ label }
	</label>
}

// participants lets the user pick who plays and on which board.
// The players throw in the listed order, invited accounts last.
templ participants(m HomeModel) {
	<div class="form-group">
		<span class="form-label">Mitspieler</span>
		for i, p := range m.Players {
			<div class="form-field">
				<input type="checkbox" class="check" id={ "player-" + strconv.FormatInt(p.ID, 10) } name="player_ids" value={ strconv.FormatInt(p.ID, 10) } checked?={ i == 0 }/>
				<label for={ "player-" + strconv.FormatInt(p.ID, 10) }>
					if i == 0 {
						Ich ({ p.Name })
					} else {
						{ p.Name } <span class="fg-3">(Gast)</span>
					}
				</label>
			</div>
		}
	</div>
	<div class="form-group">
		<span class="form-label">Freunde einladen</span>
		if len(m.Friends.Friends) == 0 {
			<p class="fg-3 mb-0">Füge unter <a href="/friends">Freunde</a> andere Accounts hinzu, um sie einzuladen.</p>
		}
		for _, f := range m.Friends.Friends {
			<div class="form-field">
				<input type="checkbox" class="check" id={ "invite-" + f.Username } name="invite" value={ f.Username }/>
				<label for={ "invite-" + f.Username }>{ f.Name }</label>
			</div>
		}
		if len(m.Friends.Friends) > 0 {
			<div class="form-text">Das Spiel beginnt, sobald alle Eingeladenen zugesagt haben.</div>
		}
	</div>
	if len(m.Boards) > 0 {
		<div class="form-group">
			<span class="form-label">Board</span>
			<div class="btn-group flex-wrap" role="group">
				@radioButton("board_id", "", "ohne", true)
				for _, b := range m.Boards {
					@radioButton("board_id", strconv.FormatInt(b.ID, 10), b.Name, false)
				}
			</div>
		</div>
	}
}

// newGame first lets the user pick a mode and then shows the options of that mode.
// Picking a mode reloads only this section via htmx; without JavaScript the links still work.
templ newGame(m HomeModel) {
	<div id="new-game" class="card">
		<div class="card-body d-grid gap-4">
			<h2 class="fs-xl mb-0">Neues Spiel</h2>
			<div class="row g-3">
				<div class="col-6">
					@modeTile(game.ModeX01, m.Mode, "X01", "Von 301, 501 oder 701 auf genau 0 runterspielen.")
				</div>
				<div class="col-6">
					@modeTile(game.ModeAroundTheClock, m.Mode, "Around the Clock", "Die Zahlen 1 bis 20 der Reihe nach treffen.")
				</div>
			</div>
			switch m.Mode {
				case game.ModeX01:
					<form method="post" action="/games" class="d-grid gap-3">
						<input type="hidden" name="mode" value="x01"/>
						<div class="form-group">
							<span class="form-label">Startpunkte</span>
							<div class="btn-group" role="group">
								for _, score := range []int{301, 501, 701} {
									@radioButton("start_score", strconv.Itoa(score), strconv.Itoa(score), score == 501)
								}
							</div>
						</div>
						<div class="form-group">
							<span class="form-label">Auschecken mit</span>
							<div class="btn-group" role="group">
								@radioButton("out_mode", "single", "beliebigem Dart", false)
								@radioButton("out_mode", "double", "Doppel", true)
								@radioButton("out_mode", "master", "Doppel oder Triple", false)
							</div>
						</div>
						@participants(m)
						<div>
							<button type="submit" class="btn-solid theme-primary">X01 starten</button>
						</div>
					</form>
				case game.ModeAroundTheClock:
					<form method="post" action="/games" class="d-grid gap-3">
						<input type="hidden" name="mode" value="around_the_clock"/>
						<div class="form-field">
							<input type="checkbox" class="check" id="atc-bull" name="bull" checked/>
							<label for="atc-bull">Zum Schluss das Bull treffen</label>
						</div>
						<div class="form-field">
							<input type="checkbox" class="check" id="atc-skips" name="multiplier_skips"/>
							<label for="atc-skips">Doppel springt 2 Felder, Triple 3 Felder weiter</label>
						</div>
						@participants(m)
						<div>
							<button type="submit" class="btn-solid theme-primary">Around the Clock starten</button>
						</div>
					</form>
				default:
					<p class="fg-3 mb-0">Wähle zuerst einen Spielmodus.</p>
			}
		</div>
	</div>
}

templ modeTile(mode, selected game.Mode, title, description string) {
	<a
		href={ templ.URL("/?mode=" + string(mode)) }
		hx-get={ "/?mode=" + string(mode) }
		hx-target="#new-game"
		hx-select="#new-game"
		hx-swap="outerHTML"
		hx-push-url="true"
		class={ "card h-100 text-decoration-none", templ.KV("border-primary border-3", mode == selected) }
		if mode == selected {
			aria-current="true"
		}
	>
		<div class="card-body">
			<div class="fs-lg fw-bold mb-1">{ title }</div>
			<div class="fs-sm fg-3">{ description }</div>
		</div>
	</a>
}

// NewBoardToken is shown once, right after it was created.
type NewBoardToken struct {
	BoardName string
	Token     string
	Server    string // URL of this server, as the camera has to reach it
}

templ Boards(user string, boards []service.BoardView, errMsg string, newToken *NewBoardToken) {
	@layout("Boards", user) {
		<div class="row justify-content-center">
			<div class="md:col-8 d-grid gap-4">
				@errorAlert(errMsg)
				if newToken != nil {
					<div class="alert theme-success mb-0" role="status">
						<div class="fw-bold mb-2">Kamera-Token für „{ newToken.BoardName }“</div>
						<p class="mb-2">Er wird nur jetzt angezeigt. Starte damit die Kamera-Erkennung am Rechner mit den Kameras:</p>
						<pre class="mb-2 text-wrap text-break"><code>go run ./cmd/darts-o-cam detect -calibration calibration.json -server { newToken.Server } -token { newToken.Token }</code></pre>
						<p class="mb-0 fs-sm">Die Kalibrierung (<code>calibration.json</code>) liegt auf dem Rechner mit den Kameras, nicht auf diesem Server. Noch keine? Erstelle sie dort mit <code>go run ./cmd/darts-o-cam ui</code> und öffne <code>http://localhost:8090</code>.</p>
					</div>
				}
				<div class="card">
					<div class="card-body">
						<h1 class="fs-2xl mb-1">Boards</h1>
						<p class="fg-3">Deine Dartboards, z. B. eins im Keller und eins im Vereinsheim. Beim Spielstart kannst du wählen, auf welchem Board gespielt wird; dessen Kameras tragen die Würfe dann automatisch ein.</p>
						if len(boards) > 0 {
							<ul class="list-group mb-3">
								for _, b := range boards {
									<li class="list-group-item d-flex justify-content-between align-items-center flex-wrap gap-2">
										<span>
											{ b.Name }
											if b.HasToken {
												<span class="badge theme-success ms-2">Kamera-Token aktiv</span>
											}
										</span>
										<span class="d-flex gap-2">
											<form method="post" action={ templ.URL("/boards/" + strconv.FormatInt(b.ID, 10) + "/token") } class="mb-0">
												<button type="submit" class="btn-outline theme-primary btn-sm">
													if b.HasToken {
														Neuen Kamera-Token erzeugen
													} else {
														Kamera-Token erzeugen
													}
												</button>
											</form>
											<form method="post" action={ templ.URL("/boards/" + strconv.FormatInt(b.ID, 10) + "/delete") } class="mb-0">
												<button type="submit" class="btn-outline theme-danger btn-sm">Löschen</button>
											</form>
										</span>
									</li>
								}
							</ul>
						}
						<form method="post" action="/boards" class="d-flex gap-2">
							<input type="text" name="name" class="form-control" placeholder="Name, z. B. Keller" required aria-label="Name des Boards"/>
							<button type="submit" class="btn-solid theme-secondary">Anlegen</button>
						</form>
					</div>
				</div>
			</div>
		</div>
	}
}
