package view

import (
	"strconv"

	"github.com/sj14/darts-o-mat/pkg/service"
)

templ Friends(user string, list service.FriendList, errMsg, info string) {
	@layout("Freunde", user) {
		<div class="mx-auto flex max-w-3xl flex-col gap-6">
			<div>
				@pageTitle("Freunde", "Nur Freunde kannst du zu Spielen einladen. Eine Freundschaft gilt, sobald die andere Seite deine Anfrage annimmt.")
				@errorAlert(errMsg)
				@notice(info)
				<form method="post" action="/friends" class="flex gap-2">
					<input type="text" name="username" class={ inputClass } placeholder="Benutzername" autocapitalize="none" required aria-label="Benutzername"/>
					<button type="submit" class={ btnPrimary, "shrink-0" }>Anfrage senden</button>
				</form>
			</div>
			if len(list.Incoming) > 0 {
				@panel("border-sky-400/50 [--glow-color:var(--color-sky-400)] animate-glow") {
					@sectionTitle("Anfragen an dich")
					<ul class="divide-y divide-white/10">
						for _, f := range list.Incoming {
							@friendItem(f) {
								@friendAction(f, "/accept", "Annehmen", btnPrimary)
								@friendAction(f, "/remove", "Ablehnen", btnDanger)
							}
						}
					</ul>
				}
			}
			@panel("") {
				@sectionTitle("Deine Freunde")
				if len(list.Friends) == 0 {
					<p class="text-white/50">Noch keine Freunde.</p>
				} else {
					<ul class="divide-y divide-white/10">
						for _, f := range list.Friends {
							@friendItem(f) {
								@friendAction(f, "/remove", "Entfernen", btnDanger)
							}
						}
					</ul>
				}
			}
			if len(list.Outgoing) > 0 {
				@panel("") {
					@sectionTitle("Gesendete Anfragen")
					<ul class="divide-y divide-white/10">
						for _, f := range list.Outgoing {
							@friendItem(f) {
								@friendAction(f, "/remove", "Zurückziehen", btnSecondary)
							}
						}
					</ul>
				}
			}
		</div>
	}
}

// friendItem shows a friend with the actions passed as children.
templ friendItem(f service.Friend) {
	<li class="flex flex-wrap items-center justify-between gap-3 py-3">
		<span>
			<span class="font-display text-2xl font-semibold uppercase">{ f.Name }</span>
			if f.Name != f.Username {
				<span class="text-white/40">{ "@" + f.Username }</span>
			}
		</span>
		<span class="flex gap-2">
			{ children... }
		</span>
	</li>
}

templ friendAction(f service.Friend, action, label, class string) {
	<form method="post" action={ templ.URL("/friends/" + strconv.FormatInt(f.AccountID, 10) + action) }>
		<button type="submit" class={ class, btnSmall }>{ label }</button>
	</form>
}
