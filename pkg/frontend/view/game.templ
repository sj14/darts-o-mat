package view

import (
	"strconv"

	"github.com/sj14/darts-o-mat/pkg/domain/game"
	"github.com/sj14/darts-o-mat/pkg/domain/game/aroundtheclock"
	"github.com/sj14/darts-o-mat/pkg/domain/game/turn"
	"github.com/sj14/darts-o-mat/pkg/domain/game/x01"
	"github.com/sj14/darts-o-mat/pkg/domain/throw"
	"github.com/sj14/darts-o-mat/pkg/service"
)

templ Game(user string, v service.GameView) {
	@layout(modeLabel(v.Game), user) {
		// The server pushes the board whenever the game changes (darts from the cameras or
		// other devices, answered invitations); the board element swaps itself on "board".
		<div hx-ext="sse" sse-connect={ gameURL(v.Game.ID, "/events") }>
			@Board(v, "")
		</div>
	}
}

// Board is the part of the game page that htmx replaces after every dart.
// Until all invited players have accepted, it shows the lobby instead.
templ Board(v service.GameView, errMsg string) {
	if !v.Ready && !v.Game.Aborted() {
		@lobby(v, errMsg)
	} else {
		@scores(v, errMsg, nil)
	}
}

// BoardEditing is the board with the keypad correcting an earlier dart.
templ BoardEditing(v service.GameView, errMsg string, dart throw.Dart) {
	@scores(v, errMsg, &dart)
}

// lobby turns into the board once everyone has accepted, pushed by the server.
templ lobby(v service.GameView, errMsg string) {
	<div id="board" sse-swap="board" hx-swap="outerHTML">
		<h1 class="fs-2xl mb-3">{ modeLabel(v.Game) }</h1>
		@errorAlert(errMsg)
		if v.Invited {
			<div class="alert theme-primary mb-4 d-flex justify-content-between align-items-center flex-wrap gap-2">
				<span class="fw-semibold">Du bist zu diesem Spiel eingeladen.</span>
				@answerInvitation(v.Game.ID)
			</div>
		}
		<div class="card">
			<div class="card-body">
				<p>Das Spiel beginnt, sobald alle Eingeladenen zugesagt haben.</p>
				<ul class="list-group">
					for _, pl := range v.Players {
						<li class="list-group-item d-flex justify-content-between align-items-center flex-wrap gap-2">
							<span>
								{ pl.Name }
								if pl.IsGuest() {
									<span class="fg-3">(Gast)</span>
								}
							</span>
							{{ inv := v.InvitationOf(pl.ID) }}
							switch  {
								case inv == nil:
									<span class="badge theme-success">dabei</span>
								case inv.Status == game.InvitationAccepted:
									<span class="badge theme-success">zugesagt</span>
								default:
									<span class="d-flex align-items-center gap-2">
										<span class="badge theme-warning">eingeladen</span>
										if v.IsOwner {
											<button
												type="button"
												class="btn-outline theme-danger btn-sm"
												hx-post={ gameURL(v.Game.ID, "/invitations/"+strconv.FormatInt(pl.ID, 10)+"/withdraw") }
												hx-target="#board"
												hx-swap="outerHTML"
											>Ausladen</button>
										}
									</span>
							}
						</li>
					}
				</ul>
			</div>
		</div>
		if v.IsOwner {
			<div class="mt-3">
				@abortButton(v)
			</div>
		}
	</div>
}

// abortButton lets the owner end the game without a winner, after asking.
templ abortButton(v service.GameView) {
	<button
		type="button"
		class="btn-outline theme-danger"
		hx-post={ gameURL(v.Game.ID, "/abort") }
		hx-target="#board"
		hx-swap="outerHTML"
		hx-confirm="Spiel wirklich abbrechen? Es zählt dann nicht in die Statistik."
	>Spiel abbrechen</button>
}

templ scores(v service.GameView, errMsg string, editing *throw.Dart) {
	{{ p := progressOf(v) }}
	<div id="board" sse-swap="board" hx-swap="outerHTML">
		<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
			<h1 class="fs-2xl mb-0">{ modeLabel(v.Game) }</h1>
			<span class="fg-3">
				if v.Board != nil {
					📷 { v.Board.Name } ·
				}
				if p.running() {
					Runde { strconv.Itoa(p.Round) }
				}
			</span>
		</div>
		@errorAlert(errMsg)
		if p.GameOver {
			<div class="alert theme-success mb-4" role="status">
				<div class="fs-xl fw-bold">
					if len(p.WinnerIDs) > 1 {
						Unentschieden: { playerNames(v, p.WinnerIDs) }
					} else {
						🏆 { playerNames(v, p.WinnerIDs) } gewinnt!
					}
				</div>
				<a href="/" class="btn-solid theme-success mt-3">Neues Spiel</a>
			</div>
		}
		if p.Aborted {
			<div class="alert theme-secondary mb-4" role="status">
				<div class="fs-xl fw-bold">Spiel abgebrochen</div>
				<a href="/" class="btn-solid theme-secondary mt-3">Neues Spiel</a>
			</div>
		}
		<div class="scoreboard mb-4">
			switch st := v.State.(type) {
				case x01.State:
					for _, ps := range st.Players {
						@playerCard(v, p, ps.PlayerID, strconv.FormatUint(ps.Remaining, 10), "Rest · Ø "+decimal(ps.Stats.Average), "", "")
					}
				case aroundtheclock.State:
					for _, ps := range st.Players {
						@playerCard(v, p, ps.PlayerID, targetLabel(ps.Target), "Ziel", orDash(ps.Stats.Darts > 0, percent(ps.Stats.HitRate)), "Trefferquote")
					}
			}
		</div>
		if editing != nil && v.CanThrow {
			@editPanel(v, *editing)
		} else if p.running() {
			<div class="mb-3">
				<div class="turn-darts">
					for i := range turn.DartsPerTurn {
						if i < len(turnDarts(v, p)) {
							@dartTile(v, turnDarts(v, p)[i])
						} else {
							<span class="turn-dart empty">–</span>
						}
					}
				</div>
			</div>
			if p.WaitingForTakeout {
				<div class="alert theme-warning d-flex justify-content-between align-items-center flex-wrap gap-2" role="status">
					<span>
						<span class="fw-bold">Pfeile ziehen</span> – danach ist { nextPlayerName(v, p) } dran.
						if v.Board != nil {
							<span class="fs-sm fg-3">Die Kamera erkennt das Herausziehen von selbst.</span>
						}
					</span>
					if v.CanThrow {
						<button
							type="button"
							class="btn-solid theme-warning"
							hx-post={ gameURL(v.Game.ID, "/takeout") }
							hx-target="#board"
							hx-swap="outerHTML"
						>Pfeile gezogen</button>
					}
				</div>
			} else if v.CanThrow {
				@keypad(v, gameURL(v.Game.ID, "/darts"))
			}
		}
		<div class="mt-3 d-flex flex-wrap gap-2">
			if v.CanThrow {
				<button
					type="button"
					class="btn-outline theme-secondary"
					hx-post={ gameURL(v.Game.ID, "/undo") }
					hx-target="#board"
					hx-swap="outerHTML"
					disabled?={ len(v.Darts) == 0 }
				>↶ Letzten Dart zurücknehmen</button>
			}
			if v.IsOwner && p.running() {
				@abortButton(v)
			}
		</div>
		switch st := v.State.(type) {
			case x01.State:
				if len(st.Turns) > 0 {
					@x01History(v, st)
				}
			case aroundtheclock.State:
				if len(st.Turns) > 0 {
					@aroundTheClockHistory(v, st)
				}
		}
		if len(v.Darts) > 0 {
			@gameStats(v)
		}
	</div>
}

// gameStats shows the statistics of all players in this game.
templ gameStats(v service.GameView) {
	<div class="card mt-4">
		<div class="card-body">
			<h2 class="fs-xl mb-3">Statistik</h2>
			<div class="table-responsive">
				<table class="table table-sm mb-0">
					switch st := v.State.(type) {
						case x01.State:
							<thead>
								<tr>
									<th>Spieler</th>
									<th class="text-end" title="Punkte pro 3 Darts">Ø</th>
									<th class="text-end">Darts</th>
									<th class="text-end">Höchste Aufnahme</th>
									<th class="text-end">100+</th>
									<th class="text-end">140+</th>
									<th class="text-end">180</th>
								</tr>
							</thead>
							<tbody>
								for _, ps := range st.Players {
									<tr>
										<td>{ playerName(v, ps.PlayerID) }</td>
										<td class="text-end">{ decimal(ps.Stats.Average) }</td>
										<td class="text-end">{ strconv.Itoa(ps.Stats.Darts) }</td>
										<td class="text-end">{ strconv.FormatUint(ps.Stats.HighestTurn, 10) }</td>
										<td class="text-end">{ strconv.Itoa(ps.Stats.Turns100) }</td>
										<td class="text-end">{ strconv.Itoa(ps.Stats.Turns140) }</td>
										<td class="text-end">{ strconv.Itoa(ps.Stats.Turns180) }</td>
									</tr>
								}
							</tbody>
						case aroundtheclock.State:
							<thead>
								<tr>
									<th>Spieler</th>
									<th class="text-end">Darts</th>
									<th class="text-end">Treffer</th>
									<th class="text-end">Trefferquote</th>
								</tr>
							</thead>
							<tbody>
								for _, ps := range st.Players {
									<tr>
										<td>{ playerName(v, ps.PlayerID) }</td>
										<td class="text-end">{ strconv.Itoa(ps.Stats.Darts) }</td>
										<td class="text-end">{ strconv.Itoa(ps.Stats.Hits) }</td>
										<td class="text-end">{ percent(ps.Stats.HitRate) }</td>
									</tr>
								}
							</tbody>
					}
				</table>
			</div>
		</div>
	</div>
}

// playerCard shows a player's main value (rest, target) and optionally a second key figure next to it.
templ playerCard(v service.GameView, p progress, playerID int64, value, caption, stat, statCaption string) {
	<div class={ "card", templ.KV("border-primary border-3", p.isCurrent(playerID)), templ.KV("border-success border-3", p.isWinner(playerID)) }>
		<div class="card-body">
			<div class="d-flex justify-content-between align-items-center gap-2">
				<span class="fw-semibold text-truncate">{ playerName(v, playerID) }</span>
				if p.isWinner(playerID) {
					<span class="badge theme-success">Sieg</span>
				}
			</div>
			<div class="d-flex justify-content-between align-items-end gap-3">
				<div>
					<div class="score fw-bold my-2">{ value }</div>
					<div class="fs-sm fg-3">{ caption }</div>
				</div>
				if stat != "" {
					<div class="text-end">
						<div class="score-side fw-bold my-2">{ stat }</div>
						<div class="fs-sm fg-3">{ statCaption }</div>
					</div>
				}
			</div>
		</div>
	</div>
}

// keypad enters a dart (posted to action): choose single, double or triple, then tap the number.
templ keypad(v service.GameView, action string) {
	{{ target := currentTarget(v) }}
	<form
		hx-post={ action }
		hx-target="#board"
		hx-swap="outerHTML"
		class="d-grid gap-3"
	>
		<div class="btn-group" role="group" aria-label="Multiplikator">
			@radioButton("multiplier", "1", "Single", true)
			@radioButton("multiplier", "2", "Doppel", false)
			@radioButton("multiplier", "3", "Triple", false)
		</div>
		<div class="keypad">
			for n := 1; n <= 20; n++ {
				<button
					type="submit"
					name="number"
					value={ strconv.Itoa(n) }
					class={ "btn-solid", templ.KV("theme-primary", uint8(n) == target), templ.KV("theme-secondary", uint8(n) != target) }
				>{ strconv.Itoa(n) }</button>
			}
			<button
				type="submit"
				name="number"
				value="25"
				class={ "btn-solid span-2", templ.KV("theme-primary", target == throw.Bull), templ.KV("theme-success", target != throw.Bull) }
			>Bull</button>
			<button type="submit" name="miss" value="true" class="btn-solid theme-danger span-3">Daneben</button>
		</div>
	</form>
}

// x01History lists the turns, newest first, so everyone can see what was thrown
// after the next player's turn started.
templ x01History(v service.GameView, st x01.State) {
	<div class="card mt-4">
		<div class="card-body">
			<h2 class="fs-xl mb-3">Verlauf</h2>
			<div class="table-responsive">
				<table class="table table-sm mb-0">
					<thead>
						<tr>
							<th>Runde</th>
							<th>Spieler</th>
							<th>Darts</th>
							<th class="text-end">Punkte</th>
							<th class="text-end">Rest</th>
						</tr>
					</thead>
					<tbody>
						for i := len(st.Turns) - 1; i >= 0; i-- {
							@x01HistoryRow(v, st.Turns[i])
						}
					</tbody>
				</table>
			</div>
		</div>
	</div>
}

templ x01HistoryRow(v service.GameView, t x01.Turn) {
	<tr>
		<td>{ strconv.Itoa(t.Round) }</td>
		<td>{ playerName(v, t.PlayerID) }</td>
		<td>
			for i, d := range t.Darts {
				if i > 0 {
					<span class="fg-3">·</span>
				}
				@dartLink(v, d)
			}
			if !t.Complete {
				<span class="fg-3">…</span>
			}
		</td>
		<td class="text-end">
			if t.Bust {
				<span class="badge theme-danger">überworfen</span>
			} else {
				{ strconv.FormatUint(t.Points, 10) }
			}
		</td>
		<td class="text-end">
			if t.Checkout {
				<span class="badge theme-success">✓ Checkout</span>
			} else {
				{ strconv.FormatUint(t.Remaining, 10) }
			}
		</td>
	</tr>
}

// dartTile shows a dart of the current turn in large; players who may enter darts can tap it to correct it.
templ dartTile(v service.GameView, d throw.Dart) {
	if v.CanThrow {
		<button type="button" class={ "btn-solid theme-primary turn-dart", templ.KV("long", len(dartLabel(d)) > 4) } title="Korrigieren" hx-get={ dartEditURL(v, d) } hx-target="#board" hx-swap="outerHTML">{ dartLabel(d) }</button>
	} else {
		<span class={ "btn-solid theme-primary turn-dart", templ.KV("long", len(dartLabel(d)) > 4) }>{ dartLabel(d) }</span>
	}
}

// dartLink shows a dart in the history; players who may enter darts can click it to correct it.
templ dartLink(v service.GameView, d throw.Dart) {
	if v.CanThrow {
		<a href="#" title="Korrigieren" hx-get={ dartEditURL(v, d) } hx-target="#board" hx-swap="outerHTML">{ dartLabel(d) }</a>
	} else {
		{ dartLabel(d) }
	}
}

// editPanel corrects an earlier dart with the keypad.
templ editPanel(v service.GameView, d throw.Dart) {
	<div class="alert theme-primary d-flex justify-content-between align-items-center flex-wrap gap-2">
		<span>
			<span class="fw-bold">Dart korrigieren:</span> { dartLabel(d) } von { dartThrower(v, d.ID) }.
			<span class="fs-sm">Wähle, was stattdessen getroffen wurde; Punkte, Rest und Statistik rechnen sich neu.</span>
		</span>
		<button type="button" class="btn-outline theme-secondary" hx-get={ gameURL(v.Game.ID, "/board") } hx-target="#board" hx-swap="outerHTML">Abbrechen</button>
	</div>
	@keypad(v, dartEditURL(v, d))
}

// aroundTheClockHistory lists the turns, newest first; darts that hit the target are highlighted.
templ aroundTheClockHistory(v service.GameView, st aroundtheclock.State) {
	<div class="card mt-4">
		<div class="card-body">
			<h2 class="fs-xl mb-3">Verlauf</h2>
			<div class="table-responsive">
				<table class="table table-sm mb-0">
					<thead>
						<tr>
							<th>Runde</th>
							<th>Spieler</th>
							<th>Darts</th>
							<th class="text-end">Treffer</th>
							<th class="text-end">Ziel</th>
						</tr>
					</thead>
					<tbody>
						for i := len(st.Turns) - 1; i >= 0; i-- {
							@aroundTheClockHistoryRow(v, st.Turns[i])
						}
					</tbody>
				</table>
			</div>
		</div>
	</div>
}

templ aroundTheClockHistoryRow(v service.GameView, t aroundtheclock.Turn) {
	<tr>
		<td>{ strconv.Itoa(t.Round) }</td>
		<td>{ playerName(v, t.PlayerID) }</td>
		<td>
			for i, d := range t.Darts {
				if i > 0 {
					<span class="fg-3">·</span>
				}
				<span class={ templ.KV("hit", t.Hits[i]) }>
					@dartLink(v, d)
				</span>
			}
			if !t.Complete {
				<span class="fg-3">…</span>
			}
		</td>
		<td class="text-end">{ strconv.Itoa(countTrue(t.Hits)) }</td>
		<td class="text-end">
			if t.Target == 0 {
				<span class="badge theme-success">✓ fertig</span>
			} else if t.Target != t.From {
				<span class="fg-3">{ targetLabel(t.From) } →</span> { targetLabel(t.Target) }
			} else {
				{ targetLabel(t.Target) }
			}
		</td>
	</tr>
}
