package view

import (
	"strconv"

	"github.com/sj14/darts-o-mat/pkg/domain/game"
	"github.com/sj14/darts-o-mat/pkg/domain/game/aroundtheclock"
	"github.com/sj14/darts-o-mat/pkg/domain/game/turn"
	"github.com/sj14/darts-o-mat/pkg/domain/game/x01"
	"github.com/sj14/darts-o-mat/pkg/domain/throw"
	"github.com/sj14/darts-o-mat/pkg/service"
)

templ Game(user string, v service.GameView) {
	@layout(modeLabel(v.Game), user) {
		// The server pushes the board whenever the game changes (darts from the cameras or
		// other devices, answered invitations); the board element swaps itself on "board".
		<div hx-ext="sse" sse-connect={ gameURL(v.Game.ID, "/events") }>
			@Board(v, "")
		</div>
	}
}

// Board is the part of the game page that htmx replaces after every dart.
// Until all invited players have accepted, it shows the lobby instead.
templ Board(v service.GameView, errMsg string) {
	if !v.Ready && !v.Game.Aborted() {
		@lobby(v, errMsg)
	} else {
		@scores(v, errMsg, nil)
	}
}

// BoardEditing is the board with the keypad correcting an earlier dart.
templ BoardEditing(v service.GameView, errMsg string, dart throw.Dart) {
	@scores(v, errMsg, &dart)
}

// gameTitle is the heading of the game with the board it is played on.
templ gameTitle(v service.GameView, p *progress) {
	<div class="mb-5 flex flex-wrap items-end justify-between gap-2 lg:mb-3">
		<h1 class="font-display text-4xl font-extrabold uppercase tracking-wide text-board-cream sm:text-5xl">{ modeLabel(v.Game) }</h1>
		<div class="flex items-center gap-2 text-sm text-white/60">
			if v.Board != nil {
				<span class="rounded-full bg-white/10 px-3 py-1">📷 { v.Board.Name }</span>
			}
			if p != nil && p.BullingOff && p.running() {
				<span class="rounded-full bg-board-red/25 px-3 py-1 font-display text-base font-semibold uppercase tracking-wider text-red-300">Ausbullen</span>
			} else if p != nil && p.running() {
				if v.Game.Legs > 1 {
					<span class="rounded-full bg-amber-400/20 px-3 py-1 font-display text-base font-semibold uppercase tracking-wider text-amber-300">Leg { strconv.Itoa(p.Leg) }</span>
				}
				<span class="rounded-full bg-white/10 px-3 py-1 font-display text-base font-semibold uppercase tracking-wider">Runde { strconv.Itoa(p.Round) }</span>
			}
		</div>
	</div>
}

// lobby turns into the board once everyone has accepted, pushed by the server.
templ lobby(v service.GameView, errMsg string) {
	<div id="board" sse-swap="board" hx-swap="outerHTML" data-sound={ soundKind(v) } data-sound-id={ soundID(v) }>
		@gameTitle(v, nil)
		@errorAlert(errMsg)
		if v.Invited {
			<div class="mb-4 flex flex-wrap items-center justify-between gap-3 rounded-2xl border border-board-green/40 bg-board-green/15 px-4 py-3">
				<span class="font-semibold">Du bist zu diesem Spiel eingeladen.</span>
				<div class="flex gap-2">
					<form method="post" action={ templ.URL(gameURL(v.Game.ID, "/accept")) }>
						<button type="submit" class="rounded-xl bg-board-green px-4 py-2 font-semibold text-white hover:brightness-110">Zusagen</button>
					</form>
					<form method="post" action={ templ.URL(gameURL(v.Game.ID, "/decline")) }>
						<button type="submit" class="rounded-xl border border-board-red/60 px-4 py-2 font-semibold text-red-300 hover:bg-board-red/20">Absagen</button>
					</form>
				</div>
			</div>
		}
		@panel("") {
			<p class="mb-4 text-white/70">Das Spiel beginnt, sobald alle Eingeladenen zugesagt haben.</p>
			<ul class="divide-y divide-white/10">
				for _, pl := range v.Players {
					<li class="flex flex-wrap items-center justify-between gap-2 py-3">
						<span class="font-display text-2xl font-semibold">
							{ pl.Name }
							if pl.IsGuest() {
								<span class="font-sans text-sm font-normal text-white/50">(Gast)</span>
							}
						</span>
						{{ inv := v.InvitationOf(pl.ID) }}
						switch  {
							case inv == nil:
								<span class="rounded-full bg-board-green/20 px-3 py-1 text-sm text-emerald-300">dabei</span>
							case inv.Status == game.InvitationAccepted:
								<span class="rounded-full bg-board-green/20 px-3 py-1 text-sm text-emerald-300">zugesagt</span>
							default:
								<span class="flex items-center gap-2">
									<span class="animate-pulse rounded-full bg-amber-400/20 px-3 py-1 text-sm text-amber-300">eingeladen</span>
									if v.IsOwner {
										<button
											type="button"
											class="rounded-lg border border-board-red/60 px-3 py-1 text-sm text-red-300 hover:bg-board-red/20"
											hx-post={ gameURL(v.Game.ID, "/invitations/"+strconv.FormatInt(pl.ID, 10)+"/withdraw") }
											hx-target="#board"
											hx-swap="outerHTML"
										>Ausladen</button>
									}
								</span>
						}
					</li>
				}
			</ul>
		}
		if v.IsOwner {
			<div class="mt-4">
				@abortButton(v)
			</div>
		}
	</div>
}

// abortButton lets the owner end the game without a winner, after asking.
templ abortButton(v service.GameView) {
	<button
		type="button"
		class="rounded-xl border border-board-red/50 px-4 py-2 text-sm font-semibold text-red-300 transition hover:bg-board-red/20"
		hx-post={ gameURL(v.Game.ID, "/abort") }
		hx-target="#board"
		hx-swap="outerHTML"
		hx-confirm="Spiel wirklich abbrechen? Es zählt dann nicht in die Statistik."
	>Spiel abbrechen</button>
}

templ scores(v service.GameView, errMsg string, editing *throw.Dart) {
	{{ p := progressOf(v) }}
	<div id="board" sse-swap="board" hx-swap="outerHTML" data-sound={ soundKind(v) } data-sound-id={ soundID(v) }>
		@gameTitle(v, &p)
		@errorAlert(errMsg)
		if p.GameOver {
			<div class="relative mb-6 overflow-hidden rounded-3xl bg-gradient-to-br from-amber-300 via-amber-400 to-orange-500 p-6 text-pub-950 shadow-2xl shadow-amber-500/30 animate-dart-in" role="status">
				<div class="font-display text-5xl font-extrabold uppercase sm:text-6xl">🏆 { playerName(v, *p.WinnerID) } gewinnt!</div>
				<a href="/" class="mt-4 inline-block rounded-xl bg-pub-950 px-5 py-2.5 font-semibold text-amber-300 hover:bg-pub-800">Neues Spiel</a>
			</div>
		}
		if p.Aborted {
			<div class="mb-6 rounded-3xl border border-white/10 bg-pub-800 p-6" role="status">
				<div class="font-display text-4xl font-extrabold uppercase text-white/80">Spiel abgebrochen</div>
				<a href="/" class="mt-4 inline-block rounded-xl bg-white/10 px-5 py-2.5 font-semibold hover:bg-white/20">Neues Spiel</a>
			</div>
		}
		// Desktop: players, darts and input, board side by side, so a turn needs no
		// scrolling; history and statistics follow below. Narrow screens stack them.
		<div class="grid items-start gap-4 lg:grid-cols-[minmax(0,4fr)_minmax(0,5fr)_minmax(0,4fr)] lg:gap-6">
			<div class="flex flex-col gap-2">
				for i, l := range playerLines(v, p) {
					if i == 0 && (p.isCurrent(l.ID) || p.isWinner(l.ID)) {
						@playerCard(v, p, l)
					} else {
						@playerRow(v, p, l, i == 1 && p.CurrentPlayerID != nil)
					}
				}
			</div>
			<div class="flex flex-col gap-4">
				@celebration(v, p)
				if editing != nil && v.CanThrow {
					@editPanel(v, *editing)
				} else if p.BullingOff && p.running() {
					@bullOffPanel(v, p)
				} else if p.running() {
					<div class="grid grid-cols-3 gap-3">
						{{ thrown, suggestion := turnDarts(v, p), checkoutSuggestion(v, p) }}
						for i := range turn.DartsPerTurn {
							if i < len(thrown) {
								@dartTile(v, thrown[i])
							} else if j := i - len(thrown); j < len(suggestion) {
								// The way to finish, like Autodarts shows it.
								<span class="flex h-20 flex-col items-center justify-center rounded-2xl border-2 border-dashed border-amber-400/60 bg-amber-400/5 font-display text-amber-300 sm:h-24 lg:h-20" title="Vorschlag zum Auschecken">
									<span class={ templ.KV("text-2xl sm:text-3xl", len(suggestion[j].String()) > 4), templ.KV("text-4xl", len(suggestion[j].String()) <= 4) }>{ suggestion[j].String() }</span>
									if j == 0 {
										<span class="text-xs font-semibold uppercase tracking-widest text-amber-300/60">Checkout</span>
									}
								</span>
							} else {
								<span class="flex h-20 items-center justify-center rounded-2xl border-2 border-dashed border-white/15 font-display text-4xl text-white/20 sm:h-24 lg:h-20">{ strconv.Itoa(i + 1) }</span>
							}
						}
					</div>
					if p.WaitingForTakeout {
						<div class="flex flex-wrap items-center justify-between gap-3 rounded-2xl border border-amber-400/50 bg-amber-400/10 px-4 py-3 [--glow-color:var(--color-amber-400)] animate-glow" role="status">
							<span>
								<span class="font-display text-2xl font-extrabold uppercase text-amber-300">Pfeile ziehen</span>
								if p.LegOver {
									<span class="block text-white/70">Danach beginnt Leg { strconv.Itoa(p.Leg + 1) }.</span>
								} else {
									<span class="block text-white/70">Danach ist { nextPlayerName(v, p) } dran.</span>
								}
								if v.Board != nil {
									<span class="block text-sm text-white/50">Die Kamera erkennt das Herausziehen von selbst.</span>
								}
							</span>
							if v.CanThrow {
								<button
									type="button"
									class="rounded-xl bg-amber-400 px-5 py-3 font-display text-xl font-extrabold uppercase text-pub-950 transition hover:bg-amber-300 active:scale-95"
									hx-post={ gameURL(v.Game.ID, "/takeout") }
									hx-target="#board"
									hx-swap="outerHTML"
								>Pfeile gezogen</button>
							}
						</div>
					} else if v.CanThrow {
						@dartInput(v, gameURL(v.Game.ID, "/darts"))
					}
				}
				<div class="flex flex-wrap gap-2">
					if v.CanThrow {
						<button
							type="button"
							class="rounded-xl border border-white/15 px-4 py-2 text-sm font-semibold text-white/80 transition hover:bg-white/10 disabled:opacity-30"
							hx-post={ gameURL(v.Game.ID, "/undo") }
							hx-target="#board"
							hx-swap="outerHTML"
							disabled?={ len(v.Darts) == 0 }
						>↶ Letzten Dart zurücknehmen</button>
					}
					if v.IsOwner && p.running() {
						@abortButton(v)
					}
				</div>
			</div>
			<div>
				@dartboardView(v, p)
			</div>
		</div>
		switch st := v.State.(type) {
			case x01.State:
				if len(st.Turns) > 0 {
					@x01History(v, st)
				}
			case aroundtheclock.State:
				if len(st.Turns) > 0 {
					@aroundTheClockHistory(v, st)
				}
		}
		if hasTurns(v) {
			@gameStats(v)
		}
	</div>
}

// celebration shows a big effect right after a special turn: 180 or busted.
templ celebration(v service.GameView, p progress) {
	if player, decided := bullOffDecided(v, p); decided {
		<div class="mb-4 animate-dart-in rounded-2xl bg-gradient-to-r from-board-red to-board-green px-4 py-3 text-center font-display text-3xl font-extrabold uppercase text-white shadow-lg">{ playerName(v, player) } beginnt!</div>
	}
	if p.LegWinner != nil {
		<div class="mb-4 animate-dart-in rounded-2xl bg-gradient-to-r from-amber-300 to-amber-500 px-4 py-3 text-center font-display text-3xl font-extrabold uppercase text-pub-950 shadow-lg shadow-amber-500/30">Leg an { playerName(v, *p.LegWinner) }!</div>
	}
	switch latestTurnEvent(v) {
		case "180":
			<div class="pointer-events-none fixed inset-0 z-50 flex items-center justify-center">
				<div class="animate-celebrate font-display text-[10rem] font-extrabold leading-none text-amber-300 drop-shadow-[0_0_2rem_rgba(251,191,36,0.8)] sm:text-[16rem]">180!</div>
			</div>
		case "bust":
			<div class="mb-4 animate-shake rounded-2xl bg-board-red px-4 py-3 text-center font-display text-3xl font-extrabold uppercase text-white shadow-lg shadow-board-red/40">Überworfen!</div>
	}
}

// dartboardView draws the board with the darts of the current turn and, in around the
// clock, the field to hit next.
templ dartboardView(v service.GameView, p progress) {
	{{ target := boardTargetOf(v, p) }}
	<div class="mx-auto aspect-square w-full max-w-md rounded-full shadow-[0_1rem_2rem_rgba(0,0,0,0.6)]">
		<svg viewBox={ boardViewBox } class="h-full w-full" role="img" aria-label="Dartboard">
			<circle cx="228" cy="228" r="226" fill="#0b0c0f" stroke="#2b2e35" stroke-width="3"></circle>
			for _, s := range boardShapes {
				<path d={ s.Path } fill={ s.Fill } stroke={ boardWire } stroke-width="0.8"></path>
			}
			<circle cx="228" cy="228" r={ strconv.FormatFloat(15.9, 'f', 1, 64) } fill={ boardGreen } stroke={ boardWire } stroke-width="0.8"></circle>
			<circle cx="228" cy="228" r={ strconv.FormatFloat(6.35, 'f', 2, 64) } fill={ boardRed } stroke={ boardWire } stroke-width="0.8"></circle>
			if target != 0 {
				<path d={ targetPath(target) } fill={ boardTarget } fill-opacity="0.45" stroke={ boardTarget } stroke-width="3" stroke-linejoin="round"></path>
				if target == throw.Bull {
					// The bull is small on the board: a ring around it makes it easy to spot.
					<circle cx="228" cy="228" r="26" fill="none" stroke={ boardTarget } stroke-width="4"></circle>
				}
				// Lights up on top of the marking: brighter, with a wide soft edge.
				<g class="animate-target" pointer-events="none">
					<path d={ targetPath(target) } fill={ boardTarget } fill-opacity="0.4" stroke={ boardTarget } stroke-width="10" stroke-opacity="0.45" stroke-linejoin="round"></path>
					if target == throw.Bull {
						<circle cx="228" cy="228" r="26" fill="none" stroke={ boardTarget } stroke-width="10" stroke-opacity="0.45"></circle>
					}
				</g>
			}
			for _, n := range boardNumbers {
				if target != 0 && n.Text == strconv.Itoa(int(target)) {
					<text x={ n.X } y={ n.Y } fill={ boardTarget } font-size="32" font-family="Barlow Condensed, sans-serif" font-weight="800" text-anchor="middle" dominant-baseline="central">{ n.Text }</text>
				} else {
					<text x={ n.X } y={ n.Y } fill="#e9dcc0" font-size="24" font-family="Barlow Condensed, sans-serif" font-weight="800" text-anchor="middle" dominant-baseline="central">{ n.Text }</text>
				}
			}
			for _, d := range boardDarts(v, p) {
				<g class={ templ.KV("opacity-40", d.Faded) }>
					if d.Latest {
						<circle cx={ d.X } cy={ d.Y } r="9" fill={ d.Fill } class="svg-center animate-ping"></circle>
					}
					<circle cx={ d.X } cy={ d.Y } r="9" fill={ d.Fill } stroke="#0b0c0f" stroke-width="2.5" class={ "svg-center", templ.KV("animate-dart-in", d.Latest) }></circle>
					<text x={ d.X } y={ d.Y } fill="#0b0c0f" font-size="13" font-weight="800" text-anchor="middle" dominant-baseline="central">{ d.Label }</text>
				</g>
			}
		</svg>
	</div>
}

// gameStats shows the statistics of all players in this game.
templ gameStats(v service.GameView) {
	@panel("mt-6") {
		<h2 class="mb-3 font-display text-2xl font-extrabold uppercase tracking-wide text-board-cream">Statistik</h2>
		<div class="overflow-x-auto">
			<table class="w-full text-sm tabular-nums">
				switch st := v.State.(type) {
					case x01.State:
						<thead class="text-left text-xs uppercase tracking-wider text-white/50">
							<tr>
								<th class="py-2 font-semibold">Spieler</th>
								<th class="py-2 text-right font-semibold" title="Punkte pro 3 Darts">Ø</th>
								<th class="py-2 text-right font-semibold">Darts</th>
								<th class="py-2 text-right font-semibold">Höchste</th>
								<th class="py-2 text-right font-semibold">100+</th>
								<th class="py-2 text-right font-semibold">140+</th>
								<th class="py-2 text-right font-semibold">180</th>
							</tr>
						</thead>
						<tbody class="divide-y divide-white/5">
							for _, ps := range st.Players {
								<tr>
									<td class="py-2 font-semibold">{ playerName(v, ps.PlayerID) }</td>
									<td class="py-2 text-right">{ decimal(ps.Stats.Average) }</td>
									<td class="py-2 text-right">{ strconv.Itoa(ps.Stats.Darts) }</td>
									<td class="py-2 text-right">{ strconv.FormatUint(ps.Stats.HighestTurn, 10) }</td>
									<td class="py-2 text-right">{ strconv.Itoa(ps.Stats.Turns100) }</td>
									<td class="py-2 text-right">{ strconv.Itoa(ps.Stats.Turns140) }</td>
									<td class="py-2 text-right">{ strconv.Itoa(ps.Stats.Turns180) }</td>
								</tr>
							}
						</tbody>
					case aroundtheclock.State:
						<thead class="text-left text-xs uppercase tracking-wider text-white/50">
							<tr>
								<th class="py-2 font-semibold">Spieler</th>
								<th class="py-2 text-right font-semibold">Darts</th>
								<th class="py-2 text-right font-semibold">Treffer</th>
								<th class="py-2 text-right font-semibold">Trefferquote</th>
							</tr>
						</thead>
						<tbody class="divide-y divide-white/5">
							for _, ps := range st.Players {
								<tr>
									<td class="py-2 font-semibold">{ playerName(v, ps.PlayerID) }</td>
									<td class="py-2 text-right">{ strconv.Itoa(ps.Stats.Darts) }</td>
									<td class="py-2 text-right">{ strconv.Itoa(ps.Stats.Hits) }</td>
									<td class="py-2 text-right">{ percent(ps.Stats.HitRate) }</td>
								</tr>
							}
						</tbody>
				}
			</table>
		</div>
	}
}

// playerCard shows the player whose turn it is (or the winner) in large: the main value
// (rest, target) and a second key figure next to it. With more than one leg to win, it
// shows the legs won as dots.
templ playerCard(v service.GameView, p progress, l playerLine) {
	{{ winner := p.isWinner(l.ID) }}
	<div
		class={ "relative rounded-3xl border p-5 transition-colors duration-300",
			templ.KV("border-board-green/70 bg-gradient-to-br from-board-green/25 to-pub-900 [--glow-color:var(--color-board-green)] animate-glow", !winner),
			templ.KV("border-amber-400/80 bg-gradient-to-br from-amber-400/25 to-pub-900 [--glow-color:var(--color-amber-400)] animate-glow", winner) }
	>
		<div class="flex items-center justify-between gap-2">
			<span class="truncate font-display text-2xl font-semibold uppercase tracking-wide">{ playerName(v, l.ID) }</span>
			@legDots(v, l.Legs)
			if winner {
				<span class="rounded-full bg-amber-400 px-3 py-0.5 font-display text-lg font-extrabold uppercase text-pub-950">Sieg</span>
			} else {
				<span class="rounded-full bg-board-green px-3 py-0.5 font-display text-lg font-extrabold uppercase text-white">am Zug</span>
			}
		</div>
		<div class="mt-2 flex items-end justify-between gap-3">
			<div>
				<div class="font-display text-7xl leading-none font-extrabold tabular-nums sm:text-8xl">{ l.Value }</div>
				<div class="mt-1 text-xs uppercase tracking-widest text-white/50">{ l.Caption }</div>
			</div>
			<div class="text-right">
				<div class="font-display text-4xl leading-none font-semibold tabular-nums text-white/90">{ l.Stat }</div>
				<div class="mt-1 text-xs uppercase tracking-widest text-white/50">{ l.StatCaption }</div>
			</div>
		</div>
	</div>
}

// playerRow shows a player who waits, in one compact line; next marks who throws next.
templ playerRow(v service.GameView, p progress, l playerLine, next bool) {
	<div class={ "flex items-center gap-3 rounded-2xl border border-white/10 bg-pub-900/70 px-4 py-2", templ.KV("opacity-60", !next && p.running()) }>
		<div class="min-w-0 flex-1">
			<div class="flex items-center gap-2">
				<span class="truncate font-display text-xl font-semibold uppercase tracking-wide">{ playerName(v, l.ID) }</span>
				@legDots(v, l.Legs)
			</div>
			if next {
				<div class="text-xs font-semibold uppercase tracking-widest text-emerald-300/80">als Nächstes</div>
			}
		</div>
		<div class="text-right lg:max-xl:hidden">
			<div class="font-display text-xl leading-none font-semibold tabular-nums text-white/70">{ l.Stat }</div>
			<div class="text-[0.65rem] uppercase tracking-widest text-white/40">{ l.StatCaption }</div>
		</div>
		<div class="w-20 text-right">
			<div class="font-display text-4xl leading-none font-extrabold tabular-nums">{ l.Value }</div>
			<div class="text-[0.65rem] uppercase tracking-widest text-white/40">{ l.Caption }</div>
		</div>
	</div>
}

// legDots shows the legs a player won, with more than one leg to win.
templ legDots(v service.GameView, legs int) {
	if v.Game.Legs > 1 {
		<span class="flex gap-1" title={ strconv.Itoa(legs) + " Legs gewonnen" }>
			for i := range v.Game.Legs {
				<span class={ "size-3 rounded-full", templ.KV("bg-amber-400 shadow shadow-amber-400/60", i < legs), templ.KV("bg-white/15", i >= legs) }></span>
			}
		</span>
	}
}

// keypad enters a dart (posted to action): choose single, double or triple, then tap the number.
templ keypad(v service.GameView, action string) {
	{{ target := currentTarget(v) }}
	<form
		hx-post={ action }
		hx-target="#board"
		hx-swap="outerHTML"
		class="flex flex-col gap-3"
	>
		<div class="grid grid-cols-3 gap-1 rounded-2xl bg-pub-800 p-1" role="group" aria-label="Multiplikator">
			@multiplierButton("1", "Single", true)
			@multiplierButton("2", "Doppel", false)
			@multiplierButton("3", "Triple", false)
		</div>
		<div class="grid grid-cols-5 gap-2">
			for n := 1; n <= 20; n++ {
				<button
					type="submit"
					name="number"
					value={ strconv.Itoa(n) }
					class={ "h-14 rounded-xl font-display text-3xl font-semibold transition active:scale-90 sm:h-16 lg:h-12",
						templ.KV("bg-board-green text-white shadow-lg shadow-board-green/40 hover:brightness-110", uint8(n) == target),
						templ.KV("bg-pub-700 text-board-cream hover:bg-pub-700/70", uint8(n) != target) }
				>{ strconv.Itoa(n) }</button>
			}
			<button
				type="submit"
				name="number"
				value="25"
				class={ "col-span-2 h-14 rounded-xl font-display text-3xl font-extrabold uppercase text-white transition active:scale-95 sm:h-16 lg:h-12",
					templ.KV("bg-board-green shadow-lg shadow-board-green/40 ring-2 ring-white", target == throw.Bull),
					templ.KV("bg-board-green/80 hover:bg-board-green", target != throw.Bull) }
			>Bull</button>
			<button type="submit" name="miss" value="true" class="col-span-3 h-14 rounded-xl bg-board-red/85 font-display text-3xl font-extrabold uppercase text-white transition hover:bg-board-red active:scale-95 sm:h-16 lg:h-12">Daneben</button>
		</div>
	</form>
}

// dartInput enters the next dart. In around the clock only hitting the target or not
// matters, so there are buttons for that; the full keypad is folded away for the rare
// case someone wants to enter the exact number.
templ dartInput(v service.GameView, action string) {
	{{ target := currentTarget(v) }}
	if target == 0 {
		@keypad(v, action)
	} else {
		{{ skips := v.Game.AroundTheClock.MultiplierSkips && target != throw.Bull }}
		<div class="flex flex-col gap-3">
			<div class={ "grid gap-2", templ.KV("grid-cols-2", !skips), templ.KV("grid-cols-3", skips) }>
				@quickDart(action, target, 1, "Treffer "+targetLabel(target), skips, "h-24 bg-board-green text-5xl shadow-board-green/40")
				if skips {
					@quickDart(action, target, 2, "D"+targetLabel(target), false, "h-16 bg-board-green/75 text-3xl shadow-board-green/30")
					@quickDart(action, target, 3, "T"+targetLabel(target), false, "h-16 bg-board-green/75 text-3xl shadow-board-green/30")
				}
				<form hx-post={ action } hx-target="#board" hx-swap="outerHTML">
					<button type="submit" name="miss" value="true" class={ "w-full rounded-2xl bg-board-red/85 font-display font-extrabold uppercase text-white shadow-lg shadow-board-red/30 transition hover:bg-board-red active:scale-95", templ.KV("h-24 text-5xl", !skips), templ.KV("h-16 text-3xl", skips) }>Daneben</button>
				</form>
			</div>
			<details class="group">
				<summary class="cursor-pointer list-none text-sm font-semibold text-white/50 hover:text-white/80">
					<span class="group-open:hidden">▸ Andere Zahl eintragen</span>
					<span class="hidden group-open:inline">▾ Andere Zahl eintragen</span>
				</summary>
				<div class="mt-3">
					@keypad(v, action)
				</div>
			</details>
		</div>
	}
}

// quickDart is a button that enters a given field; wide spans the whole row.
templ quickDart(action string, number uint8, multiplier int, label string, wide bool, classes string) {
	<form hx-post={ action } hx-target="#board" hx-swap="outerHTML" class={ templ.KV("col-span-3", wide) }>
		<input type="hidden" name="number" value={ strconv.Itoa(int(number)) }/>
		<input type="hidden" name="multiplier" value={ strconv.Itoa(multiplier) }/>
		<button type="submit" class={ "w-full rounded-2xl font-display font-extrabold uppercase text-white shadow-lg transition hover:brightness-110 active:scale-95", classes }>{ label }</button>
	</form>
}

// multiplierButton is one option of the segmented single/double/triple control.
templ multiplierButton(value, label string, checked bool) {
	<label class="cursor-pointer">
		<input type="radio" name="multiplier" value={ value } checked?={ checked } class="peer sr-only"/>
		<span class="block rounded-xl py-2 text-center font-display text-xl font-semibold uppercase tracking-wide text-white/60 transition peer-checked:bg-board-cream peer-checked:text-pub-950 peer-checked:shadow peer-focus-visible:ring-2 peer-focus-visible:ring-amber-400">{ label }</span>
	</label>
}

// historyPanel is the frame of the turn history.
templ historyPanel() {
	@panel("mt-6") {
		<h2 class="mb-3 font-display text-2xl font-extrabold uppercase tracking-wide text-board-cream">Verlauf</h2>
		<div class="overflow-x-auto">
			<table class="w-full text-sm tabular-nums">
				{ children... }
			</table>
		</div>
	}
}

// x01History lists the turns, newest first, so everyone can see what was thrown
// after the next player's turn started.
templ x01History(v service.GameView, st x01.State) {
	@historyPanel() {
		<thead class="text-left text-xs uppercase tracking-wider text-white/50">
			<tr>
				<th class="py-2 font-semibold">Runde</th>
				<th class="py-2 font-semibold">Spieler</th>
				<th class="py-2 font-semibold">Darts</th>
				<th class="py-2 text-right font-semibold">Punkte</th>
				<th class="py-2 text-right font-semibold">Rest</th>
			</tr>
		</thead>
		<tbody class="divide-y divide-white/5">
			for i := len(st.Turns) - 1; i >= 0; i-- {
				@legSeparator(v, st.Turns[i].Leg, i == len(st.Turns)-1 || st.Turns[i+1].Leg != st.Turns[i].Leg, 5)
				@x01HistoryRow(v, st.Turns[i])
			}
		</tbody>
	}
}

templ x01HistoryRow(v service.GameView, t x01.Turn) {
	<tr>
		<td class="py-2 text-white/50">{ strconv.Itoa(t.Round) }</td>
		<td class="py-2 font-semibold">{ playerName(v, t.PlayerID) }</td>
		<td class="py-2">
			@turnDartsList(v, t.Darts, t.Complete)
		</td>
		<td class="py-2 text-right">
			if t.Bust {
				<span class="rounded-full bg-board-red/25 px-2 py-0.5 text-xs font-semibold text-red-300">überworfen</span>
			} else {
				<span class={ templ.KV("font-display text-lg font-extrabold text-amber-300", t.Points >= 100) }>{ strconv.FormatUint(t.Points, 10) }</span>
			}
		</td>
		<td class="py-2 text-right">
			if t.Checkout {
				<span class="rounded-full bg-amber-400 px-2 py-0.5 text-xs font-bold text-pub-950">✓ Checkout</span>
			} else {
				{ strconv.FormatUint(t.Remaining, 10) }
			}
		</td>
	</tr>
}

// turnDartsList lists the darts of a turn in the history.
templ turnDartsList(v service.GameView, darts []throw.Dart, complete bool) {
	<span class="inline-flex flex-wrap items-center gap-1.5">
		for _, d := range darts {
			@dartLink(v, d)
		}
		if !complete {
			<span class="text-white/40">…</span>
		}
	</span>
}

// dartTile shows a dart of the current turn in large; players who may enter darts can tap it to correct it.
// The dart just thrown flies in.
templ dartTile(v service.GameView, d throw.Dart) {
	if v.CanThrow {
		<button type="button" class={ dartTileClasses(v, d), "hover:brightness-110 active:scale-95" } title="Korrigieren" hx-get={ dartEditURL(v, d) } hx-target="#board" hx-swap="outerHTML">{ d.String() }</button>
	} else {
		<span class={ dartTileClasses(v, d) }>{ d.String() }</span>
	}
}

// dartLink shows a dart in the history; players who may enter darts can click it to correct it.
// Misses are red, in around the clock darts that hit the target green.
templ dartLink(v service.GameView, d throw.Dart) {
	if v.CanThrow {
		<a href="#" title="Korrigieren" class={ "rounded-md px-1.5 py-0.5 font-semibold transition hover:ring-1 hover:ring-white/40", dartChipColors(v, d) } hx-get={ dartEditURL(v, d) } hx-target="#board" hx-swap="outerHTML">{ d.String() }</a>
	} else {
		<span class={ "rounded-md px-1.5 py-0.5 font-semibold", dartChipColors(v, d) }>{ d.String() }</span>
	}
}

// editPanel corrects an earlier dart with the keypad.
templ editPanel(v service.GameView, d throw.Dart) {
	<div class="flex flex-wrap items-center justify-between gap-3 rounded-2xl border border-sky-400/50 bg-sky-400/10 px-4 py-3">
		<span>
			<span class="font-display text-xl font-extrabold uppercase text-sky-300">Dart korrigieren:</span> { d.String() } von { dartThrower(v, d.ID) }
			<span class="block text-sm text-white/60">Wähle, was stattdessen getroffen wurde; Punkte, Rest und Statistik rechnen sich neu.</span>
		</span>
		<button type="button" class="rounded-xl border border-white/20 px-4 py-2 text-sm font-semibold hover:bg-white/10" hx-get={ gameURL(v.Game.ID, "/board") } hx-target="#board" hx-swap="outerHTML">Abbrechen</button>
	</div>
	@keypad(v, dartEditURL(v, d))
}

// aroundTheClockHistory lists the turns, newest first; dartLink colors hits and misses.
templ aroundTheClockHistory(v service.GameView, st aroundtheclock.State) {
	@historyPanel() {
		<thead class="text-left text-xs uppercase tracking-wider text-white/50">
			<tr>
				<th class="py-2 font-semibold">Runde</th>
				<th class="py-2 font-semibold">Spieler</th>
				<th class="py-2 font-semibold">Darts</th>
				<th class="py-2 text-right font-semibold">Treffer</th>
				<th class="py-2 text-right font-semibold">Ziel</th>
			</tr>
		</thead>
		<tbody class="divide-y divide-white/5">
			for i := len(st.Turns) - 1; i >= 0; i-- {
				@legSeparator(v, st.Turns[i].Leg, i == len(st.Turns)-1 || st.Turns[i+1].Leg != st.Turns[i].Leg, 5)
				@aroundTheClockHistoryRow(v, st.Turns[i])
			}
		</tbody>
	}
}

templ aroundTheClockHistoryRow(v service.GameView, t aroundtheclock.Turn) {
	<tr>
		<td class="py-2 text-white/50">{ strconv.Itoa(t.Round) }</td>
		<td class="py-2 font-semibold">{ playerName(v, t.PlayerID) }</td>
		<td class="py-2">
			@turnDartsList(v, t.Darts, t.Complete)
		</td>
		<td class="py-2 text-right">{ strconv.Itoa(countTrue(t.Hits)) }</td>
		<td class="py-2 text-right">
			if t.Target == 0 {
				<span class="rounded-full bg-amber-400 px-2 py-0.5 text-xs font-bold text-pub-950">✓ fertig</span>
			} else if t.Target != t.From {
				<span class="text-white/40">{ targetLabel(t.From) } →</span> <span class="font-display text-lg font-extrabold text-emerald-300">{ targetLabel(t.Target) }</span>
			} else {
				{ targetLabel(t.Target) }
			}
		</td>
	</tr>
}

// legSeparator heads the turns of a leg in the history (newest first), with more than one leg to win.
templ legSeparator(v service.GameView, leg int, first bool, columns int) {
	if v.Game.Legs > 1 && first {
		<tr>
			<td colspan={ strconv.Itoa(columns) } class="pt-4 pb-1 font-display text-lg font-extrabold uppercase tracking-wider text-amber-300">Leg { strconv.Itoa(leg) }</td>
		</tr>
	}
}

// bullOffPanel shows the bull-off: who throws, the darts so far and, for entering them by
// hand, what counts (the bullseye beats the bull, which beats the rest). The cameras
// enter the darts with their position, so the closest wins.
templ bullOffPanel(v service.GameView, p progress) {
	<div class="rounded-2xl border border-board-red/50 bg-board-red/10 px-4 py-3">
		<div class="font-display text-2xl font-extrabold uppercase text-red-300">Ausbullen</div>
		<div class="text-white/70">
			{ playerName(v, *p.CurrentPlayerID) } wirft auf das Bull. Wer am nächsten dran ist, beginnt; bei Gleichstand werfen die Gleichen nochmal.
		</div>
		if darts := p.BullOff; len(darts) > 0 {
			<ul class="mt-3 flex flex-col gap-1">
				for i, b := range darts {
					if b.Round > 0 && (i == 0 || darts[i-1].Round != b.Round) {
						<li class="pt-1 text-xs font-semibold uppercase tracking-widest text-white/50">Stechen</li>
					}
					<li class="flex items-center justify-between gap-2">
						<span class="font-semibold">{ playerName(v, b.PlayerID) }</span>
						<span class="flex items-center gap-2">
							<span class="text-sm text-white/50">{ bullOffDistance(v.Darts[b.Entry]) }</span>
							@dartLink(v, v.Darts[b.Entry])
						</span>
					</li>
				}
			</ul>
		}
	</div>
	if tie := p.BullOffTie; len(tie) > 0 && v.CanThrow {
		<div class="rounded-2xl border border-amber-400/50 bg-amber-400/10 px-4 py-3">
			<div class="font-semibold text-amber-200">Gleichstand! Wer war näher dran? Sonst werft nochmal.</div>
			<div class="mt-2 flex flex-wrap gap-2">
				for _, id := range tie {
					<button
						type="button"
						class={ btnAccent }
						hx-post={ gameURL(v.Game.ID, "/bull-off/"+strconv.FormatInt(id, 10)) }
						hx-target="#board"
						hx-swap="outerHTML"
					>{ playerName(v, id) } war näher</button>
				}
			</div>
		</div>
	}
	if v.CanThrow {
		{{ action := gameURL(v.Game.ID, "/darts") }}
		<div class="grid grid-cols-3 gap-2">
			@quickDart(action, throw.Bull, 2, "Bullseye", false, "h-20 bg-board-red text-3xl shadow-board-red/40")
			@quickDart(action, throw.Bull, 1, "Bull", false, "h-20 bg-board-green text-3xl shadow-board-green/40")
			<form hx-post={ action } hx-target="#board" hx-swap="outerHTML">
				<button type="submit" name="miss" value="true" class="h-20 w-full rounded-2xl bg-pub-700 font-display text-3xl font-extrabold uppercase text-white/80 shadow-lg transition hover:bg-pub-700/70 active:scale-95">Daneben</button>
			</form>
		</div>
	}
}
