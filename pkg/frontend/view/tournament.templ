package view

import (
	"strconv"

	"github.com/sj14/darts-o-mat/pkg/domain/board"
	"github.com/sj14/darts-o-mat/pkg/domain/game"
	"github.com/sj14/darts-o-mat/pkg/domain/stats"
	"github.com/sj14/darts-o-mat/pkg/domain/tournament"
	"github.com/sj14/darts-o-mat/pkg/service"
)

// Tournament shows a tournament: who plays, the bracket or table with the results, the
// games to start next and the statistics of its finished games.
templ Tournament(user string, v service.TournamentView, errMsg string) {
	@layout(tournamentLabel(T(ctx), v.Tournament), user) {
		// The server pushes the tournament whenever it or one of its games changes; the
		// element swaps itself on "tournament".
		<div hx-ext="sse" sse-connect={ tournamentURL(v.Tournament.ID, "/events") }>
			@TournamentBody(v, errMsg)
		</div>
	}
}

// TournamentBody is the part of the tournament page that the server replaces on changes.
templ TournamentBody(v service.TournamentView, errMsg string) {
	<div id="tournament" sse-swap="tournament" hx-swap="outerHTML">
		<div class="mb-5 flex flex-wrap items-end justify-between gap-2">
			<div>
				<h1 class="font-display text-4xl font-extrabold uppercase tracking-wide text-board-cream sm:text-5xl">{ formatName(T(ctx), v.Tournament.Format) }</h1>
				<p class="mt-1 text-white/60">{ modeLabel(T(ctx), v.Tournament.Settings) } · { T(ctx).PlayerCount(len(v.Players)) }</p>
			</div>
			@tournamentBadge(v)
		</div>
		@errorAlert(errMsg)
		if v.Invited {
			<div class="mb-6 flex flex-wrap items-center justify-between gap-3 rounded-2xl border border-amber-400/50 bg-amber-400/10 px-4 py-3">
				<span>{ T(ctx).InvitedToTournament() }</span>
				@answerTournament(v.Tournament.ID, boardsOfChoices(v.Boards))
			</div>
		} else if !v.Ready && !v.Tournament.Aborted() {
			<div class="mb-6 rounded-2xl border border-amber-400/50 bg-amber-400/10 px-4 py-3">
				if !v.Tournament.Full(len(v.Tournament.Participants)) {
					<p>{ T(ctx).WaitingForSeats(v.Tournament.Seats - len(v.Tournament.Participants)) }</p>
				}
				if tournamentPending(ctx, v) != "" {
					<p>{ T(ctx).WaitingFor(tournamentPending(ctx, v)) }</p>
				}
			</div>
		}
		if v.State.Over {
			<div class="mb-6 rounded-3xl bg-gradient-to-r from-amber-300 to-amber-500 px-5 py-4 text-center text-pub-950 shadow-lg shadow-amber-500/30">
				<div class="font-display text-4xl font-extrabold uppercase">{ T(ctx).WinsTournament(tournamentPlayerName(ctx, v, *v.State.WinnerID)) }</div>
				if d := v.Time.Duration(); d > 0 {
					<div class="mt-1 font-semibold tabular-nums">{ T(ctx).Duration(clock(d)) }</div>
				}
			</div>
		}
		<div class="flex flex-col gap-6">
			if v.Tournament.Format == tournament.Knockout {
				@bracket(v)
			} else {
				@standings(v)
				@roundRobinMatches(v)
			}
			@tournamentStats(v)
			if !v.Invited && !v.State.Over && !v.Tournament.Aborted() {
				<form method="post" action={ templ.URL(tournamentURL(v.Tournament.ID, "/leave")) } data-confirm={ T(ctx).LeaveTournamentConfirm() } onsubmit="return confirm(this.dataset.confirm)">
					<button type="submit" class={ btnDanger, btnSmall }>{ T(ctx).LeaveTournament() }</button>
				</form>
			}
		</div>
	</div>
}

templ tournamentBadge(v service.TournamentView) {
	switch  {
		case v.Tournament.Aborted():
			@statusBadge(T(ctx).StatusAborted(), "bg-white/10 text-white/50")
		case !v.Ready:
			@statusBadge(T(ctx).StatusWaiting(), "bg-amber-400/20 text-amber-300")
		case v.State.Over:
			@statusBadge(T(ctx).StatusOver(), "bg-board-cream/15 text-board-cream")
		default:
			@statusBadge(T(ctx).StatusRunning(), "bg-board-green/25 text-emerald-300")
	}
}

templ answerTournament(id int64, boards []board.Board) {
	<div class="flex flex-wrap items-center gap-2">
		<form method="post" action={ templ.URL(tournamentURL(id, "/accept")) } class="flex items-center gap-2">
			@boardSelect(boards)
			<button type="submit" class={ btnPrimary }>{ T(ctx).Accept() }</button>
		</form>
		<form method="post" action={ templ.URL(tournamentURL(id, "/decline")) }>
			<button type="submit" class={ btnDanger }>{ T(ctx).Decline() }</button>
		</form>
	</div>
}

// bracket shows the knockout bracket, one column per round.
templ bracket(v service.TournamentView) {
	@panel("") {
		@sectionTitle(T(ctx).Bracket())
		<div class="-mx-2 overflow-x-auto px-2 pb-2">
			<div class="flex min-w-max gap-4">
				for r := 1; r <= v.State.Rounds; r++ {
					<div class="flex w-60 flex-col">
						<div class={ labelClass }>{ T(ctx).RoundName(v.State.Rounds, r) }</div>
						<div class="flex flex-1 flex-col justify-around gap-3">
							for _, m := range v.State.Matches {
								if m.Round == r {
									@matchCard(v, m)
								}
							}
						</div>
					</div>
				}
			</div>
		</div>
	}
}

// matchCard shows a match with its players, the score and what can be done with it.
templ matchCard(v service.TournamentView, m tournament.Match) {
	<div class={ "rounded-2xl border bg-pub-800 p-2", templ.KV("border-board-green/60", v.CanStart(m)), templ.KV("border-white/10", !v.CanStart(m)) }>
		for j, id := range m.PlayerIDs {
			<div class={ "flex items-center justify-between gap-2 rounded-lg px-2 py-1", templ.KV("bg-amber-400/15 font-bold text-amber-200", id != 0 && m.Winner() == id) }>
				<span class={ "truncate", templ.KV("text-white/30 italic", id == 0) }>
					if id != 0 {
						{ tournamentPlayerName(ctx, v, id) }
					} else if m.Bye {
						{ T(ctx).Bye() }
					} else {
						{ T(ctx).Open() }
					}
				</span>
				if m.Result != nil {
					<span class="font-display text-xl tabular-nums">{ strconv.Itoa(m.Result.Score[j]) }</span>
				}
			</div>
		}
		@matchAction(v, m)
	</div>
}

// matchAction starts the game of a match or links to it.
templ matchAction(v service.TournamentView, m tournament.Match) {
	switch  {
		case v.CanStart(m):
			<form method="post" action={ templ.URL(tournamentURL(v.Tournament.ID, "/matches/"+strconv.Itoa(m.Index))) } class="mt-1">
				<button type="submit" class={ btnPrimary, btnSmall, "w-full" }>{ T(ctx).StartGame() }</button>
			</form>
		case m.Result != nil && !m.Result.Over:
			<a href={ templ.URL(gameURL(m.Result.GameID, "")) } class={ "mt-1 block text-center text-sm", linkClass }>{ T(ctx).RunningToGame() }</a>
		case m.Result != nil:
			<a href={ templ.URL(gameURL(m.Result.GameID, "")) } class="mt-1 block text-center text-sm text-white/50 hover:text-white/80">{ T(ctx).ToGame() }</a>
	}
}

// standings shows the table of a round-robin tournament.
templ standings(v service.TournamentView) {
	@panel("") {
		@sectionTitle(T(ctx).Table())
		<div class="overflow-x-auto">
			<table class="w-full text-left">
				<thead class="text-xs uppercase tracking-widest text-white/50">
					<tr>
						<th class="py-2 font-semibold">#</th>
						<th class="py-2 font-semibold">{ T(ctx).Player() }</th>
						<th class="py-2 text-right font-semibold">{ T(ctx).Games() }</th>
						<th class="py-2 text-right font-semibold">{ T(ctx).Wins() }</th>
						<th class="py-2 text-right font-semibold">{ scoreUnit(T(ctx), v.Tournament.Settings) }</th>
						<th class="py-2 text-right font-semibold">{ T(ctx).Difference() }</th>
					</tr>
				</thead>
				<tbody class="divide-y divide-white/5">
					for i, s := range v.State.Standings {
						<tr class={ templ.KV("font-bold text-amber-200", v.State.Over && i == 0) }>
							<td class="py-2 tabular-nums text-white/50">{ strconv.Itoa(i + 1) }</td>
							<td class="py-2">{ tournamentPlayerName(ctx, v, s.PlayerID) }</td>
							<td class="py-2 text-right tabular-nums">{ strconv.Itoa(s.Played) }</td>
							<td class="py-2 text-right tabular-nums">{ strconv.Itoa(s.Won) }</td>
							<td class="py-2 text-right tabular-nums">{ strconv.Itoa(s.For) }:{ strconv.Itoa(s.Against) }</td>
							<td class="py-2 text-right tabular-nums">{ signed(s.For - s.Against) }</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
		<p class={ hintClass }>{ T(ctx).TieBreakHint(scoreUnit(T(ctx), v.Tournament.Settings)) }</p>
	}
}

// roundRobinMatches lists the matches of a round-robin tournament by round.
templ roundRobinMatches(v service.TournamentView) {
	@panel("") {
		@sectionTitle(T(ctx).Games())
		<div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
			for r := 1; r <= v.State.Rounds; r++ {
				<div class="flex flex-col gap-2">
					<div class={ labelClass }>{ T(ctx).RoundN(r) }</div>
					for _, m := range v.State.Matches {
						if m.Round == r {
							@matchCard(v, m)
						}
					}
				</div>
			}
		</div>
	}
}

// tournamentStats shows each player's statistics over the finished games of the tournament.
templ tournamentStats(v service.TournamentView) {
	@panel("") {
		@sectionTitle(T(ctx).Statistics())
		<div class="overflow-x-auto">
			<table class="w-full text-left">
				<thead class="text-xs uppercase tracking-widest text-white/50">
					<tr>
						<th class="py-2 font-semibold">{ T(ctx).Player() }</th>
						<th class="py-2 text-right font-semibold">{ T(ctx).Games() }</th>
						<th class="py-2 text-right font-semibold">{ T(ctx).Wins() }</th>
						<th class="py-2 text-right font-semibold">{ T(ctx).Legs() }</th>
						if v.Tournament.Settings.Sets > 1 {
							<th class="py-2 text-right font-semibold">{ T(ctx).Sets() }</th>
						}
						if v.Tournament.Settings.Mode == game.ModeX01 {
							<th class="py-2 text-right font-semibold">{ T(ctx).Average3() }</th>
							<th class="py-2 text-right font-semibold">{ T(ctx).Highest() }</th>
							<th class="py-2 text-right font-semibold">180</th>
							<th class="py-2 text-right font-semibold">{ T(ctx).Finish() }</th>
						} else {
							<th class="py-2 text-right font-semibold">{ T(ctx).Hits() }</th>
						}
						<th class="py-2 text-right font-semibold">{ T(ctx).BestLeg() }</th>
					</tr>
				</thead>
				<tbody class="divide-y divide-white/5">
					for _, s := range v.Stats {
						@tournamentStatsRow(v, s)
					}
				</tbody>
			</table>
		</div>
		<p class={ hintClass }>{ T(ctx).TournamentStatsHint() }</p>
	}
}

templ tournamentStatsRow(v service.TournamentView, s stats.Summary) {
	<tr>
		<td class="py-2">{ displayName(ctx, s.Player) }</td>
		if v.Tournament.Settings.Mode == game.ModeX01 {
			<td class="py-2 text-right tabular-nums">{ strconv.Itoa(s.X01.Games) }</td>
			<td class="py-2 text-right tabular-nums">{ strconv.Itoa(s.X01.Wins) }</td>
			<td class="py-2 text-right tabular-nums">{ strconv.Itoa(s.X01.Legs) }</td>
			if v.Tournament.Settings.Sets > 1 {
				<td class="py-2 text-right tabular-nums">{ strconv.Itoa(s.X01.Sets) }</td>
			}
			<td class="py-2 text-right tabular-nums">{ orDash(s.X01.Darts > 0, T(ctx).Decimal(s.X01.Average)) }</td>
			<td class="py-2 text-right tabular-nums">{ orDash(s.X01.Darts > 0, strconv.FormatUint(s.X01.HighestTurn, 10)) }</td>
			<td class="py-2 text-right tabular-nums">{ strconv.Itoa(s.X01.Turns180) }</td>
			<td class="py-2 text-right tabular-nums">{ orDash(s.X01.HighestCheckout > 0, strconv.FormatUint(s.X01.HighestCheckout, 10)) }</td>
			<td class="py-2 text-right tabular-nums">{ orDash(s.X01.BestLeg > 0, strconv.Itoa(s.X01.BestLeg)) }</td>
		} else {
			<td class="py-2 text-right tabular-nums">{ strconv.Itoa(s.AroundTheClock.Games) }</td>
			<td class="py-2 text-right tabular-nums">{ strconv.Itoa(s.AroundTheClock.Wins) }</td>
			<td class="py-2 text-right tabular-nums">{ strconv.Itoa(s.AroundTheClock.Legs) }</td>
			if v.Tournament.Settings.Sets > 1 {
				<td class="py-2 text-right tabular-nums">{ strconv.Itoa(s.AroundTheClock.Sets) }</td>
			}
			<td class="py-2 text-right tabular-nums">{ orDash(s.AroundTheClock.Darts > 0, T(ctx).Percent(s.AroundTheClock.HitRate)) }</td>
			<td class="py-2 text-right tabular-nums">{ orDash(s.AroundTheClock.BestLeg > 0, strconv.Itoa(s.AroundTheClock.BestLeg)) }</td>
		}
	</tr>
}

// tournamentList lists tournaments, e.g. the recent ones on the start page.
templ tournamentList(views []service.TournamentView) {
	<ul class="-mx-2 flex flex-col gap-1">
		for _, v := range views {
			<li>
				<a href={ templ.URL(tournamentURL(v.Tournament.ID, "")) } class="block rounded-2xl px-3 py-2.5 transition hover:bg-white/5">
					<div class="flex items-center justify-between gap-2">
						<span class="font-display text-xl font-semibold uppercase">🏆 { formatName(T(ctx), v.Tournament.Format) }</span>
						@tournamentBadge(v)
					</div>
					<div class="text-sm text-white/50">{ modeLabel(T(ctx), v.Tournament.Settings) } · { T(ctx).PlayerCount(len(v.Players)) }</div>
				</a>
			</li>
		}
	</ul>
}
