package view

import (
	"strconv"

	"github.com/sj14/darts-o-mat/pkg/domain/stats"
)

templ Stats(user string, summaries []stats.Summary) {
	@layout("Statistik", user) {
		@pageTitle("Statistik", "Über alle beendeten Spiele und Turniere von dir und deinen Gastspielern.")
		<div class="flex flex-col gap-6">
			for i, s := range summaries {
				@panel("") {
					<h2 class="mb-4 font-display text-3xl font-extrabold uppercase tracking-wide text-board-cream">
						{ s.Player.Name }
						if i > 0 {
							<span class="font-sans text-base font-normal normal-case text-white/40">(Gast)</span>
						}
					</h2>
					if s.X01.Games == 0 && s.AroundTheClock.Games == 0 {
						<p class="text-white/50">Noch keine beendeten Spiele.</p>
					}
					<div class="grid gap-6 md:grid-cols-2">
						if s.X01.Games > 0 {
							<div>
								<h3 class={ labelClass }>X01</h3>
								<div class="mb-3 grid grid-cols-3 gap-2">
									@statTile(decimal(s.X01.Average), "Ø 3 Darts")
									@statTile(strconv.FormatUint(s.X01.HighestTurn, 10), "Höchste")
									@statTile(strconv.Itoa(s.X01.Turns180), "180er")
								</div>
								<dl class="divide-y divide-white/5 text-sm">
									@statRow("Spiele / Siege / Legs", strconv.Itoa(s.X01.Games)+" / "+strconv.Itoa(s.X01.Wins)+" / "+strconv.Itoa(s.X01.Legs))
									if s.X01.Sets > 0 {
										@statRow("Sets gewonnen", strconv.Itoa(s.X01.Sets))
									}
									if s.X01.Tournaments > 0 {
										@statRow("Turniere / gewonnen", strconv.Itoa(s.X01.Tournaments)+" / "+strconv.Itoa(s.X01.TournamentWins))
									}
									@statRow("Darts", strconv.Itoa(s.X01.Darts))
									@statRow("100+ / 140+", strconv.Itoa(s.X01.Turns100)+" / "+strconv.Itoa(s.X01.Turns140))
									@statRow("Höchstes Finish", orDash(s.X01.HighestCheckout > 0, strconv.FormatUint(s.X01.HighestCheckout, 10)))
									@statRow("Bestes Leg", orDash(s.X01.BestLeg > 0, strconv.Itoa(s.X01.BestLeg)+" Darts"))
								</dl>
							</div>
						}
						if s.AroundTheClock.Games > 0 {
							<div>
								<h3 class={ labelClass }>Around the Clock</h3>
								<div class="mb-3 grid grid-cols-3 gap-2">
									@statTile(percent(s.AroundTheClock.HitRate), "Treffer")
									@statTile(strconv.Itoa(s.AroundTheClock.Games), "Spiele")
									@statTile(orDash(s.AroundTheClock.BestLeg > 0, strconv.Itoa(s.AroundTheClock.BestLeg)), "Bestes Leg")
								</div>
								<dl class="divide-y divide-white/5 text-sm">
									@statRow("Spiele / Siege / Legs", strconv.Itoa(s.AroundTheClock.Games)+" / "+strconv.Itoa(s.AroundTheClock.Wins)+" / "+strconv.Itoa(s.AroundTheClock.Legs))
									if s.AroundTheClock.Sets > 0 {
										@statRow("Sets gewonnen", strconv.Itoa(s.AroundTheClock.Sets))
									}
									if s.AroundTheClock.Tournaments > 0 {
										@statRow("Turniere / gewonnen", strconv.Itoa(s.AroundTheClock.Tournaments)+" / "+strconv.Itoa(s.AroundTheClock.TournamentWins))
									}
									@statRow("Darts / Treffer", strconv.Itoa(s.AroundTheClock.Darts)+" / "+strconv.Itoa(s.AroundTheClock.Hits))
									@statRow("Bestes Leg", orDash(s.AroundTheClock.BestLeg > 0, strconv.Itoa(s.AroundTheClock.BestLeg)+" Darts"))
								</dl>
							</div>
						}
					</div>
				}
			}
		</div>
	}
}

// statTile is a key figure in large.
templ statTile(value, label string) {
	<div class="rounded-2xl bg-pub-800 px-3 py-3 text-center">
		<div class="font-display text-4xl leading-none font-extrabold tabular-nums">{ value }</div>
		<div class="mt-1 text-xs uppercase tracking-widest text-white/50">{ label }</div>
	</div>
}

templ statRow(label, value string) {
	<div class="flex justify-between gap-4 py-2">
		<dt class="text-white/60">{ label }</dt>
		<dd class="font-semibold tabular-nums">{ value }</dd>
	</div>
}
