package view

import "github.com/sj14/darts-o-mat/pkg/domain/player"

templ ShowCreateX01(availablePlayers []player.Player) {
	<html>
		<body>
			<form action="/games/x01" method="post">
				<label for="hit_counter">Hit Counter:</label>
				<br/>
				<input type="number" id="hit_counter" name="hit_counter"/>
				<select name="players" id="players">
					for _, p := range availablePlayers {
						<option value={ p.ID }>{ p.Name }</option>
					}
				</select>
				<input type="submit" value="Submit"/>
			</form>
		</body>
	</html>
}

templ ShowX01(gameID uint64) {
	gameID
}
