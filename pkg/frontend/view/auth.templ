package view

type AuthModel struct {
	Username     string // prefilled after a failed attempt
	Email        string
	Name         string
	Error        string
	Registration bool // whether new accounts may register
}

// authCard is the frame of the login and register forms.
templ authCard(title string) {
	<div class="mx-auto mt-6 max-w-md">
		<div class="mb-6 text-center">
			<div class="mx-auto mb-4 size-20 rounded-full bg-[radial-gradient(circle,var(--color-board-red)_0_14%,var(--color-board-green)_15%_26%,var(--color-board-cream)_27%_48%,var(--color-board-red)_49%_56%,var(--color-board-black)_57%)] shadow-2xl shadow-board-red/30 ring-4 ring-white/10"></div>
			<h1 class="font-display text-5xl font-extrabold uppercase tracking-wide text-board-cream">{ title }</h1>
		</div>
		@panel("flex flex-col gap-4") {
			{ children... }
		}
	</div>
}

templ formField(label, id, hint string) {
	<div>
		<label for={ id } class={ labelClass }>{ label }</label>
		{ children... }
		if hint != "" {
			<p class={ hintClass }>{ hint }</p>
		}
	</div>
}

// Landing is the start page for visitors who aren't logged in.
templ Landing(registration bool) {
	@layout("", "") {
		<div class="mx-auto mt-6 max-w-4xl text-center">
			<div class="mx-auto mb-4 size-24 rounded-full bg-[radial-gradient(circle,var(--color-board-red)_0_14%,var(--color-board-green)_15%_26%,var(--color-board-cream)_27%_48%,var(--color-board-red)_49%_56%,var(--color-board-black)_57%)] shadow-2xl shadow-board-red/30 ring-4 ring-white/10"></div>
			<h1 class="font-display text-6xl font-extrabold uppercase tracking-wide text-board-cream sm:text-7xl">darts-o-mat</h1>
			<p class="mx-auto mt-4 max-w-2xl text-lg text-white/70">{ T(ctx).LandingLead() }</p>
			<div class="mt-6 flex flex-wrap justify-center gap-3">
				<a href="/login" class={ btnPrimary, "px-6 py-3 font-display text-2xl uppercase" }>{ T(ctx).Login() }</a>
				if registration {
					<a href="/register" class={ btnSecondary, "px-6 py-3 font-display text-2xl uppercase" }>{ T(ctx).Register() }</a>
				}
			</div>
			<div class="mt-10 grid gap-4 text-left sm:grid-cols-2 lg:grid-cols-4">
				for i := range 4 {
					@panel("") {
						<h2 class="font-display text-2xl font-extrabold uppercase tracking-wide text-board-cream">{ T(ctx).LandingFeatureTitle(i) }</h2>
						<p class="mt-1 text-white/65">{ T(ctx).LandingFeatureText(i) }</p>
					}
				}
			</div>
		</div>
	}
}

templ Login(m AuthModel) {
	@layout(T(ctx).Login(), "") {
		@authCard(T(ctx).Login()) {
			@errorAlert(m.Error)
			<form method="post" action="/login" class="flex flex-col gap-4">
				@formField(T(ctx).Username(), "username", "") {
					<input type="text" id="username" name="username" class={ inputClass } value={ m.Username } autocomplete="username" autocapitalize="none" required autofocus/>
				}
				@formField(T(ctx).Password(), "password", "") {
					<input type="password" id="password" name="password" class={ inputClass } autocomplete="current-password" required/>
				}
				<button type="submit" class={ btnPrimary, "py-3 font-display text-2xl uppercase" }>{ T(ctx).Login() }</button>
			</form>
			if m.Registration {
				<p class="text-center text-white/60">{ T(ctx).NoAccountYet() } <a href="/register" class={ linkClass }>{ T(ctx).Register() }</a></p>
			}
		}
	}
}

templ Register(m AuthModel) {
	@layout(T(ctx).Register(), "") {
		@authCard(T(ctx).Register()) {
			@errorAlert(m.Error)
			if m.Registration {
				<form method="post" action="/register" class="flex flex-col gap-4">
					@formField(T(ctx).Username(), "username", T(ctx).UsernameHint()) {
						<input type="text" id="username" name="username" class={ inputClass } value={ m.Username } autocomplete="username" autocapitalize="none" pattern="[A-Za-z0-9._\-]{3,32}" required autofocus/>
					}
					@formField(T(ctx).EmailOptional(), "email", T(ctx).EmailHint()) {
						<input type="email" id="email" name="email" class={ inputClass } value={ m.Email } autocomplete="email" autocapitalize="none"/>
					}
					@formField(T(ctx).DisplayName(), "name", T(ctx).DisplayNameHint()) {
						<input type="text" id="name" name="name" class={ inputClass } value={ m.Name } autocomplete="nickname"/>
					}
					@formField(T(ctx).Password(), "password", T(ctx).PasswordHint()) {
						<input type="password" id="password" name="password" class={ inputClass } autocomplete="new-password" minlength="8" required/>
					}
					<button type="submit" class={ btnPrimary, "py-3 font-display text-2xl uppercase" }>{ T(ctx).CreateAccount() }</button>
				</form>
			} else {
				<p>{ T(ctx).RegistrationClosed() }</p>
			}
			<p class="text-center text-white/60">{ T(ctx).AlreadyRegistered() } <a href="/login" class={ linkClass }>{ T(ctx).Login() }</a></p>
		}
	}
}
