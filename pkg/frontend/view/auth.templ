package view

type AuthModel struct {
	Username     string // prefilled after a failed attempt
	Name         string
	Error        string
	Registration bool // whether new accounts may register
}

templ Login(m AuthModel) {
	@layout("Anmelden", "") {
		<div class="row justify-content-center">
			<div class="md:col-6">
				<div class="card">
					<div class="card-body d-grid gap-3">
						<h1 class="fs-2xl mb-0">Anmelden</h1>
						@errorAlert(m.Error)
						<form method="post" action="/login" class="d-grid gap-3">
							<div class="form-group">
								<label for="username" class="form-label">Benutzername</label>
								<input type="text" id="username" name="username" class="form-control" value={ m.Username } autocomplete="username" autocapitalize="none" required autofocus/>
							</div>
							<div class="form-group">
								<label for="password" class="form-label">Passwort</label>
								<input type="password" id="password" name="password" class="form-control" autocomplete="current-password" required/>
							</div>
							<div>
								<button type="submit" class="btn-solid theme-primary">Anmelden</button>
							</div>
						</form>
						if m.Registration {
							<p class="mb-0">Noch kein Account? <a href="/register">Registrieren</a></p>
						}
					</div>
				</div>
			</div>
		</div>
	}
}

templ Register(m AuthModel) {
	@layout("Registrieren", "") {
		<div class="row justify-content-center">
			<div class="md:col-6">
				<div class="card">
					<div class="card-body d-grid gap-3">
						<h1 class="fs-2xl mb-0">Registrieren</h1>
						@errorAlert(m.Error)
						if m.Registration {
							<form method="post" action="/register" class="d-grid gap-3">
								<div class="form-group">
									<label for="username" class="form-label">Benutzername</label>
									<input type="text" id="username" name="username" class="form-control" value={ m.Username } autocomplete="username" autocapitalize="none" pattern="[A-Za-z0-9._\-]{3,32}" required autofocus/>
									<div class="form-text">3 bis 32 Zeichen: Buchstaben, Ziffern, Punkt, Bindestrich oder Unterstrich. Damit laden dich andere zu Spielen ein.</div>
								</div>
								<div class="form-group">
									<label for="name" class="form-label">Anzeigename</label>
									<input type="text" id="name" name="name" class="form-control" value={ m.Name } autocomplete="nickname"/>
									<div class="form-text">So heißt du im Spiel. Leer lassen, um den Benutzernamen zu verwenden.</div>
								</div>
								<div class="form-group">
									<label for="password" class="form-label">Passwort</label>
									<input type="password" id="password" name="password" class="form-control" autocomplete="new-password" minlength="8" required/>
									<div class="form-text">Mindestens 8 Zeichen.</div>
								</div>
								<div>
									<button type="submit" class="btn-solid theme-primary">Account anlegen</button>
								</div>
							</form>
						} else {
							<p class="mb-0">Die Registrierung ist auf diesem Server abgeschaltet.</p>
						}
						<p class="mb-0">Schon registriert? <a href="/login">Anmelden</a></p>
					</div>
				</div>
			</div>
		</div>
	}
}
