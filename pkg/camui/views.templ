package camui

import (
	"image"
	"math"
	"strconv"

	"github.com/sj14/darts-o-mat/pkg/domain/dartboard"
	"github.com/sj14/darts-o-mat/pkg/vision"
)

type OverviewModel struct {
	Path        string // of the calibration file
	DeviceName  string // of the chosen cameras
	DeviceModel string
	Cameras     []CameraModel
	Events      []EventModel // newest first
}

type EventModel struct {
	ID      int
	Time    string
	Takeout bool
	Label   string          // the scored dart
	Board   dartboard.Point // fused position in mm
	Cameras []CameraPoint   // the cameras that found the dart
	// AllCameras lists every camera, for the images.
	AllCameras []CameraPoint
}

type CameraPoint struct {
	Index int
	Name  string
	Board dartboard.Point
	Label string
}

type CheckModel struct {
	Index                      int
	Name                       string
	Error                      string
	Matches                    int
	RMS                        float64
	Good, Fair, Poor, Outliers int
	Found, Searched            int  // features found in the image and searched for
	Wrong                      bool // too few features found: the grid doesn't fit
}

type DevicesModel struct {
	Groups  []vision.DeviceGroup
	Current string // the chosen device name
	Open    int    // cameras opened at the start
	Saved   bool
	Error   string
}

type CameraModel struct {
	Index      int
	Name       string
	Device     string
	Calibrated bool
}

type CalibrateModel struct {
	Index     int
	Name      string
	Points    int // clicked so far
	MinPoints int
	Target    *[2]uint8 // the next point to click, nil when all were offered
	Bounds    image.Rectangle
	Error     string
}

func camURL(i int, suffix string) string {
	return "/cam/" + strconv.Itoa(i) + suffix
}

templ layout(title string) {
	<!DOCTYPE html>
	<html lang="de" class="dark">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title } · darts-o-cam</title>
			<link rel="icon" href="/static/favicon.svg" type="image/svg+xml"/>
			<link rel="stylesheet" href="/static/tailwind.css"/>
		</head>
		<body class="min-h-screen text-white antialiased">
			<header class="border-b border-white/10 bg-pub-950/80">
				<div class="mx-auto max-w-6xl px-4 py-3">
					<a href="/" class="font-display text-2xl font-extrabold uppercase tracking-wide">📷 darts<span class="text-board-red">-o-</span>cam <span class="text-white/40">· Kalibrierung</span></a>
				</div>
			</header>
			<main class="mx-auto max-w-6xl px-4 py-6 pb-16">
				{ children... }
			</main>
		</body>
	</html>
}

templ title(text string) {
	<h1 class="mb-3 font-display text-4xl font-extrabold uppercase tracking-wide text-board-cream sm:text-5xl">{ text }</h1>
}

templ sectionTitle(text string) {
	<h2 class="mt-8 mb-3 font-display text-2xl font-extrabold uppercase tracking-wide text-board-cream">{ text }</h2>
}

templ errorAlert(msg string) {
	if msg != "" {
		<div class="mb-4 rounded-2xl border border-board-red/50 bg-board-red/15 px-4 py-3 text-red-200" role="alert">{ msg }</div>
	}
}

templ badge(text, colors string) {
	<span class={ "rounded-full px-2.5 py-0.5 text-xs font-semibold uppercase tracking-wider", colors }>{ text }</span>
}

templ backLink() {
	<p class="mt-6"><a href="/" class={ linkClass }>← Zurück</a></p>
}

templ Overview(m OverviewModel) {
	@layout("Kameras") {
		@title("Kameras")
		<p class="mb-4 max-w-3xl text-white/60">
			Die Kalibrierung wird auf diesem Rechner gespeichert ({ m.Path }) und funktioniert mit jedem darts-o-mat-Server.
			Kalibriere jede Kamera einmal mit <strong class="text-white">leerem Board</strong>; danach liegt auf ihrem Bild das Raster des Boards.
		</p>
		<div class="mb-6 flex flex-wrap items-center gap-3">
			if m.DeviceName != "" {
				<span class="rounded-full bg-white/10 px-3 py-1">
					Kameras: <strong>{ m.DeviceName }</strong>
					if m.DeviceModel != "" {
						<span class="text-sm text-white/50">({ m.DeviceModel })</span>
					}
				</span>
			}
			<a href="/devices" class={ btnSecondary, btnSmall }>Kameras wählen</a>
			<a href="/" class={ btnSecondary, btnSmall }>Bilder aktualisieren</a>
		</div>
		if len(m.Cameras) == 0 {
			<div class="mb-4 rounded-2xl border border-amber-400/50 bg-amber-400/10 px-4 py-3 text-amber-200" role="status">
				Keine Kameras geöffnet. Wähle unter <a href="/devices" class={ linkClass }>Kameras wählen</a>, welche Kameras zum Board gehören, und starte darts-o-cam neu.
			</div>
		}
		<div class="grid gap-6 md:grid-cols-2">
			for _, c := range m.Cameras {
				<div class="overflow-hidden rounded-3xl border border-white/10 bg-pub-900/80 shadow-xl shadow-black/30">
					<img src={ camURL(c.Index, "/frame.jpg") } class="w-full" alt={ "Bild von " + c.Name }/>
					<div class="flex flex-col gap-3 p-4">
						<div class="flex items-center justify-between gap-2">
							<span>
								<span class="font-display text-2xl font-semibold uppercase">{ c.Name }</span>
								<span class="text-sm text-white/40">(Gerät { c.Device })</span>
							</span>
							if c.Calibrated {
								@badge("kalibriert", "bg-board-green/25 text-emerald-300")
							} else {
								@badge("nicht kalibriert", "bg-amber-400/20 text-amber-300")
							}
						</div>
						<div class="flex flex-wrap gap-2">
							<form method="post" action={ templ.URL(camURL(c.Index, "/start")) }>
								<button type="submit" class={ btnPrimary }>
									if c.Calibrated {
										Neu kalibrieren
									} else {
										Kalibrieren
									}
								</button>
							</form>
							if c.Calibrated {
								<a href={ templ.URL(camURL(c.Index, "/check")) } class={ btnSecondary }>Raster prüfen</a>
								<form method="post" action={ templ.URL(camURL(c.Index, "/refine")) }>
									<button type="submit" class={ btnSecondary }>Nur feinkalibrieren</button>
								</form>
							}
						</div>
					</div>
				</div>
			}
		</div>
		@sectionTitle("Letzte Erkennungen")
		if len(m.Events) == 0 {
			<p class="text-white/50">Noch keine. Sie erscheinen hier, sobald <code>darts-o-cam detect</code> Würfe erkennt.</p>
		} else {
			<ul class="flex flex-col gap-1">
				for _, e := range m.Events {
					<li>
						<a href={ templ.URL("/event/" + strconv.Itoa(e.ID)) } class="flex items-center justify-between rounded-2xl px-3 py-2 transition hover:bg-white/5">
							<span class="tabular-nums text-white/50">{ e.Time }</span>
							if e.Takeout {
								<span class="text-white/50">Pfeile herausgezogen</span>
							} else {
								<span><span class="font-display text-2xl font-extrabold">{ e.Label }</span> <span class="text-sm text-white/40">({ strconv.Itoa(len(e.Cameras)) } Kameras)</span></span>
							}
						</a>
					</li>
				}
			</ul>
		}
	}
}

templ Calibrate(m CalibrateModel) {
	@layout("Kalibrieren: " + m.Name) {
		@title(m.Name + " kalibrieren")
		@errorAlert(m.Error)
		<div class="mb-4 rounded-2xl border border-sky-400/50 bg-sky-400/10 px-4 py-3">
			if m.Target != nil {
				<div class="font-semibold">
					Klicke auf die Stelle, an der der Draht zwischen
					<span class="rounded-md bg-board-cream px-2 font-display text-xl font-extrabold text-pub-950">{ strconv.Itoa(int(m.Target[0])) }</span> und
					<span class="rounded-md bg-board-cream px-2 font-display text-xl font-extrabold text-pub-950">{ strconv.Itoa(int(m.Target[1])) }</span>
					die Außenkante des Doppelrings kreuzt.
				</div>
				<div class="text-sm text-white/60">Ungefähr reicht, die Feinkalibrierung gleicht das aus. Ist die Stelle verdeckt oder nicht im Bild, überspringe sie.</div>
			} else {
				<div class="font-semibold">Alle Punkte durch.</div>
			}
			<div class="mt-1 text-sm text-white/60">{ strconv.Itoa(m.Points) } Punkte gesetzt, mindestens { strconv.Itoa(m.MinPoints) } nötig.</div>
		</div>
		<div class="mb-4 flex flex-wrap gap-2">
			if m.Target != nil {
				<form method="post" action={ templ.URL(camURL(m.Index, "/skip")) }>
					<button type="submit" class={ btnSecondary }>Überspringen</button>
				</form>
			}
			<form method="post" action={ templ.URL(camURL(m.Index, "/finish")) }>
				<button type="submit" class={ btnPrimary } disabled?={ m.Points < m.MinPoints }>Fertig: feinkalibrieren und speichern</button>
			</form>
			<form method="post" action={ templ.URL(camURL(m.Index, "/start")) }>
				<button type="submit" class={ btnDanger }>Von vorn (neues Bild)</button>
			</form>
		</div>
		// Shown in full size, so the click position the image input sends is in image pixels.
		<form method="post" action={ templ.URL(camURL(m.Index, "/point")) } class="overflow-auto rounded-2xl border border-white/10">
			<input
				type="image"
				name="click"
				src={ camURL(m.Index, "/clicked.jpg?n="+strconv.Itoa(m.Points)) }
				width={ strconv.Itoa(m.Bounds.Dx()) }
				height={ strconv.Itoa(m.Bounds.Dy()) }
				class="max-w-none cursor-crosshair"
				alt="Kamerabild, hier klicken"
			/>
		</form>
	}
}

templ Check(m CheckModel) {
	@layout("Raster prüfen: " + m.Name) {
		@title("Raster von " + m.Name + " prüfen")
		if m.Error != "" {
			@errorAlert(m.Error)
		} else {
			if m.Wrong {
				<div class="mb-4 max-w-3xl rounded-2xl border border-board-red/50 bg-board-red/15 px-4 py-3 text-red-200" role="alert">
					<p class="mb-3">
						<strong>Das Raster passt nicht zum Board:</strong> nur { strconv.Itoa(m.Found) } von { strconv.Itoa(m.Searched) } Kanten und Drähten liegen dort, wo das Raster sie erwartet.
						Meist wurde beim Kalibrieren ein Draht verwechselt, z. B. 1/18 statt 20/1.
						Prüfe die Zahlen genau (sie stehen je nach Kamera auf dem Kopf) und kalibriere neu. Gegenprobe über die Farben: das Doppel der 20 ist rot, das der 1 grün.
					</p>
					<form method="post" action={ templ.URL(camURL(m.Index, "/start")) }>
						<button type="submit" class={ btnPrimary }>Neu kalibrieren</button>
					</form>
				</div>
			}
			<p class="mb-4 max-w-3xl text-white/70">
				Auf dem aktuellen Bild gesucht: Kanten der farbigen Ringe und die Drähte zwischen den Zahlen.
				Blau ist das Raster, wie die Kalibrierung das Board sieht; die Punkte sind die gefundenen Kanten und Drähte.
				Liegen die blauen Linien auf den echten Drähten und sind fast alle Punkte grün, stimmt die Kalibrierung.
			</p>
			<div class="mb-4 flex flex-wrap items-center gap-3">
				<span>@badge(strconv.Itoa(m.Good), "bg-board-green/25 text-emerald-300") ≤ 1 px</span>
				<span>@badge(strconv.Itoa(m.Fair), "bg-amber-400/20 text-amber-300") ≤ 2 px</span>
				<span>@badge(strconv.Itoa(m.Poor), "bg-board-red/25 text-red-300") weiter daneben</span>
				<span>@badge(strconv.Itoa(m.Outliers), "bg-board-red/25 text-red-300") verworfen (z. B. Pfeil davor)</span>
				<span class="text-white/50">mittlere Abweichung { strconv.FormatFloat(m.RMS, 'f', 2, 64) } px</span>
			</div>
			<p class="mb-4 text-sm text-white/50">Das ist nur eine Prüfung, gespeichert wird nichts. Stecken Pfeile im Board, erscheinen an ihnen verworfene Punkte; das ist in Ordnung.</p>
			<div class="overflow-auto rounded-2xl border border-white/10">
				<img src={ camURL(m.Index, "/features.jpg") } class="max-w-none" alt="Gefundene Kanten und Drähte"/>
			</div>
		}
		@backLink()
	}
}

templ EventPage(m EventModel) {
	@layout("Erkennung") {
		<h1 class="mb-4 font-display text-4xl font-extrabold uppercase tracking-wide text-board-cream sm:text-5xl">
			<span class="text-white/40">{ m.Time }:</span>
			if m.Takeout {
				Pfeile herausgezogen
			} else {
				{ m.Label }
			}
		</h1>
		if !m.Takeout {
			<div class="mb-6 grid items-start gap-6 md:grid-cols-[minmax(0,5fr)_minmax(0,7fr)]">
				@boardSketch(m)
				<div class="rounded-3xl border border-white/10 bg-pub-900/80 p-5">
					<table class="w-full text-sm tabular-nums">
						<thead class="text-left text-xs uppercase tracking-wider text-white/50">
							<tr><th class="py-2">Kamera</th><th class="py-2 text-right">Position (mm)</th><th class="py-2 text-right">Abstand zur Mitte</th><th class="py-2 pl-3">Feld</th></tr>
						</thead>
						<tbody class="divide-y divide-white/5">
							for _, c := range m.Cameras {
								<tr>
									<td class="py-2"><span style={ "color: " + cameraColor(c.Index) }>●</span> { c.Name }</td>
									<td class="py-2 text-right">{ mm(c.Board.X) }, { mm(c.Board.Y) }</td>
									<td class="py-2 text-right">{ mm(c.Board.Radius()) }</td>
									<td class="py-2 pl-3">{ c.Label }</td>
								</tr>
							}
							<tr class="font-bold">
								<td class="py-2">✕ Ergebnis</td>
								<td class="py-2 text-right">{ mm(m.Board.X) }, { mm(m.Board.Y) }</td>
								<td class="py-2 text-right">{ mm(m.Board.Radius()) }</td>
								<td class="py-2 pl-3 text-amber-300">{ m.Label }</td>
							</tr>
						</tbody>
					</table>
					<p class="mt-3 text-sm text-white/50">Grenzen: Triple 99–107 mm, Doppel 162–170 mm, Bull bis 15,9 mm, Bullseye bis 6,35 mm. Das Ergebnis ist der Median der Abstände zur Mitte und der Median der Winkel (nahe der Mitte: Median pro Koordinate).</p>
				</div>
			</div>
		}
		<div class="grid gap-4 md:grid-cols-3">
			for _, c := range m.AllCameras {
				<div>
					<div class="mb-1 font-semibold"><span style={ "color: " + cameraColor(c.Index) }>●</span> { c.Name }</div>
					<img src={ "/event/" + strconv.Itoa(m.ID) + "/cam/" + strconv.Itoa(c.Index) + ".jpg" } class="w-full rounded-2xl border border-white/10" alt={ "Bild von " + c.Name }/>
				</div>
			}
		</div>
		@backLink()
	}
}

// boardSketch draws the board from the front with the positions seen by each camera
// and the result, zoomed to the area around the dart.
templ boardSketch(m EventModel) {
	{{ vb := sketchViewBox(m) }}
	<svg viewBox={ vb } class="aspect-square w-full rounded-3xl border border-white/10 bg-pub-900">
		for _, r := range []float64{dartboard.DoubleOuterRadius, dartboard.DoubleInnerRadius, dartboard.TripleOuterRadius, dartboard.TripleInnerRadius, dartboard.BullRadius, dartboard.BullseyeRadius} {
			<circle cx="0" cy="0" r={ num(r) } fill="none" stroke="#888" stroke-width={ num(sketchStroke(m)) }></circle>
		}
		for i := range 20 {
			{{ a := (float64(i) + 0.5) * dartboard.SegmentAngle }}
			{{ p1, p2 := dartboard.Polar(dartboard.BullRadius, a), dartboard.Polar(dartboard.DoubleOuterRadius, a) }}
			<line x1={ num(p1.X) } y1={ num(-p1.Y) } x2={ num(p2.X) } y2={ num(-p2.Y) } stroke="#888" stroke-width={ num(sketchStroke(m)) }></line>
			{{ t := dartboard.Polar(185, float64(i)*dartboard.SegmentAngle) }}
			<text x={ num(t.X) } y={ num(-t.Y) } fill="#ccc" font-size="14" text-anchor="middle" dominant-baseline="middle">{ strconv.Itoa(int(dartboard.Segments[i])) }</text>
		}
		for _, c := range m.Cameras {
			<circle cx={ num(c.Board.X) } cy={ num(-c.Board.Y) } r={ num(sketchStroke(m) * 4) } fill={ cameraColor(c.Index) }></circle>
		}
		{{ s := sketchStroke(m) * 6 }}
		<line x1={ num(m.Board.X - s) } y1={ num(-m.Board.Y - s) } x2={ num(m.Board.X + s) } y2={ num(-m.Board.Y + s) } stroke="#fff" stroke-width={ num(sketchStroke(m) * 1.5) }></line>
		<line x1={ num(m.Board.X - s) } y1={ num(-m.Board.Y + s) } x2={ num(m.Board.X + s) } y2={ num(-m.Board.Y - s) } stroke="#fff" stroke-width={ num(sketchStroke(m) * 1.5) }></line>
	</svg>
}

// sketchSize is the width of the board area shown, in mm: enough to see the dart's field.
func sketchSize(m EventModel) float64 {
	spread := 0.0
	for _, c := range m.Cameras {
		spread = max(spread, math.Hypot(c.Board.X-m.Board.X, c.Board.Y-m.Board.Y))
	}
	return max(60, 4*spread)
}

func sketchViewBox(m EventModel) string {
	size := sketchSize(m)
	return num(m.Board.X-size/2) + " " + num(-m.Board.Y-size/2) + " " + num(size) + " " + num(size)
}

func sketchStroke(m EventModel) float64 {
	return sketchSize(m) / 300
}

var cameraColors = []string{"#ff5a5a", "#4cc3ff", "#ffd23f", "#8bff6b", "#d78bff"}

func cameraColor(i int) string {
	return cameraColors[i%len(cameraColors)]
}

func num(f float64) string {
	return strconv.FormatFloat(f, 'f', 2, 64)
}

func mm(f float64) string {
	return strconv.FormatFloat(f, 'f', 1, 64)
}

templ Devices(m DevicesModel) {
	@layout("Kameras wählen") {
		@title("Kameras wählen")
		<p class="mb-4 max-w-3xl text-white/60">
			Wähle, welche Kameras zum Board gehören. Gespeichert wird ihr Name (mit Modell zur Erkennung), nicht der USB-Anschluss:
			nach dem Umstecken an andere Ports werden dieselben Kameras wieder gefunden. Welche Kamera welche ist, erkennt darts-o-cam an ihrem Bild vom Board.
		</p>
		@errorAlert(m.Error)
		if m.Saved {
			<div class="mb-4 rounded-2xl border border-board-green/50 bg-board-green/15 px-4 py-3 text-emerald-200" role="status">Gespeichert. Starte darts-o-cam neu, damit die Kameras geöffnet werden.</div>
		}
		<form method="post" action="/devices" class="flex max-w-2xl flex-col gap-4">
			<div class="flex flex-col gap-2">
				for _, g := range m.Groups {
					<label class="cursor-pointer">
						<input type="radio" class="peer sr-only" name="name" value={ g.Name } checked?={ g.Name == m.Current }/>
						<span class="flex items-center justify-between gap-3 rounded-2xl border border-white/10 bg-pub-800 px-4 py-3 transition hover:border-white/30 peer-checked:border-board-green peer-checked:bg-board-green/15 peer-focus-visible:ring-2 peer-focus-visible:ring-amber-400">
							<span class="font-display text-2xl font-semibold uppercase">{ g.Name }</span>
							<span class="text-sm text-white/50">
								{ strconv.Itoa(g.Count) } ×
								if g.Model != "" {
									· Modell { g.Model }
								}
							</span>
						</span>
					</label>
				}
			</div>
			<div class="flex items-center gap-3">
				<button type="submit" class={ btnPrimary }>Speichern</button>
				<a href="/" class={ linkClass }>Zurück</a>
			</div>
		</form>
		<p class="mt-4 text-sm text-white/50">Gerade geöffnet: { strconv.Itoa(m.Open) } Kameras.</p>
	}
}
