package camui

import (
	"errors"
	"image"
	"math"
	"net/url"
	"strconv"

	"github.com/sj14/darts-o-mat/pkg/camapp"
	"github.com/sj14/darts-o-mat/pkg/domain/dartboard"
	"github.com/sj14/darts-o-mat/pkg/vision"
)

type OverviewModel struct {
	Dir      string // of the configuration
	Status   camapp.Status
	Settings camapp.Settings
	Cameras  []CameraModel
	Events   []EventModel // newest first
}

type EventModel struct {
	ID      int
	Time    string
	Takeout bool
	Label   string          // the scored dart
	Board   dartboard.Point // fused position in mm
	Cameras []CameraPoint   // the cameras that found the dart
	// AllCameras lists every camera, for the images.
	AllCameras []CameraPoint
	// Game is the game the server entered it in, ReportErr why it didn't.
	Game      int64
	ReportErr string
}

type CameraPoint struct {
	Index int
	Name  string
	Board dartboard.Point
	Label string
	// Radial and Tangential are the camera's resolution at the dart (px/mm), Hidden
	// that it may not see the tip (see vision.Tip).
	Radial, Tangential float64
	Hidden             bool
}

type CheckModel struct {
	Name                       string
	Error                      string
	Matches                    int
	RMS                        float64
	Good, Fair, Poor, Outliers int
	Found, Searched            int  // features found in the image and searched for
	Wrong                      bool // too few features found: the grid doesn't fit
}

type DevicesModel struct {
	Devices []camapp.Device
	Error   string
}

type SettingsModel struct {
	Settings camapp.Settings
	Saved    bool
	Error    string
}

type CameraModel struct {
	Name        string
	DeviceName  string
	DeviceModel string
	Device      string // ID of the device in use
	Open        bool
	Calibrated  bool
	OtherSize   string // the frame size it was calibrated on, if that's not the current one
	Problem     string
	Scale       string // pixels per board millimetre, if calibrated
	Size        string // of its frames, if it is open
}

type CalibrateModel struct {
	Name      string
	Points    int // clicked so far
	MinPoints int
	Target    *[2]uint8 // the next point to click, nil when all were offered
	Bounds    image.Rectangle
	Error     string
}

// eventFrameURL is the download of a camera's whole frame before or after an event.
func eventFrameURL(id, camera int, kind string) string {
	return "/event/" + strconv.Itoa(id) + "/cam/" + strconv.Itoa(camera) + "/" + kind + ".jpg"
}

func camURL(name, suffix string) string {
	return "/cam/" + name + suffix
}

func snapshotURL(id string) string {
	return "/devices/snapshot.jpg?id=" + url.QueryEscape(id)
}

func sizeValue(w, h int) string {
	return strconv.Itoa(w) + "x" + strconv.Itoa(h)
}

// numberField is an input of the detection's thresholds in the settings.
type numberField struct {
	Name, Label, Unit, Hint, Value, Step string
}

func dec(f float64) string {
	return strconv.FormatFloat(f, 'f', 2, 64)
}

// detectionFields are the detection's thresholds, as fields of the settings form.
func detectionFields(o vision.WatchOptions) []numberField {
	d := o.Detect
	return []numberField{
		{"diff_threshold", "Farbunterschied", "0–255", "Ab diesem Unterschied gilt ein Bildpunkt als verändert.", strconv.Itoa(int(d.DiffThreshold)), "1"},
		{"weak_threshold", "Schwacher Farbunterschied", "0–255", "Zählt nur neben stark veränderten Punkten; hält die dünne Spitze am Pfeil.", strconv.Itoa(int(d.WeakThreshold)), "1"},
		{"blur", "Weichzeichner", "mm", "Radius gegen Bildrauschen.", dec(d.Blur), "0.01"},
		{"min_area", "Mindestgröße Pfeil", "mm²", "Kleinere Änderungen sind kein Pfeil.", dec(d.MinArea), "0.01"},
		{"min_speck", "Kleinster Fleck", "mm²", "Kleinere Flecken werden als Rauschen ignoriert.", dec(d.MinSpeck), "0.01"},
		{"min_elongation", "Mindest-Streckung", "Länge : Breite", "So länglich muss der untere Teil des Pfeils sein.", dec(d.MinElongation), "0.1"},
		{"gap", "Lücken überbrücken", "mm", "Stücke mit Lücken bis zum Doppelten zählen zusammen (gestrichelter Barrel vor schwarzen Feldern).", dec(d.Gap), "0.01"},
		{"axis_distance", "Abstand zur Achse", "mm", "Stücke so nah an der Pfeilachse gehören zum Pfeil (z. B. die Flight).", dec(d.AxisDistance), "0.01"},
		{"tip_shift", "Spitze zurücksetzen", "mm", "So weit wird die gefundene Spitze entlang des Pfeils zurückgesetzt: die Änderung im Bild reicht meist etwas über die echte Spitze hinaus (Schatten).", dec(d.TipShift), "0.01"},
		{"sample_step", "Bewegung: Abstand der Stichproben", "mm", "Für die Bewegungserkennung wird nur jeder so weit entfernte Bildpunkt verglichen.", dec(o.SampleStep), "0.01"},
		{"motion_threshold", "Bewegung: Farbunterschied", "0–255", "Ab diesem Unterschied gilt eine Stichprobe als bewegt.", strconv.Itoa(int(o.MotionThreshold)), "1"},
		{"motion_area", "Bewegung ab", "mm²", "So viel muss sich ändern, damit das Board als bewegt gilt.", dec(o.MotionArea), "0.01"},
		{"stable_frames", "Ruhige Bilder", "Bilder", "So viele Bilder ohne Bewegung, bevor ausgewertet wird.", strconv.Itoa(o.StableFrames), "1"},
		{"takeout_area", "Herausziehen ab", "mm²", "Ändert sich mehr, war es eine Hand bzw. herausgezogene Pfeile.", dec(o.TakeoutArea), "0.01"},
	}
}

// statusText says what the detection is doing.
func statusText(s camapp.Status) string {
	switch {
	case s.Running && s.Cameras == 1:
		return "Erkennung läuft mit 1 Kamera."
	case s.Running:
		return "Erkennung läuft mit " + strconv.Itoa(s.Cameras) + " Kameras."
	case errors.Is(s.Err, camapp.ErrNoCalibratedCamera):
		return "Erkennung wartet auf eine kalibrierte Kamera."
	case s.Err != nil:
		return "Erkennung angehalten: " + s.Err.Error()
	}
	return "Erkennung ist ausgeschaltet."
}

templ layout(title string) {
	<!DOCTYPE html>
	<html lang="de" class="dark">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title } · darts-o-cam</title>
			<link rel="icon" href="/static/favicon.svg" type="image/svg+xml"/>
			<link rel="stylesheet" href="/static/tailwind.css"/>
			<script src="/static/htmx.min.js"></script>
			<script src="/static/htmx-ext-sse.min.js"></script>
		</head>
		<body class="min-h-screen text-white antialiased">
			<header class="border-b border-white/10 bg-pub-950/80">
				<div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-3 px-4 py-3">
					<a href="/" class="font-display text-2xl font-extrabold uppercase tracking-wide">📷 darts<span class="text-board-red">-o-</span>cam</a>
					<nav class="flex flex-wrap items-center gap-1 text-sm font-semibold">
						<a href="/" class="rounded-lg px-3 py-1.5 text-white/70 hover:bg-white/10 hover:text-white">Kameras</a>
						<a href="/devices" class="rounded-lg px-3 py-1.5 text-white/70 hover:bg-white/10 hover:text-white">Kamera hinzufügen</a>
						<a href="/settings" class="rounded-lg px-3 py-1.5 text-white/70 hover:bg-white/10 hover:text-white">Einstellungen</a>
					</nav>
				</div>
			</header>
			<main class="mx-auto max-w-6xl px-4 py-6 pb-16">
				{ children... }
			</main>
		</body>
	</html>
}

templ title(text string) {
	<h1 class="mb-3 font-display text-4xl font-extrabold uppercase tracking-wide text-board-cream sm:text-5xl">{ text }</h1>
}

templ sectionTitle(text string) {
	<h2 class="mt-8 mb-3 font-display text-2xl font-extrabold uppercase tracking-wide text-board-cream">{ text }</h2>
}

templ errorAlert(msg string) {
	if msg != "" {
		<div class="mb-4 rounded-2xl border border-board-red/50 bg-board-red/15 px-4 py-3 text-red-200" role="alert">{ msg }</div>
	}
}

templ badge(text, colors string) {
	<span class={ "rounded-full px-2.5 py-0.5 text-xs font-semibold uppercase tracking-wider", colors }>{ text }</span>
}

templ backLink() {
	<p class="mt-6"><a href="/" class={ linkClass }>← Zurück</a></p>
}

templ notice(text, colors string) {
	<div class={ "mb-4 rounded-2xl border px-4 py-3", colors } role="status">{ text }</div>
}

templ Overview(m OverviewModel) {
	@layout("Kameras") {
		@title("Kameras")
		<div class="mb-6 flex max-w-3xl flex-col gap-3 rounded-3xl border border-white/10 bg-pub-900/80 p-4">
			<div class="flex flex-wrap items-center justify-between gap-3">
				<span class={ templ.KV("text-emerald-300", m.Status.Running), templ.KV("text-amber-300", !m.Status.Running) }>{ statusText(m.Status) }</span>
				<form method="post" action="/detect">
					if m.Status.Running || m.Status.Err != nil {
						<input type="hidden" name="on" value="false"/>
						<button type="submit" class={ btnSecondary, btnSmall }>Erkennung ausschalten</button>
					} else {
						<input type="hidden" name="on" value="true"/>
						<button type="submit" class={ btnPrimary, btnSmall }>Erkennung einschalten</button>
					}
				</form>
			</div>
			if m.Status.Reporting {
				<span class="text-white/70">Würfe gehen an <strong class="text-white">{ m.Settings.Server }</strong>.</span>
			} else {
				<span class="text-white/70">Mit keinem Server verbunden: erkannte Würfe erscheinen nur hier. Trage unter <a href="/settings" class={ linkClass }>Einstellungen</a> den darts-o-mat-Server und den Kamera-Token des Boards ein.</span>
			}
		</div>
		if len(m.Cameras) == 0 {
			@notice("Noch keine Kameras. Füge unter „Kamera hinzufügen“ die Kameras deines Boards hinzu und kalibriere sie dann mit leerem Board.", "border-amber-400/50 bg-amber-400/10 text-amber-200")
		} else {
			<p class="mb-4 max-w-3xl text-white/60">
				Kalibriere jede Kamera einmal mit <strong class="text-white">leerem Board</strong>; danach liegt auf ihrem Bild das Raster des Boards und die Erkennung nutzt sie sofort.
				<a href="/" class={ linkClass }>Bilder aktualisieren</a>
			</p>
			<form method="post" action="/reconnect" class="mb-4 flex flex-wrap items-center gap-3">
				<button type="submit" class={ btnSecondary, btnSmall }>Kameras neu verbinden</button>
				<span class="text-sm text-white/50">Nach dem Ein- oder Ausstecken einer Kamera.</span>
			</form>
		}
		<div class="grid gap-6 md:grid-cols-2">
			for _, c := range m.Cameras {
				<div class="overflow-hidden rounded-3xl border border-white/10 bg-pub-900/80 shadow-xl shadow-black/30">
					if c.Open {
						<img src={ camURL(c.Name, "/frame.jpg") } class="w-full" alt={ "Bild von " + c.Name }/>
					}
					<div class="flex flex-col gap-3 p-4">
						<div class="flex items-center justify-between gap-2">
							<span>
								<span class="font-display text-2xl font-semibold uppercase">{ c.Name }</span>
								<span class="text-sm text-white/40">
									{ c.DeviceName }
									if c.DeviceModel != "" {
										({ c.DeviceModel })
									}
									if c.Size != "" {
										· { c.Size }
									}
								</span>
							</span>
							if c.Calibrated {
								<span class="flex items-center gap-2">
									<span class="text-sm text-white/40" title="Bildpunkte pro Millimeter auf dem Board">{ c.Scale } px/mm</span>
									@badge("kalibriert", "bg-board-green/25 text-emerald-300")
								</span>
							} else {
								@badge("nicht kalibriert", "bg-amber-400/20 text-amber-300")
							}
						</div>
						if c.Problem != "" {
							<p class="text-sm text-red-300">{ c.Problem }</p>
						}
						if c.OtherSize != "" {
							<p class="text-sm text-amber-300">Kalibriert für { c.OtherSize }, die Kamera liefert gerade eine andere Größe: bitte neu kalibrieren.</p>
						}
						<div class="flex flex-wrap gap-2">
							if c.Open {
								<form method="post" action={ templ.URL(camURL(c.Name, "/start")) }>
									<button type="submit" class={ btnPrimary }>
										if c.Calibrated {
											Neu kalibrieren
										} else {
											Kalibrieren
										}
									</button>
								</form>
								if c.Calibrated {
									<a href={ templ.URL(camURL(c.Name, "/check")) } class={ btnSecondary }>Raster prüfen</a>
									<form method="post" action={ templ.URL(camURL(c.Name, "/refine")) }>
										<button type="submit" class={ btnSecondary }>Nur feinkalibrieren</button>
									</form>
								}
							}
							<a href={ templ.URL(camURL(c.Name, "/remove")) } class={ btnDanger }>Entfernen</a>
						</div>
					</div>
				</div>
			}
		</div>
		@sectionTitle("Letzte Erkennungen")
		// The list swaps itself whenever darts-o-cam detects something (Server-Sent Events).
		<div hx-ext="sse" sse-connect="/events/stream" sse-swap="events">
			@eventList(m.Events)
		</div>
		<p class="mt-8 text-sm text-white/40">Kalibrierung und Einstellungen liegen auf diesem Rechner in { m.Dir } und funktionieren mit jedem darts-o-mat-Server.</p>
	}
}

// eventList is the list of the latest detections, newest first.
templ eventList(events []EventModel) {
	if len(events) == 0 {
		<p class="text-white/50">Noch keine. Sie erscheinen hier, sobald die Erkennung Würfe sieht.</p>
	} else {
		<ul class="flex flex-col gap-1">
			for _, e := range events {
				<li>
					<a href={ templ.URL("/event/" + strconv.Itoa(e.ID)) } class="flex flex-wrap items-center justify-between gap-2 rounded-2xl px-3 py-2 transition hover:bg-white/5">
						<span class="tabular-nums text-white/50">{ e.Time }</span>
						if e.Takeout {
							<span class="text-white/50">Pfeile herausgezogen</span>
						} else {
							<span><span class="font-display text-2xl font-extrabold">{ e.Label }</span> <span class="text-sm text-white/40">({ strconv.Itoa(len(e.Cameras)) } Kameras)</span></span>
						}
						@reportResult(e)
					</a>
				</li>
			}
		</ul>
	}
}

// reportResult shows what the server did with a detection.
templ reportResult(e EventModel) {
	if e.ReportErr != "" {
		<span class="text-sm text-red-300">nicht eingetragen: { e.ReportErr }</span>
	} else if e.Game != 0 {
		<span class="text-sm text-emerald-300">eingetragen in Spiel { strconv.FormatInt(e.Game, 10) }</span>
	}
}

templ RemovePage(c CameraModel) {
	@layout(c.Name + " entfernen") {
		@title(c.Name + " entfernen?")
		<p class="mb-4 max-w-3xl text-white/70">Die Kamera wird vom Board entfernt, samt ihrer Kalibrierung. Du kannst sie später wieder hinzufügen und neu kalibrieren.</p>
		<div class="flex items-center gap-3">
			<form method="post" action={ templ.URL(camURL(c.Name, "/remove")) }>
				<button type="submit" class={ btnDanger }>Entfernen</button>
			</form>
			<a href="/" class={ linkClass }>Abbrechen</a>
		</div>
	}
}

templ Calibrate(m CalibrateModel) {
	@layout("Kalibrieren: " + m.Name) {
		@title(m.Name + " kalibrieren")
		@errorAlert(m.Error)
		<div class="mb-4 rounded-2xl border border-sky-400/50 bg-sky-400/10 px-4 py-3">
			if m.Target != nil {
				<div class="font-semibold">
					Klicke auf die Stelle, an der der Draht zwischen
					<span class="rounded-md bg-board-cream px-2 font-display text-xl font-extrabold text-pub-950">{ strconv.Itoa(int(m.Target[0])) }</span> und
					<span class="rounded-md bg-board-cream px-2 font-display text-xl font-extrabold text-pub-950">{ strconv.Itoa(int(m.Target[1])) }</span>
					die Außenkante des Doppelrings kreuzt.
				</div>
				<div class="text-sm text-white/60">Ungefähr reicht, die Feinkalibrierung gleicht das aus. Ist die Stelle verdeckt oder nicht im Bild, überspringe sie.</div>
			} else {
				<div class="font-semibold">Alle Punkte durch.</div>
			}
			<div class="mt-1 text-sm text-white/60">{ strconv.Itoa(m.Points) } Punkte gesetzt, mindestens { strconv.Itoa(m.MinPoints) } nötig.</div>
		</div>
		<div class="mb-4 flex flex-wrap gap-2">
			if m.Target != nil {
				<form method="post" action={ templ.URL(camURL(m.Name, "/skip")) }>
					<button type="submit" class={ btnSecondary }>Überspringen</button>
				</form>
			}
			<form method="post" action={ templ.URL(camURL(m.Name, "/finish")) }>
				<button type="submit" class={ btnPrimary } disabled?={ m.Points < m.MinPoints }>Fertig: feinkalibrieren und speichern</button>
			</form>
			<form method="post" action={ templ.URL(camURL(m.Name, "/start")) }>
				<button type="submit" class={ btnDanger }>Von vorn (neues Bild)</button>
			</form>
		</div>
		// Shown in full size, so the click position the image input sends is in image pixels.
		<form method="post" action={ templ.URL(camURL(m.Name, "/point")) } class="overflow-auto rounded-2xl border border-white/10">
			<input
				type="image"
				name="click"
				src={ camURL(m.Name, "/clicked.jpg?n="+strconv.Itoa(m.Points)) }
				width={ strconv.Itoa(m.Bounds.Dx()) }
				height={ strconv.Itoa(m.Bounds.Dy()) }
				class="max-w-none cursor-crosshair"
				alt="Kamerabild, hier klicken"
			/>
		</form>
	}
}

templ Check(m CheckModel) {
	@layout("Raster prüfen: " + m.Name) {
		@title("Raster von " + m.Name + " prüfen")
		if m.Error != "" {
			@errorAlert(m.Error)
		} else {
			if m.Wrong {
				<div class="mb-4 max-w-3xl rounded-2xl border border-board-red/50 bg-board-red/15 px-4 py-3 text-red-200" role="alert">
					<p class="mb-3">
						<strong>Das Raster passt nicht zum Board:</strong> nur { strconv.Itoa(m.Found) } von { strconv.Itoa(m.Searched) } Kanten und Drähten liegen dort, wo das Raster sie erwartet.
						Meist wurde beim Kalibrieren ein Draht verwechselt, z. B. 1/18 statt 20/1.
						Prüfe die Zahlen genau (sie stehen je nach Kamera auf dem Kopf) und kalibriere neu. Gegenprobe über die Farben: das Doppel der 20 ist rot, das der 1 grün.
					</p>
					<form method="post" action={ templ.URL(camURL(m.Name, "/start")) }>
						<button type="submit" class={ btnPrimary }>Neu kalibrieren</button>
					</form>
				</div>
			}
			<p class="mb-4 max-w-3xl text-white/70">
				Auf dem aktuellen Bild gesucht: Kanten der farbigen Ringe und die Drähte zwischen den Zahlen.
				Blau ist das Raster, wie die Kalibrierung das Board sieht; die Punkte sind die gefundenen Kanten und Drähte.
				Liegen die blauen Linien auf den echten Drähten und sind fast alle Punkte grün, stimmt die Kalibrierung.
			</p>
			<div class="mb-4 flex flex-wrap items-center gap-3">
				<span>@badge(strconv.Itoa(m.Good), "bg-board-green/25 text-emerald-300")
≤ 1 px</span>
				<span>@badge(strconv.Itoa(m.Fair), "bg-amber-400/20 text-amber-300")
≤ 2 px</span>
				<span>@badge(strconv.Itoa(m.Poor), "bg-board-red/25 text-red-300")
weiter daneben</span>
				<span>@badge(strconv.Itoa(m.Outliers), "bg-board-red/25 text-red-300")
verworfen (z. B. Pfeil davor)</span>
				<span class="text-white/50">mittlere Abweichung { strconv.FormatFloat(m.RMS, 'f', 2, 64) } px</span>
			</div>
			<p class="mb-4 text-sm text-white/50">Das ist nur eine Prüfung, gespeichert wird nichts. Stecken Pfeile im Board, erscheinen an ihnen verworfene Punkte; das ist in Ordnung.</p>
			<div class="overflow-auto rounded-2xl border border-white/10">
				<img src={ camURL(m.Name, "/features.jpg") } class="max-w-none" alt="Gefundene Kanten und Drähte"/>
			</div>
		}
		@backLink()
	}
}

templ EventPage(m EventModel) {
	@layout("Erkennung") {
		<h1 class="mb-4 font-display text-4xl font-extrabold uppercase tracking-wide text-board-cream sm:text-5xl">
			<span class="text-white/40">{ m.Time }:</span>
			if m.Takeout {
				Pfeile herausgezogen
			} else {
				{ m.Label }
			}
		</h1>
		if !m.Takeout {
			<div class="mb-6 grid items-start gap-6 md:grid-cols-[minmax(0,5fr)_minmax(0,7fr)]">
				@boardSketch(m)
				<div class="rounded-3xl border border-white/10 bg-pub-900/80 p-5">
					<table class="w-full text-sm tabular-nums">
						<thead class="text-left text-xs uppercase tracking-wider text-white/50">
							<tr><th class="py-2">Kamera</th><th class="py-2 text-right">Position (mm)</th><th class="py-2 text-right">Abstand zur Mitte</th><th class="py-2 text-right">Auflösung (px/mm)</th><th class="py-2 pl-3">Feld</th></tr>
						</thead>
						<tbody class="divide-y divide-white/5">
							for _, c := range m.Cameras {
								<tr>
									<td class="py-2"><span style={ "color: " + cameraColor(c.Index) }>●</span> { c.Name }</td>
									<td class="py-2 text-right">{ mm(c.Board.X) }, { mm(c.Board.Y) }</td>
									<td class="py-2 text-right">{ mm(c.Board.Radius()) }</td>
									<td class="py-2 text-right">{ mm(c.Radial) } / { mm(c.Tangential) }</td>
									<td class="py-2 pl-3">
										{ c.Label }
										if c.Hidden {
											<span class="text-white/40">(verdeckt)</span>
										}
									</td>
								</tr>
							}
							<tr class="font-bold">
								<td class="py-2">✕ Ergebnis</td>
								<td class="py-2 text-right">{ mm(m.Board.X) }, { mm(m.Board.Y) }</td>
								<td class="py-2 text-right">{ mm(m.Board.Radius()) }</td>
								<td></td>
								<td class="py-2 pl-3 text-amber-300">{ m.Label }</td>
							</tr>
						</tbody>
					</table>
					<p class="mt-3 text-sm text-white/50">Grenzen: Triple 99–107 mm, Doppel 162–170 mm, Bull bis 15,9 mm, Bullseye bis 6,35 mm. Auflösung: Pixel pro mm an dieser Stelle, zur Mitte hin / entlang des Rings. Das Ergebnis kombiniert die Abstände zur Mitte und die Winkel getrennt, jede Kamera zählt mit dem Quadrat ihrer Auflösung in dieser Richtung: ab drei Kameras der gewichtete Median, bei zwei der gewichtete Mittelwert (nahe der Mitte pro Koordinate). Endet die Spitze einer Kamera an einem früheren Pfeil („verdeckt“), zählt sie nur, wenn keine andere Kamera den Pfeil sieht.</p>
				</div>
			</div>
		}
		<div class="grid gap-4 md:grid-cols-3">
			for _, c := range m.AllCameras {
				<div>
					<div class="mb-1 flex items-center justify-between gap-2">
						<span class="font-semibold"><span style={ "color: " + cameraColor(c.Index) }>●</span> { c.Name }</span>
						<span class="flex gap-3 text-sm">
							<a href={ templ.URL(eventFrameURL(m.ID, c.Index, "before")) } class={ linkClass }>Vorher</a>
							<a href={ templ.URL(eventFrameURL(m.ID, c.Index, "after")) } class={ linkClass }>Nachher</a>
						</span>
					</div>
					<img src={ "/event/" + strconv.Itoa(m.ID) + "/cam/" + strconv.Itoa(c.Index) + ".jpg" } class="w-full rounded-2xl border border-white/10" alt={ "Bild von " + c.Name }/>
				</div>
			}
		</div>
		@backLink()
	}
}

// boardSketch draws the board from the front with the positions seen by each camera
// and the result, zoomed to the area around the dart.
templ boardSketch(m EventModel) {
	{{ vb := sketchViewBox(m) }}
	<svg viewBox={ vb } class="aspect-square w-full rounded-3xl border border-white/10 bg-pub-900">
		for _, r := range []float64{dartboard.DoubleOuterRadius, dartboard.DoubleInnerRadius, dartboard.TripleOuterRadius, dartboard.TripleInnerRadius, dartboard.BullRadius, dartboard.BullseyeRadius} {
			<circle cx="0" cy="0" r={ num(r) } fill="none" stroke="#888" stroke-width={ num(sketchStroke(m)) }></circle>
		}
		for i := range 20 {
			{{ a := (float64(i) + 0.5) * dartboard.SegmentAngle }}
			{{ p1, p2 := dartboard.Polar(dartboard.BullRadius, a), dartboard.Polar(dartboard.DoubleOuterRadius, a) }}
			<line x1={ num(p1.X) } y1={ num(-p1.Y) } x2={ num(p2.X) } y2={ num(-p2.Y) } stroke="#888" stroke-width={ num(sketchStroke(m)) }></line>
			{{ t := dartboard.Polar(185, float64(i)*dartboard.SegmentAngle) }}
			<text x={ num(t.X) } y={ num(-t.Y) } fill="#ccc" font-size="14" text-anchor="middle" dominant-baseline="middle">{ strconv.Itoa(int(dartboard.Segments[i])) }</text>
		}
		for _, c := range m.Cameras {
			<circle cx={ num(c.Board.X) } cy={ num(-c.Board.Y) } r={ num(sketchStroke(m) * 4) } fill={ cameraColor(c.Index) }></circle>
		}
		{{ s := sketchStroke(m) * 6 }}
		<line x1={ num(m.Board.X - s) } y1={ num(-m.Board.Y - s) } x2={ num(m.Board.X + s) } y2={ num(-m.Board.Y + s) } stroke="#fff" stroke-width={ num(sketchStroke(m) * 1.5) }></line>
		<line x1={ num(m.Board.X - s) } y1={ num(-m.Board.Y + s) } x2={ num(m.Board.X + s) } y2={ num(-m.Board.Y - s) } stroke="#fff" stroke-width={ num(sketchStroke(m) * 1.5) }></line>
	</svg>
}

// sketchSize is the width of the board area shown, in mm: enough to see the dart's field.
func sketchSize(m EventModel) float64 {
	spread := 0.0
	for _, c := range m.Cameras {
		spread = max(spread, math.Hypot(c.Board.X-m.Board.X, c.Board.Y-m.Board.Y))
	}
	return max(60, 4*spread)
}

func sketchViewBox(m EventModel) string {
	size := sketchSize(m)
	return num(m.Board.X-size/2) + " " + num(-m.Board.Y-size/2) + " " + num(size) + " " + num(size)
}

func sketchStroke(m EventModel) float64 {
	return sketchSize(m) / 300
}

var cameraColors = []string{"#ff5a5a", "#4cc3ff", "#ffd23f", "#8bff6b", "#d78bff"}

func cameraColor(i int) string {
	return cameraColors[i%len(cameraColors)]
}

func num(f float64) string {
	return strconv.FormatFloat(f, 'f', 2, 64)
}

func mm(f float64) string {
	return strconv.FormatFloat(f, 'f', 1, 64)
}

templ Devices(m DevicesModel) {
	@layout("Kamera hinzufügen") {
		@title("Kamera hinzufügen")
		<p class="mb-4 max-w-3xl text-white/60">
			Alle Kameras an diesem Rechner. Füge die hinzu, die aufs Board schauen; danach wird sie kalibriert.
			Gleiche Kameras unterscheidet darts-o-cam an ihrem Bild vom Board, nicht am USB-Anschluss: Umstecken an andere Ports ist kein Problem.
		</p>
		@errorAlert(m.Error)
		<form method="post" action="/devices/refresh" class="mb-4 flex flex-wrap items-center gap-3">
			<button type="submit" class={ btnSecondary, btnSmall }>Neue Bilder aufnehmen</button>
			<span class="text-sm text-white/50">Welche ist welche? Halte eine Hand vor eine Kamera und nimm neue Bilder auf.</span>
		</form>
		if len(m.Devices) == 0 && m.Error == "" {
			@notice("Keine Kameras gefunden. Ist die Kamera angeschlossen und darf darts-o-cam darauf zugreifen?", "border-amber-400/50 bg-amber-400/10 text-amber-200")
		}
		<div class="grid gap-6 md:grid-cols-2">
			for _, d := range m.Devices {
				<div class="overflow-hidden rounded-3xl border border-white/10 bg-pub-900/80 shadow-xl shadow-black/30">
					<img src={ snapshotURL(d.ID) } class="aspect-video w-full bg-pub-800 object-cover" alt={ "Bild von " + d.Name + " (nicht verfügbar)" }/>
					<div class="flex flex-wrap items-center justify-between gap-3 p-4">
						<span>
							<span class="font-display text-2xl font-semibold uppercase">{ d.Name }</span>
							if d.Model != "" {
								<span class="text-sm text-white/40">({ d.Model })</span>
							}
						</span>
						if d.Camera != "" {
							@badge("am Board als "+d.Camera, "bg-board-green/25 text-emerald-300")
						} else {
							<form method="post" action="/devices/add">
								<input type="hidden" name="id" value={ d.ID }/>
								<button type="submit" class={ btnPrimary }>Hinzufügen</button>
							</form>
						}
					</div>
				</div>
			}
		</div>
		@backLink()
	}
}

templ SettingsPage(m SettingsModel) {
	@layout("Einstellungen") {
		@title("Einstellungen")
		@errorAlert(m.Error)
		if m.Saved {
			@notice("Gespeichert und übernommen.", "border-board-green/50 bg-board-green/15 text-emerald-200")
		}
		<form method="post" action="/settings" class="flex max-w-2xl flex-col gap-6">
			<fieldset class="flex flex-col gap-3">
				<legend class="mb-2 font-display text-2xl font-extrabold uppercase tracking-wide text-board-cream">darts-o-mat</legend>
				<p class="text-white/60">Leg auf dem Server unter „Boards“ dein Board an und erzeuge einen Kamera-Token. Erkannte Würfe gehen dann in das laufende Spiel auf diesem Board.</p>
				<label class="flex flex-col gap-1">
					<span class="font-semibold">Server</span>
					<input type="url" name="server" value={ m.Settings.Server } placeholder="http://localhost:3000" class={ inputClass }/>
				</label>
				<label class="flex flex-col gap-1">
					<span class="font-semibold">Kamera-Token</span>
					<input type="text" name="token" value={ m.Settings.Token } autocomplete="off" spellcheck="false" class={ inputClass }/>
				</label>
			</fieldset>
			<fieldset class="flex flex-col gap-3">
				<legend class="mb-2 font-display text-2xl font-extrabold uppercase tracking-wide text-board-cream">Kameras</legend>
				<label class="flex flex-col gap-1">
					<span class="font-semibold">Gewünschte Bildgröße</span>
					<select name="size" class={ inputClass }>
						for _, size := range Sizes {
							<option value={ sizeValue(size[0], size[1]) } selected?={ size[0] == m.Settings.Width && size[1] == m.Settings.Height }>{ strconv.Itoa(size[0]) } × { strconv.Itoa(size[1]) }</option>
						}
					</select>
					<span class="text-sm text-white/50">Jede Kamera nimmt ihren eigenen Modus, der dieser Größe am nächsten kommt; welche Größe sie liefert, steht auf ihrer Karte. Die Kameras werden dafür neu geöffnet. Eine Kalibrierung gilt nur für die Größe, in der sie gemacht wurde.</span>
				</label>
				<label class="flex flex-col gap-1">
					<span class="font-semibold">Bilder pro Sekunde</span>
					<input type="number" name="fps" min="1" max="30" value={ strconv.Itoa(m.Settings.FPS) } class={ inputClass }/>
					<span class="text-sm text-white/50">So viele Bilder pro Sekunde wertet die Erkennung aus; mehr reagiert schneller, braucht aber mehr Rechenleistung.</span>
				</label>
			</fieldset>
			<details class="rounded-2xl border border-white/10 bg-pub-900/60 p-4">
				<summary class="cursor-pointer font-display text-2xl font-extrabold uppercase tracking-wide text-board-cream">Erkennung (für Fortgeschrittene)</summary>
				<p class="mt-3 text-white/60">
					Größen sind in Millimetern auf dem Board angegeben; darts-o-cam rechnet sie für jede Kamera nach ihrer Auflösung und ihrem Abstand in Bildpunkte um.
					Die Standardwerte stammen von einem Board mit drei Kameras bei 1280 × 720.
				</p>
				<div class="mt-4 grid gap-4 sm:grid-cols-2">
					for _, f := range detectionFields(m.Settings.Detection) {
						<label class="flex flex-col gap-1">
							<span class="font-semibold">{ f.Label } <span class="text-sm font-normal text-white/40">({ f.Unit })</span></span>
							<input type="number" name={ f.Name } value={ f.Value } step={ f.Step } min="0" class={ inputClass }/>
							<span class="text-sm text-white/50">{ f.Hint }</span>
						</label>
					}
				</div>
				// Belongs to its own form below: Enter in a field submits with the form's first
				// button, which must be "Speichern", not this one.
				<button type="submit" form="detection-defaults" class={ btnSecondary, btnSmall, "mt-4" }>Standardwerte</button>
			</details>
			<div class="flex items-center gap-3">
				<button type="submit" class={ btnPrimary }>Speichern</button>
				<a href="/" class={ linkClass }>Zurück</a>
			</div>
		</form>
		<form id="detection-defaults" method="post" action="/settings/defaults"></form>
	}
}
