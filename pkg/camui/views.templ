package camui

import (
	"image"
	"math"
	"strconv"

	"github.com/sj14/darts-o-mat/pkg/domain/dartboard"
	"github.com/sj14/darts-o-mat/pkg/vision"
)

type OverviewModel struct {
	Path        string // of the calibration file
	DeviceName  string // of the chosen cameras
	DeviceModel string
	Cameras     []CameraModel
	Events      []EventModel // newest first
}

type EventModel struct {
	ID      int
	Time    string
	Takeout bool
	Label   string          // the scored dart
	Board   dartboard.Point // fused position in mm
	Cameras []CameraPoint   // the cameras that found the dart
	// AllCameras lists every camera, for the images.
	AllCameras []CameraPoint
}

type CameraPoint struct {
	Index int
	Name  string
	Board dartboard.Point
	Label string
}

type CheckModel struct {
	Index                      int
	Name                       string
	Error                      string
	Matches                    int
	RMS                        float64
	Good, Fair, Poor, Outliers int
}

type DevicesModel struct {
	Groups  []vision.DeviceGroup
	Current string // the chosen device name
	Open    int    // cameras opened at the start
	Saved   bool
	Error   string
}

type CameraModel struct {
	Index      int
	Name       string
	Device     string
	Calibrated bool
}

type CalibrateModel struct {
	Index     int
	Name      string
	Points    int // clicked so far
	MinPoints int
	Target    *[2]uint8 // the next point to click, nil when all were offered
	Bounds    image.Rectangle
	Error     string
}

func camURL(i int, suffix string) string {
	return "/cam/" + strconv.Itoa(i) + suffix
}

templ layout(title string) {
	<!DOCTYPE html>
	<html lang="de">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title } · darts-o-cam</title>
			<link rel="stylesheet" href="/static/bootstrap.min.css"/>
			<link rel="stylesheet" href="/static/app.css"/>
		</head>
		<body>
			<header class="border-bottom mb-4">
				<div class="container py-3">
					<a href="/" class="fs-xl fw-bold text-decoration-none">📷 darts-o-cam · Kalibrierung</a>
				</div>
			</header>
			<main class="container pb-5">
				{ children... }
			</main>
		</body>
	</html>
}

templ Overview(m OverviewModel) {
	@layout("Kameras") {
		<p class="fg-3">
			Die Kalibrierung wird auf diesem Rechner gespeichert ({ m.Path }) und funktioniert mit jedem darts-o-mat-Server.
			Kalibriere jede Kamera einmal mit <strong>leerem Board</strong>; danach liegt auf ihrem Bild das Raster des Boards.
		</p>
		<p class="d-flex gap-3 flex-wrap align-items-center">
			if m.DeviceName != "" {
				<span>
					Kameras: <strong>{ m.DeviceName }</strong>
					if m.DeviceModel != "" {
						<span class="fg-3 fs-sm">({ m.DeviceModel })</span>
					}
				</span>
			}
			<a href="/devices">Kameras wählen</a>
			<a href="/">Bilder aktualisieren</a>
		</p>
		if len(m.Cameras) == 0 {
			<div class="alert theme-warning" role="status">
				Keine Kameras geöffnet. Wähle unter <a href="/devices">Kameras wählen</a>, welche Kameras zum Board gehören, und starte darts-o-cam neu.
			</div>
		}
		<div class="row g-4">
			for _, c := range m.Cameras {
				<div class="md:col-6">
					<div class="card">
						<img src={ camURL(c.Index, "/frame.jpg") } class="card-img-top" alt={ "Bild von " + c.Name }/>
						<div class="card-body d-grid gap-2">
							<div class="d-flex justify-content-between align-items-center">
								<span class="fw-semibold">{ c.Name } <span class="fg-3 fs-sm">(Gerät { c.Device })</span></span>
								if c.Calibrated {
									<span class="badge theme-success">kalibriert</span>
								} else {
									<span class="badge theme-warning">nicht kalibriert</span>
								}
							</div>
							<div class="d-flex gap-2 flex-wrap">
								<form method="post" action={ templ.URL(camURL(c.Index, "/start")) } class="mb-0">
									<button type="submit" class="btn-solid theme-primary">
										if c.Calibrated {
											Neu kalibrieren
										} else {
											Kalibrieren
										}
									</button>
								</form>
								if c.Calibrated {
									<a href={ templ.URL(camURL(c.Index, "/check")) } class="btn-outline theme-secondary">Raster prüfen</a>
									<form method="post" action={ templ.URL(camURL(c.Index, "/refine")) } class="mb-0">
										<button type="submit" class="btn-outline theme-secondary">Nur feinkalibrieren</button>
									</form>
								}
							</div>
						</div>
					</div>
				</div>
			}
		</div>
		<h2 class="fs-xl mt-5 mb-3">Letzte Erkennungen</h2>
		if len(m.Events) == 0 {
			<p class="fg-3">Noch keine. Sie erscheinen hier, sobald <code>darts-o-cam detect</code> Würfe erkennt.</p>
		} else {
			<div class="list-group">
				for _, e := range m.Events {
					<a href={ templ.URL("/event/" + strconv.Itoa(e.ID)) } class="list-group-item list-group-item-action d-flex justify-content-between">
						<span>{ e.Time }</span>
						if e.Takeout {
							<span class="fg-3">Pfeile herausgezogen</span>
						} else {
							<span class="fw-semibold">{ e.Label } <span class="fg-3 fs-sm">({ strconv.Itoa(len(e.Cameras)) } Kameras)</span></span>
						}
					</a>
				}
			</div>
		}
	}
}

templ Calibrate(m CalibrateModel) {
	@layout("Kalibrieren: " + m.Name) {
		<h1 class="fs-2xl mb-2">{ m.Name } kalibrieren</h1>
		if m.Error != "" {
			<div class="alert theme-danger mb-3" role="alert">{ m.Error }</div>
		}
		<div class="alert theme-primary mb-3">
			if m.Target != nil {
				<div class="fw-bold">
					Klicke auf die Stelle, an der der Draht zwischen
					<span class="badge theme-primary">{ strconv.Itoa(int(m.Target[0])) }</span> und
					<span class="badge theme-primary">{ strconv.Itoa(int(m.Target[1])) }</span>
					die Außenkante des Doppelrings kreuzt.
				</div>
				<div class="fs-sm">Ungefähr reicht, die Feinkalibrierung gleicht das aus. Ist die Stelle verdeckt oder nicht im Bild, überspringe sie.</div>
			} else {
				<div class="fw-bold">Alle Punkte durch.</div>
			}
			<div class="fs-sm mt-1">{ strconv.Itoa(m.Points) } Punkte gesetzt, mindestens { strconv.Itoa(m.MinPoints) } nötig.</div>
		</div>
		<div class="d-flex gap-2 flex-wrap mb-3">
			if m.Target != nil {
				<form method="post" action={ templ.URL(camURL(m.Index, "/skip")) } class="mb-0">
					<button type="submit" class="btn-outline theme-secondary">Überspringen</button>
				</form>
			}
			<form method="post" action={ templ.URL(camURL(m.Index, "/finish")) } class="mb-0">
				<button type="submit" class="btn-solid theme-success" disabled?={ m.Points < m.MinPoints }>Fertig: feinkalibrieren und speichern</button>
			</form>
			<form method="post" action={ templ.URL(camURL(m.Index, "/start")) } class="mb-0">
				<button type="submit" class="btn-outline theme-danger">Von vorn (neues Bild)</button>
			</form>
		</div>
		// Shown in full size, so the click position the image input sends is in image pixels.
		<form method="post" action={ templ.URL(camURL(m.Index, "/point")) } class="mb-0" style="overflow: auto">
			<input
				type="image"
				name="click"
				src={ camURL(m.Index, "/clicked.jpg?n="+strconv.Itoa(m.Points)) }
				width={ strconv.Itoa(m.Bounds.Dx()) }
				height={ strconv.Itoa(m.Bounds.Dy()) }
				style="max-width: none; cursor: crosshair"
				alt="Kamerabild, hier klicken"
			/>
		</form>
	}
}

templ Check(m CheckModel) {
	@layout("Raster prüfen: " + m.Name) {
		<h1 class="fs-2xl mb-2">Raster von { m.Name } prüfen</h1>
		if m.Error != "" {
			<div class="alert theme-danger" role="alert">{ m.Error }</div>
		} else {
			<p>
				Auf dem aktuellen Bild gesucht: Kanten der farbigen Ringe und die Drähte zwischen den Zahlen.
				Blau ist das Raster, wie die Kalibrierung das Board sieht; die Punkte sind die gefundenen Kanten und Drähte.
				Liegen die blauen Linien auf den echten Drähten und sind fast alle Punkte grün, stimmt die Kalibrierung.
			</p>
			<p class="d-flex gap-3 flex-wrap">
				<span><span class="badge theme-success">{ strconv.Itoa(m.Good) }</span> ≤ 1 px</span>
				<span><span class="badge theme-warning">{ strconv.Itoa(m.Fair) }</span> ≤ 2 px</span>
				<span><span class="badge theme-danger">{ strconv.Itoa(m.Poor) }</span> weiter daneben</span>
				<span><span class="badge theme-danger">{ strconv.Itoa(m.Outliers) }</span> verworfen (z. B. Pfeil davor)</span>
				<span class="fg-3">mittlere Abweichung { strconv.FormatFloat(m.RMS, 'f', 2, 64) } px</span>
			</p>
			<p class="fs-sm fg-3">Das ist nur eine Prüfung, gespeichert wird nichts. Stecken Pfeile im Board, erscheinen an ihnen verworfene Punkte; das ist in Ordnung.</p>
			<div style="overflow: auto">
				<img src={ camURL(m.Index, "/features.jpg") } style="max-width: none" alt="Gefundene Kanten und Drähte"/>
			</div>
		}
		<p class="mt-3"><a href="/">Zurück</a></p>
	}
}

templ EventPage(m EventModel) {
	@layout("Erkennung") {
		<h1 class="fs-2xl mb-3">
			if m.Takeout {
				{ m.Time }: Pfeile herausgezogen
			} else {
				{ m.Time }: { m.Label }
			}
		</h1>
		if !m.Takeout {
			<div class="row g-4 mb-4">
				<div class="md:col-5">
					@boardSketch(m)
				</div>
				<div class="md:col-7">
					<table class="table table-sm">
						<thead>
							<tr><th>Kamera</th><th class="text-end">Position (mm)</th><th class="text-end">Abstand zur Mitte</th><th>Feld</th></tr>
						</thead>
						<tbody>
							for _, c := range m.Cameras {
								<tr>
									<td><span style={ "color: " + cameraColor(c.Index) }>●</span> { c.Name }</td>
									<td class="text-end">{ mm(c.Board.X) }, { mm(c.Board.Y) }</td>
									<td class="text-end">{ mm(c.Board.Radius()) }</td>
									<td>{ c.Label }</td>
								</tr>
							}
							<tr class="fw-bold">
								<td>✕ Ergebnis</td>
								<td class="text-end">{ mm(m.Board.X) }, { mm(m.Board.Y) }</td>
								<td class="text-end">{ mm(m.Board.Radius()) }</td>
								<td>{ m.Label }</td>
							</tr>
						</tbody>
					</table>
					<p class="fs-sm fg-3">Grenzen: Triple 99–107 mm, Doppel 162–170 mm, Bull bis 15,9 mm, Bullseye bis 6,35 mm. Das Ergebnis ist der Median der Abstände zur Mitte und der Median der Winkel (nahe der Mitte: Median pro Koordinate).</p>
				</div>
			</div>
		}
		<div class="row g-3">
			for _, c := range m.AllCameras {
				<div class="md:col-4">
					<div class="fw-semibold mb-1"><span style={ "color: " + cameraColor(c.Index) }>●</span> { c.Name }</div>
					<img src={ "/event/" + strconv.Itoa(m.ID) + "/cam/" + strconv.Itoa(c.Index) + ".jpg" } class="w-100" alt={ "Bild von " + c.Name }/>
				</div>
			}
		</div>
		<p class="mt-3"><a href="/">Zurück</a></p>
	}
}

// boardSketch draws the board from the front with the positions seen by each camera
// and the result, zoomed to the area around the dart.
templ boardSketch(m EventModel) {
	{{ vb := sketchViewBox(m) }}
	<svg viewBox={ vb } class="w-100 border rounded" style="background: #1d1d1d; aspect-ratio: 1">
		for _, r := range []float64{dartboard.DoubleOuterRadius, dartboard.DoubleInnerRadius, dartboard.TripleOuterRadius, dartboard.TripleInnerRadius, dartboard.BullRadius, dartboard.BullseyeRadius} {
			<circle cx="0" cy="0" r={ num(r) } fill="none" stroke="#888" stroke-width={ num(sketchStroke(m)) }></circle>
		}
		for i := range 20 {
			{{ a := (float64(i) + 0.5) * dartboard.SegmentAngle }}
			{{ p1, p2 := dartboard.Polar(dartboard.BullRadius, a), dartboard.Polar(dartboard.DoubleOuterRadius, a) }}
			<line x1={ num(p1.X) } y1={ num(-p1.Y) } x2={ num(p2.X) } y2={ num(-p2.Y) } stroke="#888" stroke-width={ num(sketchStroke(m)) }></line>
			{{ t := dartboard.Polar(185, float64(i)*dartboard.SegmentAngle) }}
			<text x={ num(t.X) } y={ num(-t.Y) } fill="#ccc" font-size="14" text-anchor="middle" dominant-baseline="middle">{ strconv.Itoa(int(dartboard.Segments[i])) }</text>
		}
		for _, c := range m.Cameras {
			<circle cx={ num(c.Board.X) } cy={ num(-c.Board.Y) } r={ num(sketchStroke(m) * 4) } fill={ cameraColor(c.Index) }></circle>
		}
		{{ s := sketchStroke(m) * 6 }}
		<line x1={ num(m.Board.X - s) } y1={ num(-m.Board.Y - s) } x2={ num(m.Board.X + s) } y2={ num(-m.Board.Y + s) } stroke="#fff" stroke-width={ num(sketchStroke(m) * 1.5) }></line>
		<line x1={ num(m.Board.X - s) } y1={ num(-m.Board.Y + s) } x2={ num(m.Board.X + s) } y2={ num(-m.Board.Y - s) } stroke="#fff" stroke-width={ num(sketchStroke(m) * 1.5) }></line>
	</svg>
}

// sketchSize is the width of the board area shown, in mm: enough to see the dart's field.
func sketchSize(m EventModel) float64 {
	spread := 0.0
	for _, c := range m.Cameras {
		spread = max(spread, math.Hypot(c.Board.X-m.Board.X, c.Board.Y-m.Board.Y))
	}
	return max(60, 4*spread)
}

func sketchViewBox(m EventModel) string {
	size := sketchSize(m)
	return num(m.Board.X-size/2) + " " + num(-m.Board.Y-size/2) + " " + num(size) + " " + num(size)
}

func sketchStroke(m EventModel) float64 {
	return sketchSize(m) / 300
}

var cameraColors = []string{"#ff5a5a", "#4cc3ff", "#ffd23f", "#8bff6b", "#d78bff"}

func cameraColor(i int) string {
	return cameraColors[i%len(cameraColors)]
}

func num(f float64) string {
	return strconv.FormatFloat(f, 'f', 2, 64)
}

func mm(f float64) string {
	return strconv.FormatFloat(f, 'f', 1, 64)
}

templ Devices(m DevicesModel) {
	@layout("Kameras wählen") {
		<h1 class="fs-2xl mb-2">Kameras wählen</h1>
		<p class="fg-3">
			Wähle, welche Kameras zum Board gehören. Gespeichert wird ihr Name (mit Modell zur Erkennung), nicht der USB-Anschluss:
			nach dem Umstecken an andere Ports werden dieselben Kameras wieder gefunden. Welche Kamera welche ist, erkennt darts-o-cam an ihrem Bild vom Board.
		</p>
		if m.Error != "" {
			<div class="alert theme-danger" role="alert">{ m.Error }</div>
		}
		if m.Saved {
			<div class="alert theme-success" role="status">Gespeichert. Starte darts-o-cam neu, damit die Kameras geöffnet werden.</div>
		}
		<form method="post" action="/devices" class="d-grid gap-3">
			<div class="list-group">
				for _, g := range m.Groups {
					<label class="list-group-item d-flex gap-3 align-items-center">
						<input type="radio" class="radio" name="name" value={ g.Name } checked?={ g.Name == m.Current }/>
						<span>
							<span class="fw-semibold">{ g.Name }</span>
							<span class="fg-3 fs-sm">
								{ strconv.Itoa(g.Count) } ×
								if g.Model != "" {
									· Modell { g.Model }
								}
							</span>
						</span>
					</label>
				}
			</div>
			<div>
				<button type="submit" class="btn-solid theme-primary">Speichern</button>
				<a href="/" class="ms-2">Zurück</a>
			</div>
		</form>
		<p class="fs-sm fg-3 mt-3">Gerade geöffnet: { strconv.Itoa(m.Open) } Kameras.</p>
	}
}
