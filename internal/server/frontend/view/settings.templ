package view

import (
	"strconv"

	"github.com/sj14/darts-o-mat/internal/server/domain/account"
	"github.com/sj14/darts-o-mat/internal/server/domain/player"
)

// Settings lets an account change how it appears (the accent color of its player), its
// email and delete its guests (guests are made in the lobby of a game); the admin finds the
// admin page there.
// Settings is the account's settings page. lastAdmin says the account is the only admin,
// who can't delete their account; info confirms a change.
templ Settings(acc account.Account, p player.Player, guests []player.Player, lastAdmin bool, errMsg, info string) {
	@layout(T(ctx).NavSettings(), acc.Username) {
		<div class="mx-auto max-w-3xl">
			@pageTitle(T(ctx).NavSettings(), "")
			@errorAlert(errMsg)
			@notice(info)
			@panel("") {
				<h2 class={ labelClass }>{ T(ctx).AccentColor() }</h2>
				<p class={ hintClass }>{ T(ctx).AccentColorHint() }</p>
				// Choosing submits at once; without JavaScript the button does.
				<form method="post" action="/settings/color" onchange="this.submit()" class="mt-4 flex flex-wrap items-center gap-3">
					<label class="cursor-pointer">
						<input type="radio" name="color" value="" class="peer sr-only" checked?={ p.Color == "" }/>
						<span class="flex h-10 items-center gap-2 rounded-full border border-white/20 px-4 text-sm font-semibold text-white/80 peer-checked:border-white peer-checked:text-white peer-focus-visible:ring-2 peer-focus-visible:ring-white/70">
							<span class={ "size-4 rounded-full", accents[p.Accent()].Swatch }></span>
							{ T(ctx).ColorAuto() }
						</span>
					</label>
					for _, c := range player.Colors {
						<label class="cursor-pointer" title={ T(ctx).ColorName(c) }>
							<input type="radio" name="color" value={ c } class="peer sr-only" checked?={ p.Color == c } aria-label={ T(ctx).ColorName(c) }/>
							<span class={ "block size-10 rounded-full ring-2 ring-transparent ring-offset-2 ring-offset-pub-900 peer-checked:ring-white peer-focus-visible:ring-white/70", accents[c].Swatch }></span>
						</label>
					}
					<noscript><button type="submit" class={ btnSecondary }>OK</button></noscript>
				</form>
			}
			@panel("mt-6") {
				<h2 class={ labelClass }>{ T(ctx).Email() }</h2>
				<p class={ hintClass }>{ T(ctx).EmailHint() }</p>
				<form method="post" action="/settings/email" class="mt-4 flex flex-wrap items-center gap-3">
					<input type="email" name="email" value={ acc.Email } class={ inputClass, "max-w-xs" } autocomplete="email" autocapitalize="none" aria-label={ T(ctx).Email() }/>
					<button type="submit" class={ btnSecondary }>{ T(ctx).SaveEmail() }</button>
				</form>
			}
			@panel("mt-6") {
				<h2 class={ labelClass }>{ T(ctx).ChangePasswordTitle() }</h2>
				<p class={ hintClass }>{ T(ctx).ChangePasswordHint() }</p>
				<form method="post" action="/settings/password" class="mt-4 flex flex-wrap items-center gap-3">
					// The username lets password managers know which login to update.
					<input type="text" name="username" value={ acc.Username } autocomplete="username" class="hidden" aria-hidden="true" tabindex="-1"/>
					<input type="password" name="current" class={ inputClass, "max-w-xs" } placeholder={ T(ctx).CurrentPassword() } autocomplete="current-password" required aria-label={ T(ctx).CurrentPassword() }/>
					<input type="password" name="password" class={ inputClass, "max-w-xs" } placeholder={ T(ctx).NewPassword() } autocomplete="new-password" minlength="8" required aria-label={ T(ctx).NewPassword() }/>
					<button type="submit" class={ btnSecondary }>{ T(ctx).ChangePasswordButton() }</button>
				</form>
			}
			@panel("mt-6") {
				<h2 class={ labelClass }>{ T(ctx).Incognito() }</h2>
				<p class={ hintClass }>{ T(ctx).IncognitoHint() }</p>
				// Like the color: choosing submits at once; without JavaScript the button does.
				<form method="post" action="/settings/invisible" onchange="this.submit()" class="mt-4 flex flex-wrap items-center gap-3">
					@checkbox("invisible", "invisible", "1", acc.Invisible) {
						{ T(ctx).AppearOffline() }
					}
					<noscript><button type="submit" class={ btnSecondary }>OK</button></noscript>
				</form>
			}
			@panel("mt-6") {
				<h2 class={ labelClass }>{ T(ctx).Guests() }</h2>
				<p class={ hintClass }>{ T(ctx).GuestsHint() }</p>
				if len(guests) == 0 {
					<p class="mt-4 text-white/50">{ T(ctx).NoGuests() }</p>
				}
				<ul class="mt-2 divide-y divide-white/10">
					for _, g := range guests {
						<li class="flex items-center justify-between gap-2 py-2">
							<span>{ g.Name }</span>
							<form method="post" action={ templ.URL("/guests/" + strconv.FormatInt(g.ID, 10) + "/delete") } data-confirm={ T(ctx).DeleteGuestConfirm(g.Name) } onsubmit="return confirm(this.dataset.confirm)">
								<button type="submit" class={ btnDanger, btnSmall }>{ T(ctx).DeleteGuest() }</button>
							</form>
						</li>
					}
				</ul>
			}
			if acc.Admin {
				@panel("mt-6") {
					<h2 class={ labelClass }>{ T(ctx).AdminTitle() }</h2>
					<p class={ hintClass }>{ T(ctx).AdminLinkHint() }</p>
					<a href="/admin" class={ btnSecondary, "mt-4 inline-flex" }>{ T(ctx).OpenAdmin() }</a>
				}
			}
			@panel("mt-6 border-board-red/40") {
				<h2 class={ labelClass }>{ T(ctx).DeleteAccountTitle() }</h2>
				if lastAdmin {
					<p class={ hintClass }>{ T(ctx).ErrLastAdmin() }</p>
				} else {
					<p class={ hintClass }>{ T(ctx).DeleteAccountHint() }</p>
					<form method="post" action="/settings/delete" data-confirm={ T(ctx).DeleteAccountConfirm() } onsubmit="return confirm(this.dataset.confirm)" class="mt-4 flex flex-wrap items-center gap-3">
						<input type="password" name="password" class={ inputClass, "max-w-xs" } placeholder={ T(ctx).Password() } autocomplete="current-password" required aria-label={ T(ctx).Password() }/>
						<button type="submit" class={ btnDanger }>{ T(ctx).DeleteAccountButton() }</button>
					</form>
				}
			}
		</div>
	}
}
