package view

import (
	"strconv"

	"github.com/sj14/darts-o-mat/internal/server/domain/page"
)

// Page shows the imprint or the privacy policy, plain text with its line breaks. user is
// empty for visitors who aren't logged in.
templ Page(user string, name page.Name, text string) {
	@layout(pageTitleOf(ctx, name), user) {
		<div class="mx-auto max-w-3xl">
			@pageTitle(pageTitleOf(ctx, name), "")
			@panel("") {
				<div class="whitespace-pre-line break-words text-white/80">{ text }</div>
			}
		</div>
	}
}

// Admin is the page of the server's settings, only for the admin: the texts of the pages.
templ Admin(user string, pages map[page.Name]string, saved bool, errMsg string) {
	@layout(T(ctx).AdminTitle(), user) {
		<div class="mx-auto max-w-3xl">
			@pageTitle(T(ctx).AdminTitle(), T(ctx).AdminHint())
			@errorAlert(errMsg)
			if saved {
				@notice(T(ctx).Saved())
			}
			<div class="flex flex-col gap-6">
				for _, name := range page.Names {
					@panel("") {
						<form method="post" action={ templ.URL("/admin/pages/" + string(name)) } class="flex flex-col gap-3">
							<label for={ "page-" + string(name) } class={ labelClass }>{ pageTitleOf(ctx, name) }</label>
							<p class={ hintClass }>{ T(ctx).PageHint() }</p>
							<textarea id={ "page-" + string(name) } name="text" rows="12" maxlength={ strconv.Itoa(page.MaxLen) } class={ inputClass, "font-mono text-sm" }>{ pages[name] }</textarea>
							<div class="flex flex-wrap items-center gap-3">
								<button type="submit" class={ btnSecondary }>{ T(ctx).SavePage() }</button>
								if pages[name] != "" {
									<a href={ templ.URL(PagePath(name)) } class={ linkClass }>{ T(ctx).ShowPage() }</a>
								}
							</div>
						</form>
					}
				}
			</div>
		</div>
	}
}
