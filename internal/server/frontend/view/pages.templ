package view

import (
	"strconv"

	"github.com/sj14/darts-o-mat/internal/server/domain/account"
	"github.com/sj14/darts-o-mat/internal/server/domain/page"
)

// Page shows the imprint or the privacy policy, plain text with its line breaks. user is
// empty for visitors who aren't logged in.
templ Page(user string, name page.Name, text string) {
	@layout(pageTitleOf(ctx, name), user) {
		<div class="mx-auto max-w-3xl">
			@pageTitle(pageTitleOf(ctx, name), "")
			@panel("") {
				<div class="whitespace-pre-line break-words text-white/80">{ text }</div>
			}
		</div>
	}
}

// AdminModel is what the admin page shows.
type AdminModel struct {
	Admins       []account.Account    // the admins, by username
	Pages        map[page.Name]string // the texts of the pages, by name
	Registration bool                 // whether anyone may create an account
	Captcha      bool                 // whether registering needs the captcha (start options, not changed here)
	Saved        bool
	Error        string
}

// Admin is the page of the server's settings, only for admins: whether anyone may register,
// who is an admin, and the texts of the pages.
templ Admin(user string, m AdminModel) {
	@layout(T(ctx).AdminTitle(), user) {
		<div class="mx-auto max-w-3xl">
			@pageTitle(T(ctx).AdminTitle(), T(ctx).AdminHint())
			@errorAlert(m.Error)
			if m.Saved {
				@notice(T(ctx).Saved())
			}
			<div class="flex flex-col gap-6">
				@panel(T(ctx).RegistrationTitle()) {
					<form method="post" action="/admin/registration" class="flex flex-col gap-3">
						if m.Registration {
							<p class="text-white/80">{ T(ctx).RegistrationIsOpen() }</p>
						} else {
							<p class="text-white/80">{ T(ctx).RegistrationIsClosed() }</p>
						}
						if m.Captcha {
							<p class={ hintClass }>{ T(ctx).CaptchaOn() }</p>
						} else {
							<p class={ hintClass }>{ T(ctx).CaptchaOff() }</p>
						}
						<div>
							<input type="hidden" name="open" value={ strconv.FormatBool(!m.Registration) }/>
							<button type="submit" class={ btnSecondary }>
								if m.Registration {
									{ T(ctx).CloseRegistration() }
								} else {
									{ T(ctx).OpenRegistration() }
								}
							</button>
						</div>
					</form>
				}
				@panel(T(ctx).AdminsTitle()) {
					<p class={ hintClass }>{ T(ctx).AdminsHint() }</p>
					<ul class="mt-2 divide-y divide-white/10">
						for _, a := range m.Admins {
							<li class="flex flex-wrap items-center justify-between gap-3 py-3">
								<span class="font-display text-2xl font-semibold uppercase">{ a.Username }</span>
								// The last admin can't give up the role, so there is no button.
								if len(m.Admins) > 1 {
									<form method="post" action="/admin/admins" data-confirm={ T(ctx).RemoveAdminConfirm(a.Username) } onsubmit="return confirm(this.dataset.confirm)">
										<input type="hidden" name="username" value={ a.Username }/>
										<input type="hidden" name="admin" value="false"/>
										<button type="submit" class={ btnDanger, btnSmall }>{ T(ctx).RemoveAdmin() }</button>
									</form>
								}
							</li>
						}
					</ul>
					<form method="post" action="/admin/admins" class="mt-2 flex gap-2">
						<input type="hidden" name="admin" value="true"/>
						<input type="text" name="username" class={ inputClass } placeholder={ T(ctx).Username() } autocapitalize="none" required aria-label={ T(ctx).Username() }/>
						<button type="submit" class={ btnSecondary, "shrink-0" }>{ T(ctx).MakeAdmin() }</button>
					</form>
				}
				for _, name := range page.Names {
					@panel("") {
						<form method="post" action={ templ.URL("/admin/pages/" + string(name)) } class="flex flex-col gap-3">
							<label for={ "page-" + string(name) } class={ labelClass }>{ pageTitleOf(ctx, name) }</label>
							<p class={ hintClass }>{ T(ctx).PageHint() }</p>
							<textarea id={ "page-" + string(name) } name="text" rows="12" maxlength={ strconv.Itoa(page.MaxLen) } class={ inputClass, "font-mono text-sm" }>{ m.Pages[name] }</textarea>
							<div class="flex flex-wrap items-center gap-3">
								<button type="submit" class={ btnSecondary }>{ T(ctx).SavePage() }</button>
								if m.Pages[name] != "" {
									<a href={ templ.URL(PagePath(name)) } class={ linkClass }>{ T(ctx).ShowPage() }</a>
								}
							</div>
						</form>
					}
				}
			</div>
		</div>
	}
}
