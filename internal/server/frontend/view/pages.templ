package view

import (
	"context"
	"strconv"

	"github.com/sj14/darts-o-mat/internal/server/domain/account"
	"github.com/sj14/darts-o-mat/internal/server/domain/page"
	"github.com/sj14/darts-o-mat/internal/server/service"
)

// Page shows the imprint or the privacy policy, plain text with its line breaks, or that it
// has no text yet. user is empty for visitors who aren't logged in.
templ Page(user string, name page.Name, text string) {
	@layout(pageTitleOf(ctx, name), user) {
		<div class="mx-auto max-w-3xl">
			@pageTitle(pageTitleOf(ctx, name), "")
			@panel("") {
				if text == "" {
					<p class="text-white/50">{ pageMissingOf(ctx, name) }</p>
				} else {
					<div class="whitespace-pre-line break-words text-white/80">{ text }</div>
				}
			}
		</div>
	}
}

// AdminModel is what the admin page shows.
type AdminModel struct {
	Admins       []account.Account    // the admins, by username
	Pages        map[page.Name]string // the texts of the pages, by name
	Registration bool                 // whether anyone may create an account
	Captcha      bool                 // whether registering needs the captcha
	// CaptchaConfigured says whether the server has the captcha's keys (start options), so
	// the admin can turn it on and off.
	CaptchaConfigured bool
	// Accounts are the newest accounts, or those the search found; MoreAccounts says that
	// there are more than the page shows.
	Accounts     []account.Account
	MoreAccounts bool
	Search       string
	Saved        bool
	Error        string
}

// Admin is the page of the server's settings, only for admins: whether anyone may register,
// who is an admin, and the texts of the pages.
templ Admin(user string, m AdminModel) {
	@layout(T(ctx).AdminTitle(), user) {
		<div class="mx-auto max-w-3xl">
			@pageTitle(T(ctx).AdminTitle(), T(ctx).AdminHint())
			@errorAlert(m.Error)
			if m.Saved {
				@notice(T(ctx).Saved())
			}
			<div class="flex flex-col gap-6">
				@panel(T(ctx).RegistrationTitle()) {
					<form method="post" action="/admin/registration" class="flex flex-col gap-3">
						if m.Registration {
							<p class="text-white/80">{ T(ctx).RegistrationIsOpen() }</p>
						} else {
							<p class="text-white/80">{ T(ctx).RegistrationIsClosed() }</p>
						}
						<div>
							<input type="hidden" name="open" value={ strconv.FormatBool(!m.Registration) }/>
							<button type="submit" class={ btnSecondary }>
								if m.Registration {
									{ T(ctx).CloseRegistration() }
								} else {
									{ T(ctx).OpenRegistration() }
								}
							</button>
						</div>
					</form>
					<form method="post" action="/admin/captcha" class="mt-4 flex flex-col gap-3">
						switch {
							case m.Captcha:
								<p class={ hintClass }>{ T(ctx).CaptchaOn() }</p>
							case m.CaptchaConfigured:
								<p class={ hintClass }>{ T(ctx).CaptchaTurnedOff() }</p>
							default:
								<p class={ hintClass }>{ T(ctx).CaptchaOff() }</p>
						}
						// Without the keys the server can't check, so there is nothing to turn on.
						if m.CaptchaConfigured {
							<div>
								<input type="hidden" name="on" value={ strconv.FormatBool(!m.Captcha) }/>
								<button type="submit" class={ btnSecondary }>
									if m.Captcha {
										{ T(ctx).TurnCaptchaOff() }
									} else {
										{ T(ctx).TurnCaptchaOn() }
									}
								</button>
							</div>
						}
					</form>
				}
				@panel(T(ctx).AdminsTitle()) {
					<p class={ hintClass }>{ T(ctx).AdminsHint() }</p>
					<ul class="mt-2 divide-y divide-white/10">
						for _, a := range m.Admins {
							<li class="flex flex-wrap items-center justify-between gap-3 py-3">
								<span class="font-display text-2xl font-semibold uppercase">{ a.Username }</span>
								// The last admin can't give up the role, so there is no button.
								if len(m.Admins) > 1 {
									<form method="post" action="/admin/admins" data-confirm={ T(ctx).RemoveAdminConfirm(a.Username) } onsubmit="return confirm(this.dataset.confirm)">
										<input type="hidden" name="username" value={ a.Username }/>
										<input type="hidden" name="admin" value="false"/>
										<button type="submit" class={ btnDanger, btnSmall }>{ T(ctx).RemoveAdmin() }</button>
									</form>
								}
							</li>
						}
					</ul>
					<form method="post" action="/admin/admins" class="mt-2 flex gap-2">
						<input type="hidden" name="admin" value="true"/>
						<input type="text" name="username" class={ inputClass } placeholder={ T(ctx).Username() } autocapitalize="none" required aria-label={ T(ctx).Username() }/>
						<button type="submit" class={ btnSecondary, "shrink-0" }>{ T(ctx).MakeAdmin() }</button>
					</form>
				}
				@adminAccounts(m)
				for _, name := range page.Names {
					@panel("") {
						<form method="post" action={ templ.URL("/admin/pages/" + string(name)) } class="flex flex-col gap-3">
							<label for={ "page-" + string(name) } class={ labelClass }>{ pageTitleOf(ctx, name) }</label>
							<p class={ hintClass }>{ T(ctx).PageHint() }</p>
							<textarea id={ "page-" + string(name) } name="text" rows="12" maxlength={ strconv.Itoa(page.MaxLen) } class={ inputClass, "font-mono text-sm" }>{ m.Pages[name] }</textarea>
							<div class="flex flex-wrap items-center gap-3">
								<button type="submit" class={ btnSecondary }>{ T(ctx).SavePage() }</button>
								if m.Pages[name] != "" {
									<a href={ templ.URL(PagePath(name)) } class={ linkClass }>{ T(ctx).ShowPage() }</a>
								}
							</div>
						</form>
					}
				}
			</div>
		</div>
	}
}

// adminAccounts is the admin page's list of accounts with a search: when each registered and
// last logged in, and buttons to disable, enable or delete it, except for admins.
templ adminAccounts(m AdminModel) {
	<div id="accounts">
		@panel(T(ctx).AccountsTitle()) {
			<p class={ hintClass }>{ T(ctx).AccountsHint(service.MaxAccountsShown) }</p>
			<form method="get" action="/admin#accounts" class="mt-2 flex gap-2">
				<input type="search" name="q" value={ m.Search } class={ inputClass } placeholder={ T(ctx).SearchAccounts() } autocapitalize="none" aria-label={ T(ctx).SearchAccounts() }/>
				<button type="submit" class={ btnSecondary, "shrink-0" }>{ T(ctx).Search() }</button>
			</form>
			if len(m.Accounts) == 0 {
				<p class="mt-3 text-white/60">{ T(ctx).NoAccounts() }</p>
			}
			<ul class="mt-2 divide-y divide-white/10">
				for _, a := range m.Accounts {
					<li class="flex flex-wrap items-center justify-between gap-3 py-3">
						<div class="min-w-0">
							<div class="flex flex-wrap items-center gap-2">
								<span class="font-display text-2xl font-semibold uppercase">{ a.Username }</span>
								if a.Admin {
									@statusBadge(T(ctx).AdminBadge(), "bg-board-green/25 text-emerald-300")
								}
								if a.Disabled {
									@statusBadge(T(ctx).DisabledBadge(), "bg-board-red/25 text-red-300")
								}
							</div>
							if a.Email != "" {
								<p class="truncate text-sm text-white/70">{ a.Email }</p>
							}
							<p class={ hintClass }>{ T(ctx).Registered(T(ctx).Date(a.CreatedAt)) } · { lastSeen(ctx, a) }</p>
						</div>
						// Admins can be neither disabled nor deleted here, so they have no buttons.
						if !a.Admin {
							<div class="flex gap-2">
								<form method="post" action={ templ.URL("/admin/accounts/" + strconv.FormatInt(a.ID, 10) + "/disabled") }>
									<input type="hidden" name="q" value={ m.Search }/>
									<input type="hidden" name="disabled" value={ strconv.FormatBool(!a.Disabled) }/>
									<button type="submit" class={ btnSecondary, btnSmall }>
										if a.Disabled {
											{ T(ctx).EnableAccount() }
										} else {
											{ T(ctx).DisableAccount() }
										}
									</button>
								</form>
								<form method="post" action={ templ.URL("/admin/accounts/" + strconv.FormatInt(a.ID, 10) + "/delete") } data-confirm={ T(ctx).DeleteOtherAccountConfirm(a.Username) } onsubmit="return confirm(this.dataset.confirm)">
									<input type="hidden" name="q" value={ m.Search }/>
									<button type="submit" class={ btnDanger, btnSmall }>{ T(ctx).Delete() }</button>
								</form>
							</div>
						}
					</li>
				}
			</ul>
			if m.MoreAccounts {
				<p class={ hintClass, "mt-2" }>{ T(ctx).MoreAccounts(service.MaxAccountsShown) }</p>
			}
		}
	</div>
}

// lastSeen says when the account was last active, for the list of accounts.
func lastSeen(ctx context.Context, a account.Account) string {
	if a.LastSeenAt == nil {
		return T(ctx).NeverSeen()
	}
	return T(ctx).LastSeen(T(ctx).Date(*a.LastSeenAt))
}
